msgstr "Åtgärda vit panel i vissa teman (t.ex. Ubuntu Yaru)"

#: prefs.js:411
msgid "Invert Tray Icons on Light Wallpapers"
msgstr "Invertera ikoner i systemfältet på ljusa bakgrundsbilder"

#: prefs.js:412
msgid ""
"Darken white monochrome tray icons when the panel adapts to a light "
"wallpaper. Colored icons are left untouched"
msgstr ""
"Gör vita enfärgade ikoner i systemfältet mörkare när panelen anpassar sig "
"till en ljus bakgrundsbild. Färgade ikoner lämnas orörda"

#: prefs.js:445
msgid "Panel Items"
msgstr "Panelobjekt"

#: prefs.js:446
msgid "Choose what the top panel and its menus show"
msgstr "Välj vad systemraden och dess menyer visar"

#: prefs.js:453
msgid "Show Window Title"
msgstr "Visa fönstertitel"

#: prefs.js:454
msgid "Display current window title in the top panel"
msgstr "Visa aktuellt fönsters titel i topppanelen"

#: prefs.js:463
msgid "Hide App Icon"
msgstr "Dölj programikon"

#: prefs.js:464
msgid "Do not show the application icon next to the window title"
msgstr "Visa inte programikonen intill fönstertiteln"

#: prefs.js:471
msgid "Disable Window Tiling"
msgstr "Inaktivera fönsterplacering"

#: prefs.js:472
msgid ""
"Drop the tiling layouts from the window title menu, and stop restoring tiled "
"windows when their titlebar is dragged"
msgstr ""
"Ta bort placeringslayouterna från fönstertitelmenyn och återställ inte längre"
" placerade fönster när deras titelrad dras"

#: prefs.js:492
msgid "Show Panel in Fullscreen on Hover"
msgstr "Visa panelen i helskärm vid hovring"

#: prefs.js:492
msgid ""
"Show panel when mouse is near top edge in fullscreen. Bugged for GTK4 apps."
msgstr ""
"Visa panelen när musen är nära överkanten i helskärm. Buggar för GTK4-appar."

#: prefs.js:500
msgid "Move Calendar to Right"
msgstr "Flytta kalendern åt höger"

#: prefs.js:501
msgid "Move calendar to right side and hide notifications"
msgstr "Flytta kalendern till högersidan och dölj aviseringar"

#: prefs.js:510
msgid "Keep GNOME Notification Panel"
msgstr "Behåll GNOMEs aviseringspanel"

#: prefs.js:511
msgid "Don't split notification and calendar layout"
msgstr "Dela inte upp aviserings- och kalenderlayouten"

#: prefs.js:517
