msgstr ""
"Inte tillgängligt medan GNOME Inställningar visar batteriprocenten i "
"systemraden"

#: prefs.js:569
msgid "Show battery percentage in the top bar when below 20%"
msgstr "Visa batteriprocent i toppfältet när den är under 20 %"

#: prefs.js:575
msgid "Caps Lock and Num Lock"
msgstr "Caps Lock och Num Lock"

