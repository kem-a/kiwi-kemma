#: prefs.js:396
msgid "Panel"
msgstr "Paneel"

#: prefs.js:402 prefs.js:415
msgid "Panel Transparency"
msgstr "Paneeli läbipaistvus"

#: prefs.js:403
msgid "Configure panel transparency and appearance"
msgstr "Seadista paneeli läbipaistvust ja välimust"

#: prefs.js:416
msgid "Make the top panel transparent"
msgstr "Muuda ülemine paneel läbipaistvaks"

#: prefs.js:423
msgid "Transparency Level"
msgstr "Läbipaistvuse tase"

#: prefs.js:424
msgid "Set panel transparency (0-100)"
msgstr "Paneeli läbipaistvuse väärtus (0–100)"

#: prefs.js:438
msgid "Opaque When Window Maximized"
msgstr "Läbipaistmatu maksimeeritud akna korral"

#: prefs.js:439
msgid "Make panel opaque when a maximized window touches it"
msgstr "Muuda paneel läbipaistmatuks, kui maksimeeritud aken seda puudutab"

#: prefs.js:447
msgid "Panel Blur"
msgstr "Paneeli hägustamine"

#: prefs.js:448
msgid "Blur the background behind the panel"
msgstr "Hägusta paneeli taust"

#: prefs.js:456
msgid "Panel Color Fix"
msgstr "Paneeli värviparandus"

#: prefs.js:457
msgid "Fix white panel on some themes (e.g., Ubuntu Yaru)"
msgstr "Paranda valge paneel mõnes teemas (nt Ubuntu Yaru)"

#: prefs.js:464
msgid "Invert Tray Icons on Light Wallpapers"
msgstr "Pööra salveikoonid heledatel taustapiltidel ümber"

#: prefs.js:465
msgid ""
"Darken white monochrome tray icons when the panel adapts to a light "
"wallpaper. Colored icons are left untouched"
msgstr ""
"Tumenda valged ühevärvilised salveikoonid, kui paneel kohandub heleda "
"taustapildiga. Värvilisi ikoone ei muudeta"

#: prefs.js:498
msgid "Panel Items"
msgstr "Paneeli elemendid"

#: prefs.js:499
msgid "Choose what the top panel and its menus show"
msgstr "Vali, mida ülemine paneel ja selle menüüd näitavad"

#: prefs.js:504
msgid "Show Panel in Fullscreen on Hover"
msgstr "Näita paneeli täisekraanil hiire lähenedes"

#: prefs.js:504
msgid ""
"Show panel when mouse is near top edge in fullscreen. Bugged for GTK4 apps."
msgstr ""
"Näita paneeli, kui hiir on täisekraanil ülemise serva lähedal. GTK4 "
"rakendustes võib esineda tõrkeid."

#: prefs.js:510
msgid "Show Window Title"
msgstr "Näita akna pealkirja"

#: prefs.js:511
msgid "Display current window title in the top panel"
msgstr "Kuva praeguse akna pealkiri ülemisel paneelil"

#: prefs.js:520
msgid "Hide App Icon"
msgstr "Peida rakenduse ikoon"

#: prefs.js:521
msgid "Do not show the application icon next to the window title"
msgstr "Ära näita rakenduse ikooni akna pealkirja kõrval"

#: prefs.js:528
msgid "Hide Window Subtitle"
msgstr "Peida akna alapealkiri"

#: prefs.js:529
msgid "Show only the application name, without the window's own title"
msgstr "Näita ainult rakenduse nime, ilma akna enda pealkirjata"

#: prefs.js:536
msgid "Disable Window Tiling"
msgstr "Keela akende paigutamine"

#: prefs.js:537
msgid ""
"Drop the tiling layouts from the window title menu, and stop restoring tiled "
"windows when their titlebar is dragged"
msgstr ""
"Eemalda paigutused akna pealkirja menüüst ja lõpeta paigutatud akende "
"taastamine tiitliriba lohistamisel"

#: prefs.js:563
msgid "Move Calendar to Right"
msgstr "Liiguta kalender paremale"

#: prefs.js:564
msgid "Move calendar to right side and hide notifications"
msgstr "Liiguta kalender paremale ja peida teavitused"

#: prefs.js:573
msgid "Keep GNOME Notification Panel"
msgstr "Säilita GNOME märguannete paneel"

#: prefs.js:574
msgid "Don't split notification and calendar layout"
msgstr "Ära eralda märguannete ja kalendri paigutust"

#: prefs.js:581
msgid "Indicator Style"
msgstr "Näidiku stiil"

#: prefs.js:582
msgid "Notification dot recolor"
msgstr "Märguandepunkti värvimine"

#: prefs.js:585 prefs.js:899
msgid "Default"
msgstr "Vaikimisi"

#: prefs.js:585
msgid "Accent"
msgstr "Aktsentvärv"

#: prefs.js:585
msgid "Symbolic"
msgstr "Sümboolne"

#: prefs.js:592
msgid "Battery Percentage"
msgstr "Aku protsent"

#: prefs.js:604
msgid ""
"Unavailable while GNOME Settings shows the battery percentage in the top bar"
msgstr ""
"Pole saadaval, kuni GNOME sätted näitavad aku protsenti ülemisel paneelil"

#: prefs.js:605
msgid "Show battery percentage in the top bar when below 20%"
msgstr "Näita aku protsenti ülaribal, kui see on alla 20%"

#: prefs.js:611
msgid "Caps Lock and Num Lock"
msgstr "Caps Lock ja Num Lock"

#: prefs.js:611
msgid "Show Caps Lock and Num Lock icon"
msgstr "Näita Caps Locki ja Num Locki ikooni"

#: prefs.js:612
msgid "Custom Do Not Disturb Button"
msgstr "Kohandatud mitte segada nupp"

#: prefs.js:612
msgid ""
"Replace the system Do Not Disturb button with Kiwi's custom implementation"
msgstr "Asendab süsteemi mitte segada nupu Kiwi kohandatud toteutusega"

#: prefs.js:613
msgid "Hide Activities Button"
msgstr "Peida Tegevused nupp"

#: prefs.js:613
msgid "Hide the Activities button in the top panel"
msgstr "Peida ülemise paneeli Tegevuste nupp"

#: prefs.js:614
msgid "Add Username"
msgstr "Lisa kasutajanimi"

#: prefs.js:614
msgid "Add username to the quick menu"
msgstr "Lisa kasutajanimi kiirmenüüsse"

#: prefs.js:618 prefs.js:828
msgid "Styling"
msgstr "Kujundus"

#: prefs.js:619
msgid ""
"Restyle stock GNOME Shell elements and GTK apps. Log out and back in for "
"changes to take effect"
msgstr ""
"Muuda GNOME Shelli ja GTK rakenduste välimust. Muudatuste rakendumiseks logi "
"välja ja tagasi sisse"

#: prefs.js:624
msgid "Panel Styling"
msgstr "Paneeli kujundus"

#: prefs.js:624
msgid ""
"Tighter button spacing, smaller status icons, no dropdown arrows and a "
"transparent panel in the overview"
msgstr ""
"Tihedam nuppude vahe, väiksemad olekuikoonid, ripploendi nooled puuduvad ja "
"läbipaistev paneel ülevaates"

#: prefs.js:625
msgid "Menu and App Styling"
msgstr "Menüüde ja rakenduste kujundus"

#: prefs.js:625
msgid ""
"Narrower shell menu items with accent-colored hover and selection, plus the "
"GTK app fixes"
msgstr ""
"Kitsamad shelli menüükirjed rõhuvärvilise esiletõstu ja valikuga ning GTK "
"rakenduste parandused"

#: prefs.js:631
msgid "Style Keyboard Indicator"
msgstr "Kohanda klaviatuuri indikaatorit"

#: prefs.js:632
msgid ""
"Slightly style keyboard/input source indicator by converting to uppercase and"
" adding border"
msgstr ""
"Muuda klaviatuuri/sisendallika indikaatorit veidi, muutes selle suurtähtedeks"
" ja lisades raami"

#: prefs.js:639
msgid "Hide keyboard indicator"
msgstr "Peida klaviatuuri indikaator"

#: prefs.js:640
msgid "Completely hide the indicator from the panel"
msgstr "Peida indikaator paneelilt täielikult"

#: prefs.js:668
msgid "Dock"
msgstr "Dokk"

#: prefs.js:677
msgid "These options need the Dash to Dock extension installed and enabled"
msgstr "Need valikud nõuavad paigaldatud ja lubatud Dash to Docki laiendust"

#: prefs.js:685
msgid "Dock Items"
msgstr "Doki elemendid"

#: prefs.js:686
msgid "Add extra items to Dash-to-Dock"
msgstr "Lisa Dash-to-Docki täiendavaid elemente"

#: prefs.js:691
msgid "Minimize Windows to Dock"
msgstr "Minimeeri aknad dokki"

#: prefs.js:691
msgid ""
"Park minimized windows as thumbnails in Dash-to-Dock, after the apps and "
"before the trash"
msgstr ""
"Paiguta minimeeritud aknad pisipiltidena Dash-to-Docki, rakenduste järele ja "
"prügikasti ette"

#: prefs.js:695
msgid "Downloads Folder in Dock"
msgstr "Allalaadimiste kaust dokis"

#: prefs.js:696
msgid ""
"Add a Downloads folder before the trash that fans its newest files out over "
"the desktop"
msgstr ""
"Lisa prügikasti ette allalaadimiste kaust, mis laotab uusimad failid "
"töölauale"

#: prefs.js:705
msgid "Stack Behind Folder"
msgstr "Virnasta kausta taha"

#: prefs.js:706
msgid ""
"Show the newest files sticking out of the folder icon instead of piled on top"
" of it"
msgstr ""
"Näita uusimaid faile kausta ikooni tagant välja ulatuvana, mitte selle peal "
"virnas"

#: prefs.js:724
msgid "Launchpad Application"
msgstr "Launchpadi rakendus"

#: prefs.js:725
msgid ""
"Add custom Launchpad icon to dock that opens application overview. "
"Recommended to hide default app launcher."
msgstr ""
"Lisa dokki kohandatud Launchpadi ikoon, mis avab rakenduste ülevaate. "
"Soovitatav on peita vaikimisi käivitaja."

#: prefs.js:735
msgid "Custom Icon"
msgstr "Kohandatud ikoon"

#: prefs.js:738 prefs.js:823
msgid "Using default icon"
msgstr "Kasutatakse vaikeikooni"

#: prefs.js:746
msgid "Reset to default icon"
msgstr "Lähtesta vaikeikoonile"

#: prefs.js:757
msgid "Browse for icon"
msgstr "Vali ikoon"

#: prefs.js:762
msgid "Select Launchpad Icon"
msgstr "Vali Launchpadi ikoon"

#: prefs.js:766
msgid "Images (PNG, SVG)"
msgstr "Pildid (PNG, SVG)"

#: prefs.js:794
msgid "Icon Too Large"
msgstr "Ikoon on liiga suur"

#: prefs.js:795
msgid ""
"The selected image exceeds 512×512 pixels. Please choose a smaller image."
msgstr "Valitud pilt ületab 512×512 pikslit. Palun vali väiksem pilt."

#: prefs.js:797
msgid "OK"
msgstr "Sobib"

#: prefs.js:833
msgid "Dock Styling"
msgstr "Doki kujundus"

#: prefs.js:833
msgid ""
"Tighten icon spacing, drop the icon highlight and darken icons while pressed"
msgstr ""
"Vähenda ikoonide vahet, eemalda ikooni esiletõst ja tumenda ikoonid "
"vajutamisel"

#: prefs.js:834
msgid "Dock Blur"
msgstr "Doki hägustamine"

#: prefs.js:834
msgid ""
"Blur the background behind Dash-to-Dock. Recommended fixed dock opacity 10% -"
" 30%, min 1%."
msgstr ""
"Hägusta Dash-to-Docki taust. Soovituslik doki püsiv läbipaistmatus 10%–30%, "
"vähemalt 1%."

#: prefs.js:835
msgid "Adaptive Dock Colors"
msgstr "Kohanduvad doki värvid"

#: prefs.js:835
msgid ""
"Flip the running indicators and separators to suit whatever is behind the "
"dock, wallpaper or window"
msgstr ""
"Muuda töötavate rakenduste tähised ja eraldajad vastavaks sellele, mis on "
"doki taga – taustapilt või aken"

#: prefs.js:858
msgid "Buttons"
msgstr "Nupud"

#: prefs.js:864
msgid "Window Control Button Style"
msgstr "Akna juhtnuppude stiil"

#: prefs.js:865
msgid ""
"Choose the window control button style. Log out to apply it across all apps."
msgstr ""
"Vali akna juhtnuppude stiil. Logi välja, et rakendada kõigis rakendustes."

#: prefs.js:873
msgid "Enable macOS Window Buttons"
msgstr "Luba macOS-i aknanupud"

#: prefs.js:874
msgid "Replace window control buttons in application windows with macOS style"
msgstr "Asenda rakenduste akende juhtnupud macOSi stiiliga"

#: prefs.js:895
msgid "Button Type"
msgstr "Nupu tüüp"

#: prefs.js:896
msgid "Choose the button icon set"
msgstr "Vali nupu ikoonide komplekt"

#: prefs.js:899
msgid "Alternative"
msgstr "Alternatiivne"

#: prefs.js:899
msgid "Glass"
msgstr "Klaas"

#: prefs.js:905
msgid "Button Size"
msgstr "Nupu suurus"

#: prefs.js:906
msgid "Choose button size"
msgstr "Vali nupu suurus"

#: prefs.js:909
msgid "Small"
msgstr "Väike"

#: prefs.js:909
msgid "Normal"
msgstr "Tavaline"

#: prefs.js:915
msgid "Firefox Styling"
msgstr "Firefoxi stiil"

#: prefs.js:916
msgid ""
"Apply macOS window control styling for Firefox. Recommended to use with "
"vertical tabs."
msgstr ""
"Rakenda Firefoxile macOS-i aknanuppude stiil. Soovitatav koos vertikaalsete "
"kaartidega."

#: prefs.js:924
msgid "Thunderbird Styling"
msgstr "Thunderbirdi stiil"

#: prefs.js:925
msgid "Apply macOS window control styling for Thunderbird."
msgstr "Rakenda macOSi akna juhtnuppude stiil Thunderbirdile."

#: prefs.js:949
msgid "Show Window Controls on Panel"
msgstr "Näita aknajuhtnuppe paneelil"

#: prefs.js:950
msgid ""
"Display close, minimize, maximize buttons in the top panel when window is "
"maximized"
msgstr ""
"Kuva üleval paneelil sulgemise, minimeerimise ja maksimeerimise nupud, kui "
"aken on maksimeeritud"

#: prefs.js:964
msgid "Only when Fullscreen"
msgstr "Ainult täisekraanil"

#: prefs.js:965
msgid ""
"Hide titlebars and show panel controls only for fullscreen windows, not "
"maximized"
msgstr ""
"Peida tiitliribad ja näita paneeli juhtnuppe ainult täisekraanil olevate "
"akende puhul, mitte maksimeeritud akende puhul"

#: prefs.js:974
msgid "Options"
msgstr "Valikud"

#: prefs.js:980
msgid "Kiwi"
msgstr "Kiwi"

#: prefs.js:981
msgid ""
"Kiwi is not like Apple, it's free open source project that brings macOS-like "
"feel for GNOME"
msgstr ""
"Kiwi ei ole Apple – see on vaba avatud lähtekoodiga projekt, mis annab GNOME-"
"le macOS-i sarnase tunde"

#: prefs.js:986
msgid "Overview Wallpaper Blur"
msgstr "Ülevaate tausta hägusus"

#: prefs.js:986
msgid "Use blurred current wallpaper as overview background"
msgstr "Kasuta ülevaate taustana hägustatud praegust taustapilti"

#: prefs.js:987
msgid "Seamless Overview Zoom"
msgstr "Sujuv ülevaate suum"

#: prefs.js:987
msgid ""
"Zoom the whole desktop, including the strip behind the panel, in and out of "
"the overview"
msgstr ""
"Suumi kogu töölauda, sealhulgas paneeli taga olevat riba, ülevaatesse "
"sisenemisel ja sealt väljumisel"

#: prefs.js:988
msgid "Focus on Overview Exit"
msgstr "Fookus ülevaatest väljumisel"

#: prefs.js:988
msgid ""
"Focus the window under the cursor instead of the previously focused one when "
"leaving the overview"
msgstr ""
"Ülevaatest väljumisel fokuseeri kursori all olev aken varem fokuseeritud akna"
" asemel"

#: prefs.js:989
msgid "Skip to Desktop"
msgstr "Liigu otse töölauale"

#: prefs.js:989
msgid "Do not show the overview when logging in. Animation is still visible"
msgstr "Ära näita sisselogimisel ülevaadet. Animatsioon jääb nähtavaks."

#: prefs.js:990
msgid "Hide Minimized Windows"
msgstr "Peida minimeeritud aknad"

#: prefs.js:990
msgid "Hide minimized windows in the overview"
msgstr "Peida minimeeritud aknad ülevaates"

#: prefs.js:991
msgid "Move Window to New Workspace"
msgstr "Liiguta aken uuele tööalale"

#: prefs.js:991
msgid "Move fullscreen window to a new workspace"
msgstr "Liiguta täisekraan aken uuele tööalale"

#: prefs.js:992
msgid "Reduce App Animations"
msgstr "Vähenda rakenduste animatsioone"

#: prefs.js:992
msgid "Mimic macOS window opening and closing with a subtle scale and fade"
msgstr ""
"Jäljenda macOS-i akende avanemist ja sulgumist õrna suurendusega ja "
"hajumisega"

#: prefs.js:993
msgid "Focus New Windows"
msgstr "Fokuseeri uued aknad"

#: prefs.js:993
msgid ""
"Automatically focus new windows instead of showing window-ready alerts. "
"Requires extension reload"
msgstr ""
"Fokuseeri uued aknad automaatselt, selle asemel et näidata akna valmisoleku "
"teateid. Nõuab laienduse uuesti laadimist"

#: prefs.js:994
msgid "Transparent Move"
msgstr "Läbipaistev liigutamine"

#: prefs.js:994
msgid "Move window with transparency"
msgstr "Liiguta akent läbipaistvusega"

#: prefs.js:1001
msgid "Advanced"
msgstr "Täpsemad"

#: prefs.js:1031
msgid "Titlebuttons Hover Effect for GTK3 apps"
msgstr "GTK3 aknanuppude hõljutusefekt"

#: prefs.js:1044
msgid ""
"The titlebuttons hover module provides macOS-like hover effects for window controls in GTK3 applications. GTK3 apps cannot natively show hover effects on all three window controls simultaneously, requiring this custom library to achieve the desired behavior.\n"
"\n"
"This binary code cannot be distributed through the GNOME Extensions platform due to security policies regarding native libraries, but manual installation is possible."
msgstr ""
"Aknanuppude hõljutusmoodul pakub macOS-i sarnaseid hõljutusefekte GTK3 rakenduste aknajuhtnuppudele. GTK3 rakendused ei suuda kõiki kolme aknanuppu korraga hõljutusefektiga kuvada, mistõttu on soovitud käitumise saavutamiseks vaja seda teeki.\n"
"\n"
"Seda binaari ei saa GNOME laienduste platvormil levitada kohalike teekide turvapoliitika tõttu, kuid käsitsi paigaldus on võimalik."

#: prefs.js:1060
msgid "Installation Guide on GitHub"
msgstr "Paigaldusjuhend GitHubis"

#: prefs.js:1062
msgid "Open the advanced module build instructions"
msgstr "Ava täiendmooduli koostejuhised"

#: prefs.js:1068
msgid "More of my work..."
msgstr "Rohkem minu töid…"

#: prefs.js:1072
msgid "Kiwi Menu"
msgstr "Kiwi Menu"

#: prefs.js:1072
msgid "MacOS style menu for GNOME"
msgstr "macOS-i stiilis menüü GNOME-le"

#: prefs.js:1073
msgid "AppManager"
msgstr "AppManager"

#: prefs.js:1073
msgid "MacOS style AppImage installer and management application"
msgstr "MacOS-stiilis AppImage'ide paigaldus- ja haldusrakendus"

#: prefs.js:1074
msgid "Catalina Reloaded Icon Pack"
msgstr "Catalina Reloaded Icon Pack"

