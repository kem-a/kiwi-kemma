#: prefs.js:331 prefs.js:338
msgid "Panel Transparency"
msgstr "Panelgjennomsiktighet"

#: prefs.js:332
msgid "Configure panel transparency and appearance"
msgstr "Konfigurer panelgjennomsiktighet og utseende"

#: prefs.js:339
msgid "Make the top panel transparent"
msgstr "Gjør topppanelet gjennomsiktig"

#: prefs.js:347
msgid "Transparency Level"
msgstr "Gjennomsiktighetsnivå"

#: prefs.js:348
msgid "Set panel transparency (0-100)"
msgstr "Sett panelgjennomsiktighet (0–100)"

#: prefs.js:362
msgid "Opaque When Window Touches"
msgstr "Ugjennomsiktig når vindu berører"

#: prefs.js:363
msgid "Make panel opaque when a window touches it"
msgstr "Gjør panelet ugjennomsiktig når et vindu berører det"

#: prefs.js:371
msgid "Panel Blur"
msgstr "Uskarphet for panel"

#: prefs.js:372
msgid "Blur the background behind the panel"
msgstr "Uskarp bakgrunnen bak panelet"

#: prefs.js:380
msgid "Panel Color Fix"
msgstr "Panelfarge-fiks"

#: prefs.js:381
msgid "Fix white panel on some themes (e.g., Ubuntu Yaru)"
msgstr "Fiks hvitt panel i noen temaer (f.eks. Ubuntu Yaru)"

#: prefs.js:414
msgid "Move Window to New Workspace"
msgstr "Flytt vindu til nytt arbeidsområde"

#: prefs.js:414
msgid "Move fullscreen window to a new workspace"
msgstr "Flytt fullskjermsvindu til et nytt arbeidsområde"

#: prefs.js:415
msgid "Transparent Move"
msgstr "Gjennomsiktig flytting"

#: prefs.js:415
msgid "Move window with transparency"
msgstr "Flytt vindu med gjennomsiktighet"

#: prefs.js:416
msgid "Battery Percentage"
msgstr "Batteriprosent"

#: prefs.js:416
msgid "Show battery percentage in the top bar when below 20%"
msgstr "Vis batteriprosent i toppfeltet når den er under 20 %"

#: prefs.js:417
msgid "Move Calendar to Right"
msgstr "Flytt kalender til høyre"

#: prefs.js:417
msgid "Move calendar to right side and hide notifications"
msgstr "Flytt kalenderen til høyre side og skjul varsler"

#: prefs.js:418
msgid "Show Window Title"
msgstr "Vis vindustittel"

#: prefs.js:418
msgid "Display current window title in the top panel"
msgstr "Vis gjeldende vindustittel i topppanelet"

#: prefs.js:419
msgid "Show Panel on Hover"
msgstr "Vis panel ved hovring"

#: prefs.js:419
msgid ""
"Show panel when mouse is near top edge in fullscreen. Bugged for GTK4 apps."
msgstr ""
"Vis panelet når musen er nær toppkanten i fullskjerm. Feil for GTK4-apper."

#: prefs.js:420
msgid "Show Window Controls on Panel"
msgstr "Vis vindukontroller i panelet"

#: prefs.js:420
msgid ""
"Display close, minimize, maximize buttons in the top panel when window is "
"maximized"
msgstr ""
"Vis knappene for å lukke, minimere og maksimere i øvre panel når vinduet er "
"maksimert"

#: prefs.js:421
msgid "Overview Wallpaper Blur"
msgstr "Oversikts-bakgrunnsuskarphet"

#: prefs.js:421
msgid ""
"Use blurred current wallpaper as overview background (requires ImageMagick)"
msgstr ""
"Bruk en uskarp versjon av gjeldende bakgrunn som oversiktsbakgrunn (krever "
"ImageMagick)"

#: prefs.js:422
msgid "Dock Blur"
msgstr "Uskarphet for dokk"

#: prefs.js:422
msgid "Blur the background behind Dash-to-Dock"
msgstr "Uskarp bakgrunnen bak Dash-to-Dock"

#: prefs.js:445
msgid "Keep GNOME Notification Panel"
msgstr "Behold GNOME-varslingspanel"

#: prefs.js:446
msgid "Don't split notification and calendar layout"
msgstr "Ikke del opp varslings- og kalenderoppsettet"

#: prefs.js:452
msgid "Indicator Style"
msgstr "Indikatorstil"

#: prefs.js:453
msgid "Notification dot recolor"
msgstr "Farge på varslingsprikk"

#: prefs.js:463 prefs.js:562
msgid "Default"
msgstr "Standard"

#: prefs.js:467
msgid "Accent"
msgstr "Aksent"

#: prefs.js:471
msgid "Symbolic"
msgstr "Symbolsk"

#: prefs.js:498
msgid "ImageMagick not installed (install package \"imagemagick\" to enable)"
msgstr ""
"ImageMagick er ikke installert (installer pakken «imagemagick» for å "
"aktivere)"

#: prefs.js:507
msgid "Window Control Button Style"
msgstr "Vindukontroll-knappestil"

#: prefs.js:508
msgid ""
"Choose the window control button style. Log out to apply it across all apps."
msgstr ""
"Velg vindukontroll-knappenes stil. Logg ut for å bruke den i alle apper."

#: prefs.js:514
msgid "Enable macOS Window Buttons"
msgstr "Aktiver macOS-vindu knapper"

#: prefs.js:515
msgid "Replace window control buttons in application windows with macOS style"
msgstr "Erstatt vinduskontrollknappene i programvinduer med macOS-stil"

#: prefs.js:532
msgid "Firefox Styling"
msgstr "Firefox-stil"

#: prefs.js:533
msgid ""
"Apply macOS window control styling for Firefox. Recommended to use with "
"vertical tabs."
msgstr ""
"Bruk macOS-stil for vindukontroller i Firefox. Anbefales med vertikale faner."

#: prefs.js:541
msgid "Thunderbird Styling"
msgstr "Thunderbird-stil"

#: prefs.js:542
msgid "Apply macOS window control styling for Thunderbird."
msgstr "Bruk macOS-stil for vinduskontroller i Thunderbird."

#: prefs.js:551
msgid "Button Type"
msgstr "Knapptype"

#: prefs.js:552
msgid "Choose the button icon set"
msgstr "Velg ikonsett for knappene"

#: prefs.js:566
msgid "Alternative"
msgstr "Alternativ"

#: prefs.js:583
msgid "Button Size"
msgstr "Knappstørrelse"

#: prefs.js:584
msgid "Choose button size"
msgstr "Velg knappstørrelse"

#: prefs.js:594
msgid "Small"
msgstr "Liten"

#: prefs.js:598
msgid "Normal"
msgstr "Normal"

#: prefs.js:631
msgid "Extras"
msgstr "Ekstra"

#: prefs.js:637
msgid "Extra Features"
msgstr "Ekstrafunksjoner"

#: prefs.js:638
msgid "Additional customization options and utilities"
msgstr "Flere tilpasningsmuligheter og verktøy"

#: prefs.js:643
msgid "Add Username"
msgstr "Legg til brukernavn"

#: prefs.js:643
msgid "Add username to the quick menu"
msgstr "Legg til brukernavn i hurtigmenyen"

#: prefs.js:644
msgid "Caps Lock and Num Lock"
msgstr "Caps Lock og Num Lock"

#: prefs.js:644
msgid "Show Caps Lock and Num Lock icon"
msgstr "Vis Caps Lock- og Num Lock-ikon"

#: prefs.js:645
msgid "Hide Activities Button"
msgstr "Skjul Aktiviteter-knappen"

#: prefs.js:645
msgid "Hide the Activities button in the top panel"
msgstr "Skjul Aktiviteter-knappen i topppanelet"

#: prefs.js:646
msgid "Hide Minimized Windows"
msgstr "Skjul minimerte vinduer"

#: prefs.js:646
msgid "Hide minimized windows in the overview"
msgstr "Skjul minimerte vinduer i oversikten"

#: prefs.js:647
msgid "Skip to Desktop"
msgstr "Hopp til skrivebordet"

#: prefs.js:647
msgid "Do not show the overview when logging in. Animation is still visible"
msgstr "Ikke vis oversikten når du logger inn. Animasjonen vises fortsatt."

#: prefs.js:648
msgid "Custom Do Not Disturb Button"
msgstr "Egendefinert Ikke forstyrr-knapp"

#: prefs.js:648
msgid ""
"Replace the system Do Not Disturb button with Kiwi's custom implementation"
msgstr ""
"Erstatter systemets Ikke forstyrr-knapp med Kiwis egendefinerte "
"implementering"

#: prefs.js:663
msgid "Launchpad Application"
msgstr "Launchpad-program"

#: prefs.js:664
msgid ""
"Add custom Launchpad icon to dock that opens application overview. "
"Recommended to hide default app launcher."
msgstr ""
"Legg til et tilpasset Launchpad-ikon i dokken som åpner programoversikten. "
"Anbefales å skjule standardstarteren."

#: prefs.js:681
msgid "Custom Icon"
msgstr "Egendefinert ikon"

#: prefs.js:684 prefs.js:769
msgid "Using default icon"
msgstr "Bruker standardikon"

#: prefs.js:692
msgid "Reset to default icon"
msgstr "Tilbakestill til standardikon"

#: prefs.js:703
msgid "Browse for icon"
msgstr "Bla etter ikon"

#: prefs.js:708
msgid "Select Launchpad Icon"
msgstr "Velg Launchpad-ikon"

#: prefs.js:712
msgid "Images (PNG, SVG)"
msgstr "Bilder (PNG, SVG)"

#: prefs.js:740
msgid "Icon Too Large"
msgstr "Ikonet er for stort"

#: prefs.js:741
msgid ""
"The selected image exceeds 512×512 pixels. Please choose a smaller image."
msgstr "Det valgte bildet overskrider 512×512 piksler. Velg et mindre bilde."

#: prefs.js:743
msgid "OK"
msgstr "OK"

#: prefs.js:775
msgid "Style Keyboard Indicator"
msgstr "Stilsett tastaturindikatoren"

#: prefs.js:776
msgid ""
"Slightly style keyboard/input source indicator by converting to uppercase "
"and adding border"
msgstr ""
"Gi tastatur-/inndatakilde-indikatoren litt stil ved å gjøre teksten til "
"store bokstaver og legge til en kantlinje"

#: prefs.js:784
msgid "Hide keyboard indicator"
msgstr "Skjul tastaturindikatoren"

#: prefs.js:785
msgid "Completely hide the indicator from the panel"
msgstr "Skjul indikatoren helt fra panelet"

#: prefs.js:821
msgid "Advanced"
msgstr "Avansert"

#: prefs.js:851
msgid "Titlebuttons Hover Effect for GTK3 apps"
msgstr "Sveveeffekt for tittellinjeknapper i GTK3-apper"

#: prefs.js:862
msgid ""
"The titlebuttons hover module provides macOS-like hover effects for window "
"controls in GTK3 applications. GTK3 apps cannot natively show hover effects "
"on all three window controls simultaneously, requiring this custom library "
"to achieve the desired behavior.\n"
"\n"
"This binary code cannot be distributed through the GNOME Extensions platform "
"due to security policies regarding native libraries, but manual installation "
"is possible."
msgstr ""
"Tittellinjeknappenes svevemodul gir macOS-lignende effekter for "
"vindukontroller i GTK3-programmer. GTK3-apper kan ikke vise sveveeffekter på "
"alle tre vindukontroller samtidig, og trenger derfor dette biblioteket for å "
"oppnå ønsket oppførsel.\n"
"\n"
"Denne binærfilen kan ikke distribueres via GNOME Extensions-plattformen på "
"grunn av sikkerhetspolicyer for native-biblioteker, men manuell installasjon "
"er mulig."

#: prefs.js:874
msgid "Installation Guide on GitHub"
msgstr "Installationsveiledning på GitHub"

#: prefs.js:876
msgid "Open the advanced module build instructions"
msgstr "Åpne byggeinstruksjonene for avansert modul"

#: prefs.js:881
msgid "Even more..."
msgstr "Enda mer…"

#: prefs.js:885
msgid "AppManager"
msgstr ""

#: prefs.js:887
msgid "MacOS style AppImage installer and management application"
msgstr "MacOS-stil AppImage installasjons- og administrasjonsapplikasjon"

#: prefs.js:890
msgid "MacTahoe Icon Pack"
msgstr ""

#: prefs.js:892
msgid "macOS Tahoe icon theme for Linux"
msgstr "macOS Tahoe-ikontema for Linux"

#: prefs.js:895
msgid "GDM Wallpaper"
msgstr ""

#: prefs.js:897
msgid "Set custom GDM login screen wallpaper"
msgstr "Sett egendefinert bakgrunn for GDM-påloggingsskjerm"

#: prefs.js:905
msgid "Recommended Extensions"
msgstr "Anbefalte utvidelser"

#: prefs.js:906
msgid "Extensions that are compatible with Kiwi"
msgstr "Utvidelser som er kompatible med Kiwi"

