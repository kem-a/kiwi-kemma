#: prefs.js:361
msgid "Panel"
msgstr "Panel"

#: prefs.js:367 prefs.js:380
msgid "Panel Transparency"
msgstr "Panelgjennomsiktighet"

#: prefs.js:368
msgid "Configure panel transparency and appearance"
msgstr "Konfigurer panelgjennomsiktighet og utseende"

#: prefs.js:381
msgid "Make the top panel transparent"
msgstr "Gjør topppanelet gjennomsiktig"

#: prefs.js:388
msgid "Transparency Level"
msgstr "Gjennomsiktighetsnivå"

#: prefs.js:389
msgid "Set panel transparency (0-100)"
msgstr "Sett panelgjennomsiktighet (0–100)"

#: prefs.js:403
msgid "Opaque When Window Touches"
msgstr "Ugjennomsiktig når vindu berører"

#: prefs.js:404
msgid "Make panel opaque when a window touches it"
msgstr "Gjør panelet ugjennomsiktig når et vindu berører det"

#: prefs.js:412
msgid "Panel Blur"
msgstr "Uskarphet for panel"

#: prefs.js:413
msgid "Blur the background behind the panel"
msgstr "Uskarp bakgrunnen bak panelet"

#: prefs.js:421
msgid "Panel Color Fix"
msgstr "Panelfarge-fiks"

#: prefs.js:422
msgid "Fix white panel on some themes (e.g., Ubuntu Yaru)"
msgstr "Fiks hvitt panel i noen temaer (f.eks. Ubuntu Yaru)"

#: prefs.js:429
msgid "Invert Tray Icons on Light Wallpapers"
msgstr "Inverter systemikoner på lyse bakgrunnsbilder"

#: prefs.js:430
msgid ""
"Darken white monochrome tray icons when the panel adapts to a light "
"wallpaper. Colored icons are left untouched"
msgstr ""
"Gjør hvite enfargede systemikoner mørkere når panelet tilpasser seg et lyst "
"bakgrunnsbilde. Fargede ikoner forblir uendret"

#: prefs.js:463
msgid "Panel Items"
msgstr "Panelelementer"

#: prefs.js:464
msgid "Choose what the top panel and its menus show"
msgstr "Velg hva topplinjen og menyene dens viser"

#: prefs.js:471
msgid "Show Window Title"
msgstr "Vis vindustittel"

#: prefs.js:472
msgid "Display current window title in the top panel"
msgstr "Vis gjeldende vindustittel i topppanelet"

#: prefs.js:481
msgid "Hide App Icon"
msgstr "Skjul programikon"

#: prefs.js:482
msgid "Do not show the application icon next to the window title"
msgstr "Ikke vis programikonet ved siden av vindustittelen"

#: prefs.js:489
msgid "Disable Window Tiling"
msgstr "Slå av vindusflislegging"

#: prefs.js:490
msgid ""
"Drop the tiling layouts from the window title menu, and stop restoring tiled "
"windows when their titlebar is dragged"
msgstr ""
"Fjern flisleggingsoppsettene fra vindustittelmenyen, og slutt å gjenopprette "
"flislagte vinduer når tittellinjen dras"

#: prefs.js:510
msgid "Show Panel in Fullscreen on Hover"
msgstr "Vis panel i fullskjerm ved peking"

#: prefs.js:510
msgid ""
"Show panel when mouse is near top edge in fullscreen. Bugged for GTK4 apps."
msgstr ""
"Vis panelet når musen er nær toppkanten i fullskjerm. Feil for GTK4-apper."

#: prefs.js:518
msgid "Move Calendar to Right"
msgstr "Flytt kalender til høyre"

#: prefs.js:519
msgid "Move calendar to right side and hide notifications"
msgstr "Flytt kalenderen til høyre side og skjul varsler"

#: prefs.js:528
msgid "Keep GNOME Notification Panel"
msgstr "Behold GNOME-varslingspanel"

#: prefs.js:529
msgid "Don't split notification and calendar layout"
msgstr "Ikke del opp varslings- og kalenderoppsettet"

#: prefs.js:536
msgid "Indicator Style"
msgstr "Indikatorstil"

#: prefs.js:537
msgid "Notification dot recolor"
msgstr "Farge på varslingsprikk"

#: prefs.js:540 prefs.js:826
msgid "Default"
msgstr "Standard"

#: prefs.js:540
msgid "Accent"
msgstr "Aksent"

#: prefs.js:540
msgid "Symbolic"
msgstr "Symbolsk"

#: prefs.js:547
msgid "Battery Percentage"
msgstr "Batteriprosent"

#: prefs.js:559
msgid ""
"Unavailable while GNOME Settings shows the battery percentage in the top bar"
msgstr ""
"Utilgjengelig mens GNOME Innstillinger viser batteriprosenten i topplinjen"

#: prefs.js:560
msgid "Show battery percentage in the top bar when below 20%"
msgstr "Vis batteriprosent i toppfeltet når den er under 20 %"

#: prefs.js:566
msgid "Caps Lock and Num Lock"
msgstr "Caps Lock og Num Lock"

#: prefs.js:566
msgid "Show Caps Lock and Num Lock icon"
msgstr "Vis Caps Lock- og Num Lock-ikon"

#: prefs.js:567
msgid "Custom Do Not Disturb Button"
msgstr "Egendefinert Ikke forstyrr-knapp"

#: prefs.js:567
msgid ""
"Replace the system Do Not Disturb button with Kiwi's custom implementation"
msgstr ""
"Erstatter systemets Ikke forstyrr-knapp med Kiwis egendefinerte "
"implementering"

#: prefs.js:568
msgid "Hide Activities Button"
msgstr "Skjul Aktiviteter-knappen"

#: prefs.js:568
msgid "Hide the Activities button in the top panel"
msgstr "Skjul Aktiviteter-knappen i topppanelet"

#: prefs.js:569
msgid "Add Username"
msgstr "Legg til brukernavn"

#: prefs.js:569
msgid "Add username to the quick menu"
msgstr "Legg til brukernavn i hurtigmenyen"

#: prefs.js:573 prefs.js:771
msgid "Styling"
msgstr "Stil"

#: prefs.js:574
msgid ""
"Restyle stock GNOME Shell elements and GTK apps. Log out and back in for "
"changes to take effect"
msgstr ""
"Endre stilen på standard GNOME Shell-elementer og GTK-programmer. Logg ut og "
"inn igjen for at endringene skal tas i bruk"

#: prefs.js:579
msgid "Panel Styling"
msgstr "Panelstil"

#: prefs.js:579
msgid ""
"Tighter button spacing, bold titles, smaller status icons, no dropdown "
"arrows and a transparent panel in the overview"
msgstr ""
"Tettere knappeavstand, fete titler, mindre statusikoner, ingen "
"nedtrekkspiler og et gjennomsiktig panel i oversikten"

#: prefs.js:580
msgid "Menu and App Styling"
msgstr "Meny- og programstil"

#: prefs.js:580
msgid ""
"Narrower shell menu items with accent-colored hover and selection, plus the "
"GTK app fixes"
msgstr ""
"Smalere shell-menyelementer med aksentfarget peking og valg, i tillegg til "
"GTK-programrettelsene"

#: prefs.js:586
msgid "Style Keyboard Indicator"
msgstr "Stilsett tastaturindikatoren"

#: prefs.js:587
msgid ""
"Slightly style keyboard/input source indicator by converting to uppercase "
"and adding border"
msgstr ""
"Gi tastatur-/inndatakilde-indikatoren litt stil ved å gjøre teksten til "
"store bokstaver og legge til en kantlinje"

#: prefs.js:594
msgid "Hide keyboard indicator"
msgstr "Skjul tastaturindikatoren"

#: prefs.js:595
msgid "Completely hide the indicator from the panel"
msgstr "Skjul indikatoren helt fra panelet"

#: prefs.js:623
msgid "Dock"
msgstr "Dokk"

#: prefs.js:629
msgid "Dock Items"
msgstr "Dokkelementer"

#: prefs.js:630
msgid "Add extra items to Dash-to-Dock"
msgstr "Legg til flere elementer i Dash-to-Dock"

#: prefs.js:635
msgid "Minimize Windows to Dock"
msgstr "Minimer vinduer til dokken"

#: prefs.js:635
msgid ""
"Park minimized windows as thumbnails in Dash-to-Dock, after the apps and "
"before the trash"
msgstr ""
"Plasser minimerte vinduer som miniatyrbilder i Dash-to-Dock, etter "
"programmene og før papirkurven"

#: prefs.js:639
msgid "Downloads Folder in Dock"
msgstr "Nedlastingsmappe i dokken"

#: prefs.js:640
msgid ""
"Add a Downloads folder before the trash that fans its newest files out over "
"the desktop"
msgstr ""
"Legg til en nedlastingsmappe før papirkurven som brer de nyeste filene ut "
"over skrivebordet"

#: prefs.js:648
msgid "Stack Behind Folder"
msgstr "Stable bak mappen"

#: prefs.js:649
msgid ""
"Show the newest files sticking out of the folder icon instead of piled on "
"top of it"
msgstr ""
"Vis de nyeste filene stikkende ut bak mappeikonet i stedet for stablet oppå "
"det"

#: prefs.js:667
msgid "Launchpad Application"
msgstr "Launchpad-program"

#: prefs.js:668
msgid ""
"Add custom Launchpad icon to dock that opens application overview. "
"Recommended to hide default app launcher."
msgstr ""
"Legg til et tilpasset Launchpad-ikon i dokken som åpner programoversikten. "
"Anbefales å skjule standardstarteren."

#: prefs.js:678
msgid "Custom Icon"
msgstr "Egendefinert ikon"

#: prefs.js:681 prefs.js:766
msgid "Using default icon"
msgstr "Bruker standardikon"

#: prefs.js:689
msgid "Reset to default icon"
msgstr "Tilbakestill til standardikon"

#: prefs.js:700
msgid "Browse for icon"
msgstr "Bla etter ikon"

#: prefs.js:705
msgid "Select Launchpad Icon"
msgstr "Velg Launchpad-ikon"

#: prefs.js:709
msgid "Images (PNG, SVG)"
msgstr "Bilder (PNG, SVG)"

#: prefs.js:737
msgid "Icon Too Large"
msgstr "Ikonet er for stort"

#: prefs.js:738
msgid ""
"The selected image exceeds 512×512 pixels. Please choose a smaller image."
msgstr "Det valgte bildet overskrider 512×512 piksler. Velg et mindre bilde."

#: prefs.js:740
msgid "OK"
msgstr "OK"

#: prefs.js:776
msgid "Dock Styling"
msgstr "Dokkstil"

#: prefs.js:776
msgid ""
"Tighten icon spacing, drop the icon highlight and darken icons while pressed"
msgstr ""
"Stram inn ikonavstanden, fjern ikonutheving og gjør ikoner mørkere når de "
"trykkes"

#: prefs.js:777
msgid "Dock Blur"
msgstr "Uskarphet for dokk"

#: prefs.js:777
msgid ""
"Blur the background behind Dash-to-Dock. Recommended fixed dock opacity 10% "
"- 30%, min 1%."
msgstr ""
"Uskarp bakgrunnen bak Dash-to-Dock. Anbefalt fast ugjennomsiktighet for "
"dokken 10–30 %, minst 1 %."

#: prefs.js:778
msgid "Adaptive Dock Colors"
msgstr "Adaptive dokkfarger"

#: prefs.js:778
msgid ""
"Flip the running indicators and separators to suit whatever is behind the "
"dock, wallpaper or window"
msgstr ""
"Tilpass indikatorer for kjørende programmer og skillelinjer til det som er "
"bak dokken, bakgrunnsbilde eller vindu"

#: prefs.js:785
msgid "Buttons"
msgstr "Knapper"

#: prefs.js:791
msgid "Window Control Button Style"
msgstr "Vindukontroll-knappestil"

#: prefs.js:792
msgid ""
"Choose the window control button style. Log out to apply it across all apps."
msgstr ""
"Velg vindukontroll-knappenes stil. Logg ut for å bruke den i alle apper."

#: prefs.js:800
msgid "Enable macOS Window Buttons"
msgstr "Aktiver macOS-vindu knapper"

#: prefs.js:801
msgid "Replace window control buttons in application windows with macOS style"
msgstr "Erstatt vinduskontrollknappene i programvinduer med macOS-stil"

#: prefs.js:822
msgid "Button Type"
msgstr "Knapptype"

#: prefs.js:823
msgid "Choose the button icon set"
msgstr "Velg ikonsett for knappene"

#: prefs.js:826
msgid "Alternative"
msgstr "Alternativ"

#: prefs.js:832
msgid "Button Size"
msgstr "Knappstørrelse"

#: prefs.js:833
msgid "Choose button size"
msgstr "Velg knappstørrelse"

#: prefs.js:836
msgid "Small"
msgstr "Liten"

#: prefs.js:836
msgid "Normal"
msgstr "Normal"

#: prefs.js:842
msgid "Firefox Styling"
msgstr "Firefox-stil"

#: prefs.js:843
msgid ""
"Apply macOS window control styling for Firefox. Recommended to use with "
"vertical tabs."
msgstr ""
"Bruk macOS-stil for vindukontroller i Firefox. Anbefales med vertikale faner."

#: prefs.js:851
msgid "Thunderbird Styling"
msgstr "Thunderbird-stil"

#: prefs.js:852
msgid "Apply macOS window control styling for Thunderbird."
msgstr "Bruk macOS-stil for vinduskontroller i Thunderbird."

#: prefs.js:876
msgid "Show Window Controls on Panel"
msgstr "Vis vindukontroller i panelet"

#: prefs.js:877
msgid ""
"Display close, minimize, maximize buttons in the top panel when window is "
"maximized"
msgstr ""
"Vis knappene for å lukke, minimere og maksimere i øvre panel når vinduet er "
"maksimert"

#: prefs.js:891
msgid "Only when Fullscreen"
msgstr "Bare i fullskjerm"

#: prefs.js:892
msgid ""
"Hide titlebars and show panel controls only for fullscreen windows, not "
"maximized"
msgstr ""
"Skjul tittellinjer og vis panelkontroller bare for vinduer i fullskjerm, "
"ikke maksimerte"

#: prefs.js:901
msgid "Options"
msgstr "Alternativer"

#: prefs.js:907
msgid "Kiwi"
msgstr "Kiwi"

#: prefs.js:908
msgid ""
"Kiwi is not like Apple, it's free open source project that brings macOS-like "
"feel for GNOME"
msgstr ""
"Kiwi er ikke Apple; det er et fritt og åpen kildekode-prosjekt som gir GNOME "
"en macOS-lignende følelse"

#: prefs.js:913
msgid "Overview Wallpaper Blur"
msgstr "Oversikts-bakgrunnsuskarphet"

#: prefs.js:913
msgid "Use blurred current wallpaper as overview background"
msgstr "Bruk uskarpt gjeldende bakgrunnsbilde som oversiktsbakgrunn"

#: prefs.js:914
msgid "Skip to Desktop"
msgstr "Hopp til skrivebordet"

#: prefs.js:914
msgid "Do not show the overview when logging in. Animation is still visible"
msgstr "Ikke vis oversikten når du logger inn. Animasjonen vises fortsatt."

#: prefs.js:915
msgid "Hide Minimized Windows"
msgstr "Skjul minimerte vinduer"

#: prefs.js:915
msgid "Hide minimized windows in the overview"
msgstr "Skjul minimerte vinduer i oversikten"

#: prefs.js:916
msgid "Move Window to New Workspace"
msgstr "Flytt vindu til nytt arbeidsområde"

#: prefs.js:916
msgid "Move fullscreen window to a new workspace"
msgstr "Flytt fullskjermsvindu til et nytt arbeidsområde"

#: prefs.js:917
msgid "Reduce App Animations"
msgstr "Reduser programanimasjoner"

#: prefs.js:917
msgid "Mimic macOS window opening and closing with a subtle scale and fade"
msgstr ""
"Etterlign macOS-vinduer som åpnes og lukkes med en subtil skalering og "
"uttoning"

#: prefs.js:918
msgid "Transparent Move"
msgstr "Gjennomsiktig flytting"

#: prefs.js:918
msgid "Move window with transparency"
msgstr "Flytt vindu med gjennomsiktighet"

#: prefs.js:925
msgid "Advanced"
msgstr "Avansert"

#: prefs.js:955
msgid "Titlebuttons Hover Effect for GTK3 apps"
msgstr "Sveveeffekt for tittellinjeknapper i GTK3-apper"

#: prefs.js:968
msgid ""
"The titlebuttons hover module provides macOS-like hover effects for window "
"controls in GTK3 applications. GTK3 apps cannot natively show hover effects "
"on all three window controls simultaneously, requiring this custom library "
"to achieve the desired behavior.\n"
"\n"
"This binary code cannot be distributed through the GNOME Extensions platform "
"due to security policies regarding native libraries, but manual installation "
"is possible."
msgstr ""
"Tittellinjeknappenes svevemodul gir macOS-lignende effekter for "
"vindukontroller i GTK3-programmer. GTK3-apper kan ikke vise sveveeffekter på "
"alle tre vindukontroller samtidig, og trenger derfor dette biblioteket for å "
"oppnå ønsket oppførsel.\n"
"\n"
"Denne binærfilen kan ikke distribueres via GNOME Extensions-plattformen på "
"grunn av sikkerhetspolicyer for native-biblioteker, men manuell installasjon "
"er mulig."

#: prefs.js:984
msgid "Installation Guide on GitHub"
msgstr "Installationsveiledning på GitHub"

#: prefs.js:986
msgid "Open the advanced module build instructions"
msgstr "Åpne byggeinstruksjonene for avansert modul"

#: prefs.js:992
msgid "More of my work..."
msgstr "Mer av arbeidet mitt …"

#: prefs.js:996
msgid "Kiwi Menu"
msgstr "Kiwi Menu"

#: prefs.js:996
msgid "MacOS style menu for GNOME"
msgstr "macOS-lignende meny for GNOME"

#: prefs.js:997
msgid "AppManager"
msgstr "AppManager"

#: prefs.js:997
msgid "MacOS style AppImage installer and management application"
msgstr "MacOS-stil AppImage installasjons- og administrasjonsapplikasjon"

#: prefs.js:998
msgid "Catalina Reloaded Icon Pack"
msgstr "Catalina Reloaded Icon Pack"

#: prefs.js:998
msgid "macOS Tahoe icon theme for Linux"
msgstr "macOS Tahoe-ikontema for Linux"

#: prefs.js:999
msgid "GDM Wallpaper"
msgstr "GDM Wallpaper"

#: prefs.js:999
msgid "Set custom GDM login screen wallpaper"
msgstr "Sett egendefinert bakgrunn for GDM-påloggingsskjerm"

#: prefs.js:1011
msgid "Other Recommended Extensions"
msgstr "Andre anbefalte utvidelser"

#: prefs.js:1012
msgid "Extensions that are compatible with Kiwi"
msgstr "Utvidelser som er kompatible med Kiwi"

#: prefs.js:1036 prefs.js:1050
msgid "Restore Defaults"
msgstr "Gjenopprett standardverdier"

#: prefs.js:1040
msgid "Reset every Kiwi setting to its default value"
msgstr "Tilbakestill alle Kiwi-innstillinger til standardverdien"

#: prefs.js:1046
msgid "Restore Default Settings?"
msgstr "Gjenopprett standardinnstillinger?"

#: prefs.js:1047
msgid ""
"Every Kiwi setting will be reset to its default value. This cannot be undone."
msgstr ""
"Alle Kiwi-innstillinger tilbakestilles til standardverdien. Dette kan ikke "
"angres."

#: prefs.js:1049
msgid "Cancel"
msgstr "Avbryt"

