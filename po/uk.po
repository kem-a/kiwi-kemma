#: prefs.js:361
msgid "Panel"
msgstr "Панель"

#: prefs.js:367 prefs.js:380
msgid "Panel Transparency"
msgstr "Прозорість панелі"

#: prefs.js:368
msgid "Configure panel transparency and appearance"
msgstr "Налаштування прозорості та вигляду панелі"

#: prefs.js:381
msgid "Make the top panel transparent"
msgstr "Зробити верхню панель прозорою"

#: prefs.js:388
msgid "Transparency Level"
msgstr "Рівень прозорості"

#: prefs.js:389
msgid "Set panel transparency (0-100)"
msgstr "Встановити рівень прозорості панелі (0-100)"

#: prefs.js:403
msgid "Opaque When Window Touches"
msgstr "Суцільна при дотику"

#: prefs.js:404
msgid "Make panel opaque when a window touches it"
msgstr "Робити панель непрозорою, коли її дотикається вікно"

#: prefs.js:412
msgid "Panel Blur"
msgstr "Розмиття"

#: prefs.js:413
msgid "Blur the background behind the panel"
msgstr "Розмивати тло позаду панелі"

#: prefs.js:421
msgid "Panel Color Fix"
msgstr "Виправлення кольору"

#: prefs.js:422
msgid "Fix white panel on some themes (e.g., Ubuntu Yaru)"
msgstr "Виправити білу панель у деяких темах (Ubuntu Yaru)"

#: prefs.js:429
msgid "Invert Tray Icons on Light Wallpapers"
msgstr "Інвертувати піктограми для світлих шпалер"

#: prefs.js:430
msgid ""
"Darken white monochrome tray icons when the panel adapts to a light "
"wallpaper. Colored icons are left untouched"
msgstr ""
"Затемнювати білі монохромні піктограми, якщо панель підлаштовується під "
"світлі шпалери. Кольорові піктограми залишаються без змін"

#: prefs.js:463
msgid "Panel Items"
msgstr "Елементи панелі"

#: prefs.js:464
msgid "Choose what the top panel and its menus show"
msgstr "Виберіть, що відображатиметься на верхній панелі та в її меню"

#: prefs.js:471
msgid "Show Window Title"
msgstr "Заголовок вікна"

#: prefs.js:472
msgid "Display current window title in the top panel"
msgstr "Відображати заголовок поточного вікна на панелі"

#: prefs.js:481
msgid "Hide App Icon"
msgstr "Приховати піктограму програми"

#: prefs.js:482
msgid "Do not show the application icon next to the window title"
msgstr "Прибрати піктограму програми поруч із заголовком вікна"

#: prefs.js:489
msgid "Disable Window Tiling"
msgstr "Вимкнути параметри укладання вікон"

#: prefs.js:490
msgid ""
"Drop the tiling layouts from the window title menu, and stop restoring tiled "
"windows when their titlebar is dragged"
msgstr ""
"Прибрати укладання вікон з меню заголовка та припинити відновлення вікон під "
"час перетягування"

#: prefs.js:510
msgid "Show Panel in Fullscreen on Hover"
msgstr "Панель у повноекранному режимі при наведенні"

#: prefs.js:510
msgid ""
"Show panel when mouse is near top edge in fullscreen. Bugged for GTK4 apps."
msgstr ""
"Показувати панель, коли курсор біля верхнього краю екрана. (Може працювати "
"нестабільно з програмами GTK4)."

#: prefs.js:518
msgid "Move Calendar to Right"
msgstr "Календар праворуч"

#: prefs.js:519
msgid "Move calendar to right side and hide notifications"
msgstr "Перемістити календар у правий кут і перенести сповіщення"

#: prefs.js:528
msgid "Keep GNOME Notification Panel"
msgstr "Звичайна панель сповіщень GNOME"

#: prefs.js:529
msgid "Don't split notification and calendar layout"
msgstr "Не розділяти макет сповіщень та календаря"

#: prefs.js:536
msgid "Indicator Style"
msgstr "Стиль індикаторів"

#: prefs.js:537
msgid "Notification dot recolor"
msgstr "Колір крапки сповіщень"

#: prefs.js:540 prefs.js:826
msgid "Default"
msgstr "Типово"

#: prefs.js:540
msgid "Accent"
msgstr "Акцент"

#: prefs.js:540
msgid "Symbolic"
msgstr "Силует"

#: prefs.js:547
msgid "Battery Percentage"
msgstr "Відсоток наснаги акумулятора"

#: prefs.js:559
msgid ""
"Unavailable while GNOME Settings shows the battery percentage in the top bar"
msgstr "Недоступно, доки Параметри GNOME показують відсоток наснаги на панелі"

#: prefs.js:560
msgid "Show battery percentage in the top bar when below 20%"
msgstr "Відсоток на панелі, коли акумулятор виснажено нижче 20%"

#: prefs.js:566
msgid "Caps Lock and Num Lock"
msgstr "Caps Lock та Num Lock"

#: prefs.js:566
msgid "Show Caps Lock and Num Lock icon"
msgstr "Показувати індикатори Caps Lock та Num Lock"

#: prefs.js:567
msgid "Custom Do Not Disturb Button"
msgstr "Власна кнопка Не турбувати"

#: prefs.js:567
msgid ""
"Replace the system Do Not Disturb button with Kiwi's custom implementation"
msgstr "Замінити системну кнопку Не турбувати на реалізацію від Ківі"

#: prefs.js:568
msgid "Hide Activities Button"
msgstr "Приховати «Діяльність»"

#: prefs.js:568
msgid "Hide the Activities button in the top panel"
msgstr "Прибрати кнопку з панелі"

#: prefs.js:569
msgid "Add Username"
msgstr "Ім'я користувача"

#: prefs.js:569
msgid "Add username to the quick menu"
msgstr "Додати ім'я користувача до швидких параметрів"

#: prefs.js:573 prefs.js:771
msgid "Styling"
msgstr "Стилізація"

#: prefs.js:574
msgid ""
"Restyle stock GNOME Shell elements and GTK apps. Log out and back in for "
"changes to take effect"
msgstr ""
"Змінити стиль базових елементів GNOME Shell та програм GTK. Вийдіть із "
"системи та зайдіть знову, щоб зміни набули чинності"

#: prefs.js:579
msgid "Panel Styling"
msgstr "Стилізація панелі"

#: prefs.js:579
msgid ""
"Tighter button spacing, bold titles, smaller status icons, no dropdown "
"arrows and a transparent panel in the overview"
msgstr ""
"Щільніші інтервали, жирні заголовки, менші піктограми статусу, без стрілок "
"випадних списків та прозора панель під час огляду діяльностей"

#: prefs.js:580
msgid "Menu and App Styling"
msgstr "Стилізація меню та програм"

#: prefs.js:580
msgid ""
"Narrower shell menu items with accent-colored hover and selection, plus the "
"GTK app fixes"
msgstr ""
"Вужчі елементи меню із виділенням акцентним кольором при наведенні, плюс "
"виправлення для програм GTK"

#: prefs.js:586
msgid "Style Keyboard Indicator"
msgstr "Стилізація індикатора клавіатури"

#: prefs.js:587
msgid ""
"Slightly style keyboard/input source indicator by converting to uppercase "
"and adding border"
msgstr "Легка стилізація джерела вводу, заголовні літери в рамці"

#: prefs.js:594
msgid "Hide keyboard indicator"
msgstr "Приховати індикатор клавіатури"

#: prefs.js:595
msgid "Completely hide the indicator from the panel"
msgstr "Прибрати індикатор із панелі"

#: prefs.js:623
msgid "Dock"
msgstr "Полиця"

#: prefs.js:629
msgid "Dock Items"
msgstr "Область завдань"

#: prefs.js:630
msgid "Add extra items to Dash-to-Dock"
msgstr "Додаткові елементи до панелі Dash-to-Dock"

#: prefs.js:635
msgid "Minimize Windows to Dock"
msgstr "Згортати вікна до області завдань"

#: prefs.js:635
msgid ""
"Park minimized windows as thumbnails in Dash-to-Dock, after the apps and "
"before the trash"
msgstr ""
"Розміщувати згорнуті вікна як мініатюри в Dash-to-Dock /n(після програм і "
"перед смітником)"

#: prefs.js:639
msgid "Downloads Folder in Dock"
msgstr "Тека завантажень"

#: prefs.js:640
msgid ""
"Add a Downloads folder before the trash that fans its newest files out over "
"the desktop"
msgstr ""
"Додає теку завантажень перед смітником. При натисканні розгортає віялом "
"найновіші файли на стільниці"

#: prefs.js:648
msgid "Stack Behind Folder"
msgstr "Ефект стосів за текою"

#: prefs.js:649
msgid ""
"Show the newest files sticking out of the folder icon instead of piled on "
"top of it"
msgstr ""
"Показувати найновіші файли так, ніби вони виглядають з-за теки, а не лежать "
"згори"

#: prefs.js:667
msgid "Launchpad Application"
msgstr "Програмотека"

#: prefs.js:668
msgid ""
"Add custom Launchpad icon to dock that opens application overview. "
"Recommended to hide default app launcher."
msgstr ""
"Додати піктограму Програмотеки до області завдань / панелі приладів, що "
"відкриватиме огляд програм. Рекомендується приховати стандартний запускач."

#: prefs.js:678
msgid "Custom Icon"
msgstr "Власна піктограма"

#: prefs.js:681 prefs.js:766
msgid "Using default icon"
msgstr "Використовується типова піктограма"

#: prefs.js:689
msgid "Reset to default icon"
msgstr "Скинути до типової піктограми"

#: prefs.js:700
msgid "Browse for icon"
msgstr "Огляд піктограми"

#: prefs.js:705
msgid "Select Launchpad Icon"
msgstr "Вибрати піктограму"

#: prefs.js:709
msgid "Images (PNG, SVG)"
msgstr "Зображення (PNG, SVG)"

#: prefs.js:737
msgid "Icon Too Large"
msgstr "Піктограма завелика"

#: prefs.js:738
msgid ""
"The selected image exceeds 512×512 pixels. Please choose a smaller image."
msgstr ""
"Вибране зображення перевищує розмір 512×512 пікселів. Будь ласка, виберіть "
"менше."

#: prefs.js:740
msgid "OK"
msgstr "ОК"

#: prefs.js:776
msgid "Dock Styling"
msgstr "Область завдань"

#: prefs.js:776
msgid ""
"Tighten icon spacing, drop the icon highlight and darken icons while pressed"
msgstr ""
"Зменшити інтервали, прибрати підсвічування та затемнювати піктограми при "
"натисканні"

#: prefs.js:777
msgid "Dock Blur"
msgstr "Розмиття"

#: prefs.js:777
msgid ""
"Blur the background behind Dash-to-Dock. Recommended fixed dock opacity 10% "
"- 30%, min 1%."
msgstr ""
"Розмивати тло позаду Dash-to-Dock. Рекомендована фіксована непрозорість "
"полиці 10%–30%, щонайменше 1%."

#: prefs.js:778
msgid "Adaptive Dock Colors"
msgstr "Адаптивні кольори полиці"

#: prefs.js:778
msgid ""
"Flip the running indicators and separators to suit whatever is behind the "
"dock, wallpaper or window"
msgstr ""
"Змінювати індикатори запущених програм і роздільники відповідно до того, що "
"позаду полиці, шпалер чи вікна"

#: prefs.js:785
msgid "Buttons"
msgstr "Кнопки"

#: prefs.js:791
msgid "Window Control Button Style"
msgstr "Стиль кнопок керування вікном"

#: prefs.js:792
msgid ""
"Choose the window control button style. Log out to apply it across all apps."
msgstr ""
"Виберіть стиль кнопок керування вікном. Вийдіть із системи, щоб застосувати "
"для всіх програм."

#: prefs.js:800
msgid "Enable macOS Window Buttons"
msgstr "Кнопки вікон у стилі macOS"

#: prefs.js:801
msgid "Replace window control buttons in application windows with macOS style"
msgstr "Замінити кнопки керування вікнами на стиль macOS"

#: prefs.js:822
msgid "Button Type"
msgstr "Тип кнопок"

#: prefs.js:823
msgid "Choose the button icon set"
msgstr "Набір піктограм для кнопок"

#: prefs.js:826
msgid "Alternative"
msgstr "Додатковий"

#: prefs.js:832
msgid "Button Size"
msgstr "Розмір кнопок"

#: prefs.js:833
msgid "Choose button size"
msgstr "Вибрати розмір кнопок"

#: prefs.js:836
msgid "Small"
msgstr "Малий"

#: prefs.js:836
msgid "Normal"
msgstr "Звичайний"

#: prefs.js:842
msgid "Firefox Styling"
msgstr "Стилізація Firefox"

#: prefs.js:843
msgid ""
"Apply macOS window control styling for Firefox. Recommended to use with "
"vertical tabs."
msgstr ""
"Застосувати стиль керування вікнами macOS для Firefox. Рекомендується для "
"вертикальних вкладок."

#: prefs.js:851
msgid "Thunderbird Styling"
msgstr "Стилізація Thunderbird"

#: prefs.js:852
msgid "Apply macOS window control styling for Thunderbird."
msgstr "Застосувати стиль керування вікнами macOS для Thunderbird."

#: prefs.js:876
msgid "Show Window Controls on Panel"
msgstr "Керування вікном на панелі"

#: prefs.js:877
msgid ""
"Display close, minimize, maximize buttons in the top panel when window is "
"maximized"
msgstr ""
"Відображати кнопки закриття, згортання та розгортання на панелі для "
"розгорнутих вікон"

#: prefs.js:891
msgid "Only when Fullscreen"
msgstr "Лише у повноекранному режимі"

#: prefs.js:892
msgid ""
"Hide titlebars and show panel controls only for fullscreen windows, not "
"maximized"
msgstr ""
"Ховати заголовки та показувати елементи керування на панелі лише для "
"повноекранних вікон, не для розгорнутих"

#: prefs.js:901
msgid "Options"
msgstr "Параметри"

#: prefs.js:907
msgid "Kiwi"
msgstr "Ківі"

#: prefs.js:908
msgid ""
"Kiwi is not like Apple, it's free open source project that brings macOS-like "
"feel for GNOME"
msgstr ""
"Ківі не копіює Apple, це відкритий проєкт, що додає GNOME естетики macOS"

#: prefs.js:913
msgid "Overview Wallpaper Blur"
msgstr "Розмиття тла в огляді"

#: prefs.js:913
msgid "Use blurred current wallpaper as overview background"
msgstr "Розмивати тло в огляді діяльностей"

#: prefs.js:914
msgid "Skip to Desktop"
msgstr "Одразу стільниця"

#: prefs.js:914
msgid "Do not show the overview when logging in. Animation is still visible"
msgstr "Пропускати огляд під час входу в систему. Анімація залишається"

#: prefs.js:915
msgid "Hide Minimized Windows"
msgstr "Приховати згорнуті вікна"

#: prefs.js:915
msgid "Hide minimized windows in the overview"
msgstr "Ховати згорнуті вікна в огляді діяльностей"

#: prefs.js:916
msgid "Move Window to New Workspace"
msgstr "Перемістити вікно на новий робочий простір"

#: prefs.js:916
msgid "Move fullscreen window to a new workspace"
msgstr "Переміщати повноекранні вікна на новий робочий простір"

#: prefs.js:917
msgid "Reduce App Animations"
msgstr "Спростити анімацію програм"

#: prefs.js:917
msgid "Mimic macOS window opening and closing with a subtle scale and fade"
msgstr ""
"Імітувати відкриття та закриття вікон у стилі macOS, плавне масштабування і "
"згасання"

#: prefs.js:918
msgid "Transparent Move"
msgstr "Прозоре перетягування"

