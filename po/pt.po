msgid "Dock Styling"
msgstr "Estilo da doca"

#: prefs.js:785
msgid ""
"Tighten icon spacing, drop the icon highlight and darken icons while pressed"
msgstr ""
"Reduzir o espaçamento dos ícones, remover o destaque do ícone e escurecer os "
"ícones ao premir"

#: prefs.js:786
