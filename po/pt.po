#: prefs.js:396
msgid "Panel"
msgstr "Painel"

#: prefs.js:402 prefs.js:415
msgid "Panel Transparency"
msgstr "Transparência do painel"

#: prefs.js:403
msgid "Configure panel transparency and appearance"
msgstr "Configure a transparência e aparência do painel"

#: prefs.js:416
msgid "Make the top panel transparent"
msgstr "Deixar o painel superior transparente"

#: prefs.js:423
msgid "Transparency Level"
msgstr "Nível de transparência"

#: prefs.js:424
msgid "Set panel transparency (0-100)"
msgstr "Definir a transparência do painel (0–100)"

#: prefs.js:438
msgid "Opaque When Window Maximized"
msgstr "Opaco com janela maximizada"

#: prefs.js:439
msgid "Make panel opaque when a maximized window touches it"
msgstr "Tornar o painel opaco quando uma janela maximizada lhe toca"

#: prefs.js:447
msgid "Panel Blur"
msgstr "Desfoque do painel"

#: prefs.js:448
msgid "Blur the background behind the panel"
msgstr "Desfocar o fundo atrás do painel"

#: prefs.js:456
msgid "Panel Color Fix"
msgstr "Correção de cor do painel"

#: prefs.js:457
msgid "Fix white panel on some themes (e.g., Ubuntu Yaru)"
msgstr "Corrigir painel branco em alguns temas (ex.: Ubuntu Yaru)"

#: prefs.js:464
msgid "Invert Tray Icons on Light Wallpapers"
msgstr "Inverter ícones da área de notificação em fundos claros"

#: prefs.js:465
msgid ""
"Darken white monochrome tray icons when the panel adapts to a light "
"wallpaper. Colored icons are left untouched"
msgstr ""
"Escurecer os ícones monocromáticos brancos da área de notificação quando o "
"painel se adapta a um fundo claro. Os ícones coloridos não são alterados"

#: prefs.js:498
msgid "Panel Items"
msgstr "Itens do painel"

#: prefs.js:499
msgid "Choose what the top panel and its menus show"
msgstr "Escolha o que a barra superior e os seus menus mostram"

#: prefs.js:504
msgid "Show Panel in Fullscreen on Hover"
msgstr "Mostrar o painel em ecrã completo ao passar o rato"

#: prefs.js:504
msgid ""
"Show panel when mouse is near top edge in fullscreen. Bugged for GTK4 apps."
msgstr ""
"Mostrar o painel quando o mouse estiver perto da borda superior em tela "
"cheia. Apresenta erros em aplicativos GTK4."

#: prefs.js:510
msgid "Show Window Title"
msgstr "Mostrar título da janela"

#: prefs.js:511
msgid "Display current window title in the top panel"
msgstr "Exibir o título da janela atual no painel superior"

#: prefs.js:520
msgid "Hide App Icon"
msgstr "Ocultar o ícone da aplicação"

#: prefs.js:521
msgid "Do not show the application icon next to the window title"
msgstr "Não mostrar o ícone da aplicação junto ao título da janela"

#: prefs.js:528
msgid "Hide Window Subtitle"
msgstr "Ocultar subtítulo da janela"

#: prefs.js:529
msgid "Show only the application name, without the window's own title"
msgstr "Mostrar apenas o nome da aplicação, sem o título próprio da janela"

#: prefs.js:536
msgid "Disable Window Tiling"
msgstr "Desativar o alinhamento de janelas"

#: prefs.js:537
msgid ""
"Drop the tiling layouts from the window title menu, and stop restoring tiled "
"windows when their titlebar is dragged"
msgstr ""
"Remover as disposições de alinhamento do menu do título da janela e deixar de"
" restaurar as janelas alinhadas quando a sua barra de título é arrastada"

#: prefs.js:563
msgid "Move Calendar to Right"
msgstr "Mover calendário para a direita"

#: prefs.js:564
msgid "Move calendar to right side and hide notifications"
msgstr "Mover o calendário para o lado direito e ocultar notificações"

#: prefs.js:573
msgid "Keep GNOME Notification Panel"
msgstr "Manter o painel de notificações do GNOME"

#: prefs.js:574
msgid "Don't split notification and calendar layout"
msgstr "Não separar o layout de notificações e calendário"

#: prefs.js:581
msgid "Indicator Style"
msgstr "Estilo do indicador"

#: prefs.js:582
msgid "Notification dot recolor"
msgstr "Cor do ponto de notificação"

#: prefs.js:585 prefs.js:899
msgid "Default"
msgstr "Padrão"

#: prefs.js:585
msgid "Accent"
msgstr "Cor de destaque"

#: prefs.js:585
msgid "Symbolic"
msgstr "Simbólico"

#: prefs.js:592
msgid "Battery Percentage"
msgstr "Porcentagem da bateria"

#: prefs.js:604
msgid ""
"Unavailable while GNOME Settings shows the battery percentage in the top bar"
msgstr ""
"Indisponível enquanto as Definições do GNOME mostram a percentagem da bateria"
" na barra superior"

#: prefs.js:605
msgid "Show battery percentage in the top bar when below 20%"
msgstr ""
"Mostrar a porcentagem da bateria na barra superior quando estiver abaixo de "
"20%"

#: prefs.js:611
msgid "Caps Lock and Num Lock"
msgstr "Caps Lock e Num Lock"

#: prefs.js:611
msgid "Show Caps Lock and Num Lock icon"
msgstr "Mostrar ícone de Caps Lock e Num Lock"

#: prefs.js:612
msgid "Custom Do Not Disturb Button"
msgstr "Botão personalizado Não perturbar"

#: prefs.js:612
msgid ""
"Replace the system Do Not Disturb button with Kiwi's custom implementation"
msgstr ""
"Substitui o botão Não perturbar do sistema pela implementação personalizada "
"do Kiwi"

#: prefs.js:613
msgid "Hide Activities Button"
msgstr "Ocultar o botão Atividades"

#: prefs.js:613
msgid "Hide the Activities button in the top panel"
msgstr "Ocultar o botão Atividades no painel superior"

#: prefs.js:614
msgid "Add Username"
msgstr "Adicionar nome de usuário"

#: prefs.js:614
msgid "Add username to the quick menu"
msgstr "Adicionar o nome de usuário ao menu rápido"

#: prefs.js:618 prefs.js:828
msgid "Styling"
msgstr "Estilo"

#: prefs.js:619
msgid ""
"Restyle stock GNOME Shell elements and GTK apps. Log out and back in for "
"changes to take effect"
msgstr ""
"Alterar o estilo dos elementos originais do GNOME Shell e das aplicações GTK."
" Termine a sessão e inicie-a novamente para aplicar as alterações"

#: prefs.js:624
msgid "Panel Styling"
msgstr "Estilo do painel"

#: prefs.js:624
msgid ""
"Tighter button spacing, smaller status icons, no dropdown arrows and a "
"transparent panel in the overview"
msgstr ""
"Espaçamento de botões mais compacto, ícones de estado menores, sem setas de "
"menu e painel transparente na vista geral"

#: prefs.js:625
msgid "Menu and App Styling"
msgstr "Estilo de menus e aplicações"

#: prefs.js:625
msgid ""
"Narrower shell menu items with accent-colored hover and selection, plus the "
"GTK app fixes"
msgstr ""
"Itens de menu da shell mais estreitos com cor de destaque ao passar o rato e "
"ao selecionar, além das correções para aplicações GTK"

#: prefs.js:631
msgid "Style Keyboard Indicator"
msgstr "Estilizar indicador de teclado"

#: prefs.js:632
msgid ""
"Slightly style keyboard/input source indicator by converting to uppercase and"
" adding border"
msgstr ""
"Estilizar levemente o indicador de teclado/origem de entrada, convertendo "
"para maiúsculas e adicionando borda"

#: prefs.js:639
msgid "Hide keyboard indicator"
msgstr "Ocultar indicador de teclado"

#: prefs.js:640
msgid "Completely hide the indicator from the panel"
msgstr "Ocultar completamente o indicador do painel"

#: prefs.js:668
msgid "Dock"
msgstr "Doca"

#: prefs.js:677
msgid "These options need the Dash to Dock extension installed and enabled"
msgstr "Estas opções requerem a extensão Dash to Dock instalada e ativada"

#: prefs.js:685
msgid "Dock Items"
msgstr "Itens da doca"

#: prefs.js:686
msgid "Add extra items to Dash-to-Dock"
msgstr "Adicionar itens extra ao Dash-to-Dock"

#: prefs.js:691
msgid "Minimize Windows to Dock"
msgstr "Minimizar janelas para a doca"

#: prefs.js:691
msgid ""
"Park minimized windows as thumbnails in Dash-to-Dock, after the apps and "
"before the trash"
msgstr ""
"Colocar as janelas minimizadas como miniaturas no Dash-to-Dock, após as "
"aplicações e antes do lixo"

#: prefs.js:695
msgid "Downloads Folder in Dock"
msgstr "Pasta Transferências na doca"

#: prefs.js:696
msgid ""
"Add a Downloads folder before the trash that fans its newest files out over "
"the desktop"
msgstr ""
"Adicionar uma pasta Transferências antes do lixo que espalha os ficheiros "
"mais recentes pelo ambiente de trabalho"

#: prefs.js:705
msgid "Stack Behind Folder"
msgstr "Empilhar atrás da pasta"

#: prefs.js:706
msgid ""
"Show the newest files sticking out of the folder icon instead of piled on top"
" of it"
msgstr ""
"Mostrar os ficheiros mais recentes a sair de trás do ícone da pasta em vez de"
" empilhados sobre ele"

#: prefs.js:724
msgid "Launchpad Application"
msgstr "Aplicativo Launchpad"

#: prefs.js:725
msgid ""
"Add custom Launchpad icon to dock that opens application overview. "
"Recommended to hide default app launcher."
msgstr ""
"Adicionar um ícone Launchpad personalizado ao dock que abre o overview de "
"aplicativos. Recomenda-se ocultar o iniciador padrão."

#: prefs.js:735
msgid "Custom Icon"
msgstr "Ícone personalizado"

#: prefs.js:738 prefs.js:823
msgid "Using default icon"
msgstr "A utilizar o ícone predefinido"

#: prefs.js:746
msgid "Reset to default icon"
msgstr "Repor o ícone predefinido"

#: prefs.js:757
msgid "Browse for icon"
msgstr "Procurar ícone"

#: prefs.js:762
msgid "Select Launchpad Icon"
msgstr "Selecionar ícone do Launchpad"

#: prefs.js:766
msgid "Images (PNG, SVG)"
msgstr "Imagens (PNG, SVG)"

#: prefs.js:794
msgid "Icon Too Large"
msgstr "Ícone demasiado grande"

#: prefs.js:795
msgid ""
"The selected image exceeds 512×512 pixels. Please choose a smaller image."
msgstr ""
"A imagem selecionada excede 512×512 pixels. Escolha uma imagem mais pequena."

#: prefs.js:797
msgid "OK"
msgstr "OK"

#: prefs.js:833
msgid "Dock Styling"
msgstr "Estilo da doca"

#: prefs.js:833
msgid ""
"Tighten icon spacing, drop the icon highlight and darken icons while pressed"
msgstr ""
"Reduzir o espaçamento dos ícones, remover o destaque do ícone e escurecer os "
"ícones ao premir"

#: prefs.js:834
msgid "Dock Blur"
msgstr "Desfoque do dock"

#: prefs.js:834
msgid ""
"Blur the background behind Dash-to-Dock. Recommended fixed dock opacity 10% -"
" 30%, min 1%."
msgstr ""
"Desfocar o fundo atrás do Dash-to-Dock. Opacidade fixa da doca recomendada de"
" 10% a 30%, mínimo 1%."

#: prefs.js:835
msgid "Adaptive Dock Colors"
msgstr "Cores adaptáveis da doca"

#: prefs.js:835
msgid ""
"Flip the running indicators and separators to suit whatever is behind the "
"dock, wallpaper or window"
msgstr ""
"Inverte os indicadores de execução e os separadores conforme o que está atrás"
" da doca, papel de parede ou janela"

#: prefs.js:858
msgid "Buttons"
msgstr "Botões"

#: prefs.js:864
msgid "Window Control Button Style"
msgstr "Estilo dos botões de controle da janela"

#: prefs.js:865
msgid ""
"Choose the window control button style. Log out to apply it across all apps."
msgstr ""
"Escolha o estilo dos botões de controle da janela. Saia da sessão para "
"aplicar em todos os aplicativos."

#: prefs.js:873
msgid "Enable macOS Window Buttons"
msgstr "Ativar botões de janela do macOS"

#: prefs.js:874
msgid "Replace window control buttons in application windows with macOS style"
msgstr ""
"Substituir os botões de controlo de janela nas aplicações pelo estilo macOS"

#: prefs.js:895
msgid "Button Type"
msgstr "Tipo de botão"

#: prefs.js:896
msgid "Choose the button icon set"
msgstr "Escolha o conjunto de ícones dos botões"

#: prefs.js:899
msgid "Alternative"
msgstr "Alternativo"

#: prefs.js:899
msgid "Glass"
msgstr "Vidro"

#: prefs.js:905
msgid "Button Size"
msgstr "Tamanho do botão"

#: prefs.js:906
msgid "Choose button size"
msgstr "Escolher tamanho do botão"

#: prefs.js:909
msgid "Small"
msgstr "Pequeno"

#: prefs.js:909
msgid "Normal"
msgstr "Normal"

#: prefs.js:915
msgid "Firefox Styling"
msgstr "Estilo para Firefox"

#: prefs.js:916
msgid ""
"Apply macOS window control styling for Firefox. Recommended to use with "
"vertical tabs."
msgstr ""
"Aplicar o estilo de controle de janela do macOS ao Firefox. Recomendado usar "
"com abas verticais."

#: prefs.js:924
msgid "Thunderbird Styling"
msgstr "Estilo para Thunderbird"

#: prefs.js:925
msgid "Apply macOS window control styling for Thunderbird."
msgstr "Aplicar o estilo dos controlos de janela do macOS ao Thunderbird."

#: prefs.js:949
msgid "Show Window Controls on Panel"
msgstr "Mostrar controles de janela no painel"

#: prefs.js:950
msgid ""
"Display close, minimize, maximize buttons in the top panel when window is "
"maximized"
msgstr ""
"Mostrar os botões fechar, minimizar e maximizar no painel superior quando a "
"janela está maximizada"

#: prefs.js:964
msgid "Only when Fullscreen"
msgstr "Apenas em ecrã completo"

#: prefs.js:965
msgid ""
"Hide titlebars and show panel controls only for fullscreen windows, not "
"maximized"
msgstr ""
"Ocultar as barras de título e mostrar os controlos do painel apenas para "
"janelas em ecrã completo, não maximizadas"

#: prefs.js:974
msgid "Options"
msgstr "Opções"

#: prefs.js:980
msgid "Kiwi"
msgstr "Kiwi"

#: prefs.js:981
msgid ""
"Kiwi is not like Apple, it's free open source project that brings macOS-like "
"feel for GNOME"
msgstr ""
"Kiwi não é Apple; é um projeto livre e de código aberto que dá ao GNOME uma "
"sensação parecida com o macOS"

#: prefs.js:986
msgid "Overview Wallpaper Blur"
msgstr "Desfoque do papel de parede do overview"

#: prefs.js:986
msgid "Use blurred current wallpaper as overview background"
msgstr "Usar o fundo atual desfocado como fundo da vista geral"

#: prefs.js:987
msgid "Seamless Overview Zoom"
msgstr "Zoom contínuo da vista geral"

#: prefs.js:987
msgid ""
"Zoom the whole desktop, including the strip behind the panel, in and out of "
"the overview"
msgstr ""
"Ampliar e reduzir todo o ambiente de trabalho, incluindo a faixa atrás do "
"painel, ao entrar e sair da vista geral"

#: prefs.js:988
msgid "Focus on Overview Exit"
msgstr "Foco ao sair da vista geral"

#: prefs.js:988
msgid ""
"Focus the window under the cursor instead of the previously focused one when "
"leaving the overview"
msgstr ""
"Focar a janela sob o cursor em vez da janela focada anteriormente ao sair da "
"vista geral"

#: prefs.js:989
msgid "Skip to Desktop"
msgstr "Ir direto para a área de trabalho"

#: prefs.js:989
msgid "Do not show the overview when logging in. Animation is still visible"
msgstr "Não mostrar o overview ao iniciar a sessão. A animação ainda aparece."

#: prefs.js:990
msgid "Hide Minimized Windows"
msgstr "Ocultar janelas minimizadas"

#: prefs.js:990
msgid "Hide minimized windows in the overview"
msgstr "Ocultar janelas minimizadas no overview"

#: prefs.js:991
msgid "Move Window to New Workspace"
msgstr "Mover janela para novo espaço de trabalho"

#: prefs.js:991
msgid "Move fullscreen window to a new workspace"
msgstr "Mover janela em tela cheia para um novo espaço de trabalho"

#: prefs.js:992
msgid "Reduce App Animations"
msgstr "Reduzir as animações das aplicações"

#: prefs.js:992
msgid "Mimic macOS window opening and closing with a subtle scale and fade"
msgstr ""
"Imitar a abertura e o fecho de janelas do macOS com uma ligeira escala e "
"desvanecimento"

#: prefs.js:993
msgid "Focus New Windows"
msgstr "Focar novas janelas"

#: prefs.js:993
msgid ""
"Automatically focus new windows instead of showing window-ready alerts. "
"Requires extension reload"
msgstr ""
"Focar automaticamente novas janelas em vez de mostrar alertas de janela "
"pronta. Requer recarregar a extensão"

#: prefs.js:994
msgid "Transparent Move"
msgstr "Movimento transparente"

#: prefs.js:994
msgid "Move window with transparency"
msgstr "Mover janela com transparência"

#: prefs.js:1001
msgid "Advanced"
msgstr "Avançado"

#: prefs.js:1031
msgid "Titlebuttons Hover Effect for GTK3 apps"
msgstr "Efeito hover dos botões de janela para apps GTK3"

#: prefs.js:1044
msgid ""
"The titlebuttons hover module provides macOS-like hover effects for window controls in GTK3 applications. GTK3 apps cannot natively show hover effects on all three window controls simultaneously, requiring this custom library to achieve the desired behavior.\n"
"\n"
"This binary code cannot be distributed through the GNOME Extensions platform due to security policies regarding native libraries, but manual installation is possible."
msgstr ""
"O módulo de efeito hover dos botões de janela fornece efeitos semelhantes ao macOS para os controles de janela em aplicações GTK3. Apps GTK3 não conseguem mostrar efeitos hover nos três controles ao mesmo tempo, exigindo esta biblioteca para alcançar o comportamento desejado.\n"
"\n"
"Esse código binário não pode ser distribuído pela plataforma GNOME Extensions devido às políticas de segurança sobre bibliotecas nativas, mas a instalação manual é possível."

#: prefs.js:1060
msgid "Installation Guide on GitHub"
msgstr "Guia de instalação no GitHub"

#: prefs.js:1062
msgid "Open the advanced module build instructions"
msgstr "Abrir as instruções de compilação do módulo avançado"

#: prefs.js:1068
msgid "More of my work..."
msgstr "Mais do meu trabalho…"

#: prefs.js:1072
msgid "Kiwi Menu"
msgstr "Kiwi Menu"

#: prefs.js:1072
msgid "MacOS style menu for GNOME"
msgstr "Menu ao estilo macOS para o GNOME"

#: prefs.js:1073
msgid "AppManager"
msgstr "AppManager"

#: prefs.js:1073
msgid "MacOS style AppImage installer and management application"
msgstr "Aplicação de instalação e gestão de AppImage no estilo MacOS"

#: prefs.js:1074
msgid "Catalina Reloaded Icon Pack"
msgstr "Catalina Reloaded Icon Pack"

#: prefs.js:1074
msgid "macOS Tahoe icon theme for Linux"
msgstr "Tema de ícones macOS Tahoe para Linux"

#: prefs.js:1075
msgid "GDM Wallpaper"
msgstr "GDM Wallpaper"

#: prefs.js:1075
msgid "Set custom GDM login screen wallpaper"
msgstr ""
"Definir imagem de fundo personalizada para o ecrã de início de sessão do GDM"

#: prefs.js:1087
msgid "Other Recommended Extensions"
msgstr "Outras extensões recomendadas"

#: prefs.js:1088
msgid "Extensions that are compatible with Kiwi"
msgstr "Extensões compatíveis com o Kiwi"

#: prefs.js:1112 prefs.js:1126
msgid "Restore Defaults"
msgstr "Restaurar predefinições"

