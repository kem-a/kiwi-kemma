#: prefs.js:331 prefs.js:338
msgid "Panel Transparency"
msgstr "Transparence du panneau"

#: prefs.js:332
msgid "Configure panel transparency and appearance"
msgstr "Configurer la transparence et l’apparence du panneau"

#: prefs.js:339
msgid "Make the top panel transparent"
msgstr "Rendre le panneau supérieur transparent"

#: prefs.js:347
msgid "Transparency Level"
msgstr "Niveau de transparence"

#: prefs.js:348
msgid "Set panel transparency (0-100)"
msgstr "Définir la transparence du panneau (0-100)"

#: prefs.js:362
msgid "Opaque When Window Touches"
msgstr "Opaque quand une fenêtre touche"

#: prefs.js:363
msgid "Make panel opaque when a window touches it"
msgstr "Rendre le panneau opaque lorsqu’une fenêtre le touche"

#: prefs.js:371
msgid "Panel Blur"
msgstr "Flou du panneau"

#: prefs.js:372
msgid "Blur the background behind the panel"
msgstr "Flouter l’arrière-plan derrière le panneau"

#: prefs.js:380
msgid "Panel Color Fix"
msgstr "Correction des couleurs du panneau"

#: prefs.js:381
msgid "Fix white panel on some themes (e.g., Ubuntu Yaru)"
msgstr "Corriger le panneau blanc sur certains thèmes (ex. : Ubuntu Yaru)"

#: prefs.js:414
msgid "Move Window to New Workspace"
msgstr "Déplacer la fenêtre vers un nouvel espace de travail"

#: prefs.js:414
msgid "Move fullscreen window to a new workspace"
msgstr "Déplacer la fenêtre plein écran vers un nouvel espace de travail"

#: prefs.js:415
msgid "Transparent Move"
msgstr "Déplacement transparent"

#: prefs.js:415
msgid "Move window with transparency"
msgstr "Déplacer la fenêtre avec transparence"

#: prefs.js:416
msgid "Battery Percentage"
msgstr "Pourcentage de batterie"

#: prefs.js:416
msgid "Show battery percentage in the top bar when below 20%"
msgstr ""
"Afficher le pourcentage de batterie dans la barre supérieure lorsqu’il est "
"inférieur à 20 %"

#: prefs.js:417
msgid "Move Calendar to Right"
msgstr "Déplacer le calendrier à droite"

#: prefs.js:417
msgid "Move calendar to right side and hide notifications"
msgstr "Déplacer le calendrier à droite et masquer les notifications"

#: prefs.js:418
msgid "Show Window Title"
msgstr "Afficher le titre de la fenêtre"

#: prefs.js:418
msgid "Display current window title in the top panel"
msgstr "Afficher le titre de la fenêtre actuelle dans le panneau supérieur"

#: prefs.js:419
msgid "Show Panel on Hover"
msgstr "Afficher le panneau au survol"

#: prefs.js:419
msgid ""
"Show panel when mouse is near top edge in fullscreen. Bugged for GTK4 apps."
msgstr ""
"Afficher le panneau lorsque la souris est proche du bord supérieur en plein "
"écran. Bug connu sur les applications GTK4."

#: prefs.js:420
msgid "Show Window Controls on Panel"
msgstr "Afficher les contrôles de fenêtre sur le panneau"

#: prefs.js:420
msgid ""
"Display close, minimize, maximize buttons in the top panel when window is "
"maximized"
msgstr ""
"Afficher les boutons fermer, réduire et agrandir dans le panneau supérieur "
"lorsque la fenêtre est maximisée"

#: prefs.js:421
msgid "Overview Wallpaper Blur"
msgstr "Flou du fond de l’aperçu"

#: prefs.js:421
msgid ""
"Use blurred current wallpaper as overview background (requires ImageMagick)"
msgstr ""
"Utiliser le fond d’écran actuel flouté comme arrière-plan de l’aperçu "
"(nécessite ImageMagick)"

#: prefs.js:422
msgid "Dock Blur"
msgstr "Flou du dock"

#: prefs.js:422
msgid "Blur the background behind Dash-to-Dock"
msgstr "Flouter l’arrière-plan derrière Dash-to-Dock"

#: prefs.js:445
msgid "Keep GNOME Notification Panel"
msgstr "Conserver le panneau de notifications GNOME"

#: prefs.js:446
msgid "Don't split notification and calendar layout"
msgstr "Ne pas séparer la disposition des notifications et du calendrier"

#: prefs.js:452
msgid "Indicator Style"
msgstr "Style de l’indicateur"

#: prefs.js:453
msgid "Notification dot recolor"
msgstr "Recoloration du point de notification"

#: prefs.js:463 prefs.js:562
msgid "Default"
msgstr "Par défaut"

#: prefs.js:467
msgid "Accent"
msgstr "Accent"

#: prefs.js:471
msgid "Symbolic"
msgstr "Symbolique"

#: prefs.js:498
msgid "ImageMagick not installed (install package \"imagemagick\" to enable)"
msgstr ""
"ImageMagick n’est pas installé (installez le paquet « imagemagick » pour "
"l’activer)"

#: prefs.js:507
msgid "Window Control Button Style"
msgstr "Style des boutons de contrôle de fenêtre"

#: prefs.js:508
msgid ""
"Choose the window control button style. Log out to apply it across all apps."
msgstr ""
"Choisissez le style des boutons de contrôle de fenêtre. Déconnectez-vous "
"pour l’appliquer à toutes les applications."

#: prefs.js:514
msgid "Enable macOS Window Buttons"
msgstr "Activer les boutons de fenêtre macOS"

#: prefs.js:515
msgid "Replace window control buttons in application windows with macOS style"
msgstr ""
"Remplacer les boutons de contrôle de fenêtre des applications par le style "
"macOS"

#: prefs.js:532
msgid "Firefox Styling"
msgstr "Style pour Firefox"

#: prefs.js:533
msgid ""
"Apply macOS window control styling for Firefox. Recommended to use with "
"vertical tabs."
msgstr ""
"Appliquer le style des contrôles macOS à Firefox. Recommandé avec les "
"onglets verticaux."

#: prefs.js:541
msgid "Thunderbird Styling"
msgstr "Style pour Thunderbird"

#: prefs.js:542
msgid "Apply macOS window control styling for Thunderbird."
msgstr "Appliquer le style des contrôles de fenêtre macOS à Thunderbird."

#: prefs.js:551
msgid "Button Type"
msgstr "Type de bouton"

#: prefs.js:552
msgid "Choose the button icon set"
msgstr "Choisir le jeu d'icônes des boutons"

#: prefs.js:566
msgid "Alternative"
msgstr "Alternatif"

#: prefs.js:583
msgid "Button Size"
msgstr "Taille des boutons"

#: prefs.js:584
msgid "Choose button size"
msgstr "Choisir la taille des boutons"

