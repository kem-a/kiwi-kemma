#: prefs.js:403
msgid "Opaque When Window Touches"
msgstr "Opaque quand une fenêtre touche"

#: prefs.js:404
msgid "Make panel opaque when a window touches it"
msgstr "Rendre le panneau opaque lorsqu’une fenêtre le touche"

#: prefs.js:412
msgid "Panel Blur"
msgstr "Flou du panneau"

#: prefs.js:413
msgid "Blur the background behind the panel"
msgstr "Flouter l’arrière-plan derrière le panneau"

#: prefs.js:421
