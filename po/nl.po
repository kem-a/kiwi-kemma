#: prefs.js:331 prefs.js:338
msgid "Panel Transparency"
msgstr "Paneeltransparantie"

#: prefs.js:332
msgid "Configure panel transparency and appearance"
msgstr "Configureer paneeltransparantie en uiterlijk"

#: prefs.js:339
msgid "Make the top panel transparent"
msgstr "Maak het bovenpaneel transparant"

#: prefs.js:347
msgid "Transparency Level"
msgstr "Transparantieniveau"

#: prefs.js:348
msgid "Set panel transparency (0-100)"
msgstr "Stel paneeltransparantie in (0–100)"

#: prefs.js:362
msgid "Opaque When Window Touches"
msgstr "Ondoorzichtig wanneer een venster het raakt"

#: prefs.js:363
msgid "Make panel opaque when a window touches it"
msgstr "Maak het paneel ondoorzichtig wanneer een venster het raakt"

#: prefs.js:371
msgid "Panel Blur"
msgstr "Paneelvervaging"

#: prefs.js:372
msgid "Blur the background behind the panel"
msgstr "Achtergrond achter het paneel vervagen"

#: prefs.js:380
msgid "Panel Color Fix"
msgstr "Paneelkleur-correctie"

#: prefs.js:381
msgid "Fix white panel on some themes (e.g., Ubuntu Yaru)"
msgstr "Los het witte paneel op in sommige thema's (bijv. Ubuntu Yaru)"

#: prefs.js:414
msgid "Move Window to New Workspace"
msgstr "Verplaats venster naar nieuw werkblad"

#: prefs.js:414
msgid "Move fullscreen window to a new workspace"
msgstr "Verplaats een volledig schermvenster naar een nieuw werkblad"

#: prefs.js:415
msgid "Transparent Move"
msgstr "Transparant verplaatsen"

#: prefs.js:415
msgid "Move window with transparency"
msgstr "Verplaats venster met transparantie"

#: prefs.js:416
msgid "Battery Percentage"
msgstr "Batterijpercentage"

#: prefs.js:416
msgid "Show battery percentage in the top bar when below 20%"
msgstr "Toon batterijpercentage in de bovenbalk wanneer deze onder 20% komt"

#: prefs.js:417
msgid "Move Calendar to Right"
msgstr "Verplaats kalender naar rechts"

#: prefs.js:417
msgid "Move calendar to right side and hide notifications"
msgstr "Verplaats de kalender naar de rechterkant en verberg meldingen"

#: prefs.js:418
msgid "Show Window Title"
msgstr "Toon venstertitel"

#: prefs.js:418
msgid "Display current window title in the top panel"
msgstr "Toon de huidige venstertitel in het bovenpaneel"

#: prefs.js:419
msgid "Show Panel on Hover"
msgstr "Paneel tonen bij zweven"

#: prefs.js:419
msgid ""
"Show panel when mouse is near top edge in fullscreen. Bugged for GTK4 apps."
msgstr ""
"Toon het paneel wanneer de muis aan de bovenrand is in volledig scherm. Bugs "
"bij GTK4-apps."

#: prefs.js:420
msgid "Show Window Controls on Panel"
msgstr "Vensterbediening op paneel tonen"

#: prefs.js:420
msgid ""
"Display close, minimize, maximize buttons in the top panel when window is "
"maximized"
msgstr ""
"Toon sluiten-, minimaliseren- en maximaliserenknoppen in het bovenpaneel als "
"het venster gemaximaliseerd is"

#: prefs.js:421
msgid "Overview Wallpaper Blur"
msgstr "Overzichtsachtergrond vervagen"

#: prefs.js:421
msgid ""
"Use blurred current wallpaper as overview background (requires ImageMagick)"
msgstr ""
"Gebruik een vervaagde versie van de huidige achtergrond als "
"overzichtsachtergrond (vereist ImageMagick)"

#: prefs.js:422
msgid "Dock Blur"
msgstr "Dock-vervaging"

#: prefs.js:422
msgid "Blur the background behind Dash-to-Dock"
msgstr "Achtergrond achter Dash-to-Dock vervagen"

#: prefs.js:445
msgid "Keep GNOME Notification Panel"
msgstr "GNOME-meldingenpaneel behouden"

#: prefs.js:446
msgid "Don't split notification and calendar layout"
msgstr "Meldingen en agenda niet splitsen"

#: prefs.js:452
msgid "Indicator Style"
msgstr "Indicatorstijl"

#: prefs.js:453
msgid "Notification dot recolor"
msgstr "Kleur van meldingsstip"

#: prefs.js:463 prefs.js:562
msgid "Default"
msgstr "Standaard"

#: prefs.js:467
msgid "Accent"
msgstr "Accent"

#: prefs.js:471
msgid "Symbolic"
msgstr "Symbolisch"

#: prefs.js:498
msgid "ImageMagick not installed (install package \"imagemagick\" to enable)"
msgstr ""
"ImageMagick is niet geïnstalleerd (installeer het pakket \"imagemagick\" om "
"te activeren)"

#: prefs.js:507
msgid "Window Control Button Style"
msgstr "Stijl voor vensterbedieningsknoppen"

#: prefs.js:508
msgid ""
"Choose the window control button style. Log out to apply it across all apps."
msgstr ""
"Kies de stijl van de vensterbedieningsknoppen. Log uit om het overal toe te "
"passen."

#: prefs.js:514
msgid "Enable macOS Window Buttons"
msgstr "macOS-vensterknoppen inschakelen"

#: prefs.js:515
msgid "Replace window control buttons in application windows with macOS style"
msgstr "Vervang vensterknoppen in toepassingsvensters door macOS-stijl"

#: prefs.js:532
msgid "Firefox Styling"
msgstr "Firefox-styling"

#: prefs.js:533
msgid ""
"Apply macOS window control styling for Firefox. Recommended to use with "
"vertical tabs."
msgstr ""
"Pas macOS-styling voor vensterbediening toe op Firefox. Aanbevolen met "
"verticale tabbladen."

#: prefs.js:541
msgid "Thunderbird Styling"
msgstr "Thunderbird-stijl"

#: prefs.js:542
msgid "Apply macOS window control styling for Thunderbird."
msgstr "Pas macOS-stijl voor vensterknoppen toe op Thunderbird."

#: prefs.js:551
msgid "Button Type"
msgstr "Knoptype"

#: prefs.js:552
msgid "Choose the button icon set"
msgstr "Kies het pictogrammenpakket voor de knoppen"

#: prefs.js:566
msgid "Alternative"
msgstr "Alternatief"

#: prefs.js:583
msgid "Button Size"
msgstr "Knopgrootte"

#: prefs.js:584
msgid "Choose button size"
msgstr "Kies knopgrootte"

#: prefs.js:594
msgid "Small"
msgstr "Klein"

#: prefs.js:598
msgid "Normal"
msgstr "Normaal"

#: prefs.js:631
msgid "Extras"
msgstr "Extra's"

#: prefs.js:637
msgid "Extra Features"
msgstr "Extra functies"

#: prefs.js:638
msgid "Additional customization options and utilities"
msgstr "Aanvullende aanpassingsopties en hulpprogramma's"

#: prefs.js:643
msgid "Add Username"
msgstr "Gebruikersnaam toevoegen"

#: prefs.js:643
msgid "Add username to the quick menu"
msgstr "Voeg gebruikersnaam toe aan het snelmenu"

#: prefs.js:644
msgid "Caps Lock and Num Lock"
msgstr "Caps Lock en Num Lock"

#: prefs.js:644
msgid "Show Caps Lock and Num Lock icon"
msgstr "Toon Caps Lock- en Num Lock-pictogram"

#: prefs.js:645
msgid "Hide Activities Button"
msgstr "Activiteitenknop verbergen"

#: prefs.js:645
msgid "Hide the Activities button in the top panel"
msgstr "Verberg de activiteitenknop in het bovenpaneel"

#: prefs.js:646
msgid "Hide Minimized Windows"
msgstr "Geminimaliseerde vensters verbergen"

#: prefs.js:646
msgid "Hide minimized windows in the overview"
msgstr "Verberg geminimaliseerde vensters in het overzicht"

#: prefs.js:647
msgid "Skip to Desktop"
msgstr "Direct naar bureaublad"

#: prefs.js:647
msgid "Do not show the overview when logging in. Animation is still visible"
msgstr "Toon het overzicht niet bij het inloggen. Animatie blijft zichtbaar."

#: prefs.js:648
msgid "Custom Do Not Disturb Button"
msgstr "Aangepaste Niet storen-knop"

#: prefs.js:648
msgid ""
"Replace the system Do Not Disturb button with Kiwi's custom implementation"
msgstr ""
"Vervangt de systeemknop Niet storen door de aangepaste implementatie van Kiwi"

#: prefs.js:663
msgid "Launchpad Application"
msgstr "Launchpad-app"

#: prefs.js:664
msgid ""
"Add custom Launchpad icon to dock that opens application overview. "
"Recommended to hide default app launcher."
msgstr ""
"Voeg een aangepast Launchpad-pictogram toe aan de dock dat het "
"toepassingsoverzicht opent. Aanbevolen om de standaardstarter te verbergen."

#: prefs.js:681
msgid "Custom Icon"
msgstr "Aangepast pictogram"

#: prefs.js:684 prefs.js:769
msgid "Using default icon"
msgstr "Standaardpictogram wordt gebruikt"

#: prefs.js:692
msgid "Reset to default icon"
msgstr "Standaardpictogram herstellen"

#: prefs.js:703
msgid "Browse for icon"
msgstr "Pictogram kiezen"

#: prefs.js:708
msgid "Select Launchpad Icon"
msgstr "Launchpad-pictogram kiezen"

#: prefs.js:712
msgid "Images (PNG, SVG)"
msgstr "Afbeeldingen (PNG, SVG)"

#: prefs.js:740
msgid "Icon Too Large"
msgstr "Pictogram is te groot"

#: prefs.js:741
msgid ""
"The selected image exceeds 512×512 pixels. Please choose a smaller image."
msgstr ""
"De geselecteerde afbeelding is groter dan 512×512 pixels. Kies een kleinere "
"afbeelding."

#: prefs.js:743
msgid "OK"
msgstr "OK"

#: prefs.js:775
msgid "Style Keyboard Indicator"
msgstr "Toetsenbordindicator stijlen"

#: prefs.js:776
msgid ""
"Slightly style keyboard/input source indicator by converting to uppercase "
"and adding border"
msgstr ""
"Stijl de toetsenbord-/invoerbronindicator licht door naar hoofdletters om te "
"zetten en een rand toe te voegen"

#: prefs.js:784
msgid "Hide keyboard indicator"
msgstr "Toetsenbordindicator verbergen"

#: prefs.js:785
msgid "Completely hide the indicator from the panel"
msgstr "Verberg de indicator volledig uit het paneel"

#: prefs.js:821
msgid "Advanced"
msgstr "Geavanceerd"

#: prefs.js:851
msgid "Titlebuttons Hover Effect for GTK3 apps"
msgstr "Zweefeffect voor titelknoppen in GTK3-apps"

#: prefs.js:862
msgid ""
"The titlebuttons hover module provides macOS-like hover effects for window "
"controls in GTK3 applications. GTK3 apps cannot natively show hover effects "
"on all three window controls simultaneously, requiring this custom library "
"to achieve the desired behavior.\n"
"\n"
"This binary code cannot be distributed through the GNOME Extensions platform "
"due to security policies regarding native libraries, but manual installation "
"is possible."
msgstr ""
"De titelknoppen-hovermodule biedt macOS-achtige effecten voor "
"vensterbediening in GTK3-toepassingen. GTK3-apps kunnen niet native "
"hovereffecten op alle drie de vensterbedieningstoetsen tegelijk tonen en "
"hebben daarom deze bibliotheek nodig om het gewenste gedrag te bereiken.\n"
"\n"
"Deze binaire code kan niet via het GNOME Extensions-platform worden "
"verspreid vanwege beveiligingsbeleid voor native bibliotheken, maar "
"handmatige installatie is mogelijk."

#: prefs.js:874
msgid "Installation Guide on GitHub"
msgstr "Installatiehandleiding op GitHub"

#: prefs.js:876
msgid "Open the advanced module build instructions"
msgstr "Open de bouwinstructies voor de geavanceerde module"

#: prefs.js:881
msgid "Even more..."
msgstr "Nog meer…"

#: prefs.js:885
msgid "AppManager"
msgstr ""

#: prefs.js:887
msgid "MacOS style AppImage installer and management application"
msgstr "MacOS-stijl AppImage-installatie- en beheertoepassing"

#: prefs.js:890
msgid "MacTahoe Icon Pack"
msgstr ""

#: prefs.js:892
msgid "macOS Tahoe icon theme for Linux"
msgstr "macOS Tahoe-pictogramthema voor Linux"

#: prefs.js:895
msgid "GDM Wallpaper"
msgstr ""

#: prefs.js:897
msgid "Set custom GDM login screen wallpaper"
msgstr "Aangepaste achtergrond voor GDM-aanmeldscherm instellen"

#: prefs.js:905
msgid "Recommended Extensions"
msgstr "Aanbevolen extensies"

#: prefs.js:906
msgid "Extensions that are compatible with Kiwi"
msgstr "Extensies die compatibel zijn met Kiwi"

