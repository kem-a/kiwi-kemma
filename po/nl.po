msgid "Fix white panel on some themes (e.g., Ubuntu Yaru)"
msgstr "Los het witte paneel op in sommige thema's (bijv. Ubuntu Yaru)"

#: prefs.js:411
msgid "Invert Tray Icons on Light Wallpapers"
msgstr "Systeemvakpictogrammen omkeren bij lichte achtergronden"

#: prefs.js:412
msgid ""
"Darken white monochrome tray icons when the panel adapts to a light "
"wallpaper. Colored icons are left untouched"
msgstr ""
"Witte monochrome systeemvakpictogrammen donkerder maken wanneer het paneel "
"zich aanpast aan een lichte achtergrond. Pictogrammen in kleur blijven "
"ongewijzigd"

#: prefs.js:445
msgid "Panel Items"
msgstr "Paneelonderdelen"

#: prefs.js:446
msgid "Choose what the top panel and its menus show"
msgstr "Kies wat de bovenbalk en zijn menu's tonen"

#: prefs.js:453
msgid "Show Window Title"
msgstr "Toon venstertitel"

#: prefs.js:454
msgid "Display current window title in the top panel"
msgstr "Toon de huidige venstertitel in het bovenpaneel"

#: prefs.js:463
msgid "Hide App Icon"
msgstr "Toepassingspictogram verbergen"

#: prefs.js:464
msgid "Do not show the application icon next to the window title"
msgstr "Het toepassingspictogram niet naast de venstertitel weergeven"

#: prefs.js:471
msgid "Disable Window Tiling"
msgstr "Venstertegels uitschakelen"

#: prefs.js:472
msgid ""
"Drop the tiling layouts from the window title menu, and stop restoring tiled "
"windows when their titlebar is dragged"
msgstr ""
"Verwijder de tegelindelingen uit het venstertitelmenu en herstel getegelde "
"vensters niet meer wanneer hun titelbalk wordt versleept"

#: prefs.js:492
msgid "Show Panel in Fullscreen on Hover"
msgstr "Paneel in volledig scherm weergeven bij aanwijzen"

#: prefs.js:492
msgid ""
"Show panel when mouse is near top edge in fullscreen. Bugged for GTK4 apps."
msgstr ""
"Toon het paneel wanneer de muis aan de bovenrand is in volledig scherm. Bugs "
"bij GTK4-apps."

#: prefs.js:500
msgid "Move Calendar to Right"
msgstr "Verplaats kalender naar rechts"

#: prefs.js:501
msgid "Move calendar to right side and hide notifications"
msgstr "Verplaats de kalender naar de rechterkant en verberg meldingen"

#: prefs.js:510
msgid "Keep GNOME Notification Panel"
msgstr "GNOME-meldingenpaneel behouden"

#: prefs.js:511
msgid "Don't split notification and calendar layout"
msgstr "Meldingen en agenda niet splitsen"

#: prefs.js:517
msgid "Indicator Style"
msgstr "Indicatorstijl"

#: prefs.js:518
