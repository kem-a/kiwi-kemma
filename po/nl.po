msgid "Panel"
msgstr "Paneel"

#: prefs.js:402 prefs.js:415
msgid "Panel Transparency"
msgstr "Paneeltransparantie"

#: prefs.js:403
msgid "Configure panel transparency and appearance"
msgstr "Configureer paneeltransparantie en uiterlijk"

#: prefs.js:416
msgid "Make the top panel transparent"
msgstr "Maak het bovenpaneel transparant"

#: prefs.js:423
msgid "Transparency Level"
msgstr "Transparantieniveau"

#: prefs.js:424
msgid "Set panel transparency (0-100)"
msgstr "Stel paneeltransparantie in (0–100)"

#: prefs.js:438
msgid "Opaque When Window Maximized"
msgstr "Ondoorzichtig bij gemaximaliseerd venster"

#: prefs.js:439
msgid "Make panel opaque when a maximized window touches it"
msgstr ""
"Paneel ondoorzichtig maken wanneer een gemaximaliseerd venster het raakt"

#: prefs.js:447
msgid "Panel Blur"
msgstr "Paneelvervaging"

#: prefs.js:448
msgid "Blur the background behind the panel"
msgstr "Achtergrond achter het paneel vervagen"

#: prefs.js:456
msgid "Panel Color Fix"
msgstr "Paneelkleur-correctie"

#: prefs.js:457
msgid "Fix white panel on some themes (e.g., Ubuntu Yaru)"
msgstr "Los het witte paneel op in sommige thema's (bijv. Ubuntu Yaru)"

#: prefs.js:464
msgid "Invert Tray Icons on Light Wallpapers"
msgstr "Systeemvakpictogrammen omkeren bij lichte achtergronden"

#: prefs.js:465
msgid ""
"Darken white monochrome tray icons when the panel adapts to a light "
"wallpaper. Colored icons are left untouched"
msgstr ""
"Witte monochrome systeemvakpictogrammen donkerder maken wanneer het paneel "
"zich aanpast aan een lichte achtergrond. Pictogrammen in kleur blijven "
"ongewijzigd"

#: prefs.js:498
msgid "Panel Items"
msgstr "Paneelonderdelen"

#: prefs.js:499
msgid "Choose what the top panel and its menus show"
msgstr "Kies wat de bovenbalk en zijn menu's tonen"

#: prefs.js:504
msgid "Show Panel in Fullscreen on Hover"
msgstr "Paneel in volledig scherm weergeven bij aanwijzen"

#: prefs.js:504
msgid ""
"Show panel when mouse is near top edge in fullscreen. Bugged for GTK4 apps."
msgstr ""
"Toon het paneel wanneer de muis aan de bovenrand is in volledig scherm. Bugs "
"bij GTK4-apps."

#: prefs.js:510
msgid "Show Window Title"
msgstr "Toon venstertitel"

#: prefs.js:511
msgid "Display current window title in the top panel"
msgstr "Toon de huidige venstertitel in het bovenpaneel"

#: prefs.js:520
msgid "Hide App Icon"
msgstr "Toepassingspictogram verbergen"

#: prefs.js:521
msgid "Do not show the application icon next to the window title"
msgstr "Het toepassingspictogram niet naast de venstertitel weergeven"

#: prefs.js:528
msgid "Hide Window Subtitle"
msgstr "Venstersubtitel verbergen"

#: prefs.js:529
msgid "Show only the application name, without the window's own title"
msgstr "Alleen de toepassingsnaam tonen, zonder de eigen titel van het venster"

#: prefs.js:536
msgid "Disable Window Tiling"
msgstr "Venstertegels uitschakelen"

#: prefs.js:537
msgid ""
"Drop the tiling layouts from the window title menu, and stop restoring tiled "
"windows when their titlebar is dragged"
msgstr ""
"Verwijder de tegelindelingen uit het venstertitelmenu en herstel getegelde "
"vensters niet meer wanneer hun titelbalk wordt versleept"

#: prefs.js:563
msgid "Move Calendar to Right"
msgstr "Verplaats kalender naar rechts"

#: prefs.js:564
msgid "Move calendar to right side and hide notifications"
msgstr "Verplaats de kalender naar de rechterkant en verberg meldingen"

#: prefs.js:573
msgid "Keep GNOME Notification Panel"
msgstr "GNOME-meldingenpaneel behouden"

#: prefs.js:574
msgid "Don't split notification and calendar layout"
msgstr "Meldingen en agenda niet splitsen"

#: prefs.js:581
msgid "Indicator Style"
msgstr "Indicatorstijl"

#: prefs.js:582
msgid "Notification dot recolor"
msgstr "Kleur van meldingsstip"

#: prefs.js:585 prefs.js:899
msgid "Default"
msgstr "Standaard"

#: prefs.js:585
msgid "Accent"
msgstr "Accent"

#: prefs.js:585
msgid "Symbolic"
msgstr "Symbolisch"

#: prefs.js:592
msgid "Battery Percentage"
msgstr "Batterijpercentage"

#: prefs.js:604
msgid ""
"Unavailable while GNOME Settings shows the battery percentage in the top bar"
msgstr ""
"Niet beschikbaar zolang GNOME-instellingen het batterijpercentage in de "
"bovenbalk weergeeft"

#: prefs.js:605
msgid "Show battery percentage in the top bar when below 20%"
msgstr "Toon batterijpercentage in de bovenbalk wanneer deze onder 20% komt"

#: prefs.js:611
msgid "Caps Lock and Num Lock"
msgstr "Caps Lock en Num Lock"

#: prefs.js:611
msgid "Show Caps Lock and Num Lock icon"
msgstr "Toon Caps Lock- en Num Lock-pictogram"

#: prefs.js:612
msgid "Custom Do Not Disturb Button"
msgstr "Aangepaste Niet storen-knop"

#: prefs.js:612
msgid ""
"Replace the system Do Not Disturb button with Kiwi's custom implementation"
msgstr ""
"Vervangt de systeemknop Niet storen door de aangepaste implementatie van Kiwi"

#: prefs.js:613
msgid "Hide Activities Button"
msgstr "Activiteitenknop verbergen"

#: prefs.js:613
msgid "Hide the Activities button in the top panel"
msgstr "Verberg de activiteitenknop in het bovenpaneel"

#: prefs.js:614
msgid "Add Username"
msgstr "Gebruikersnaam toevoegen"

#: prefs.js:614
msgid "Add username to the quick menu"
msgstr "Voeg gebruikersnaam toe aan het snelmenu"

#: prefs.js:618 prefs.js:828
msgid "Styling"
msgstr "Stijl"

#: prefs.js:619
msgid ""
"Restyle stock GNOME Shell elements and GTK apps. Log out and back in for "
"changes to take effect"
msgstr ""
"Standaardonderdelen van GNOME Shell en GTK-toepassingen een andere stijl "
"geven. Meld je af en weer aan om de wijzigingen toe te passen"

#: prefs.js:624
msgid "Panel Styling"
msgstr "Paneelstijl"

#: prefs.js:624
msgid ""
"Tighter button spacing, smaller status icons, no dropdown arrows and a "
"transparent panel in the overview"
msgstr ""
"Kleinere knopafstand, kleinere statuspictogrammen, geen uitklappijlen en een "
"transparant paneel in het overzicht"

#: prefs.js:625
msgid "Menu and App Styling"
msgstr "Menu- en toepassingsstijl"

#: prefs.js:625
msgid ""
"Narrower shell menu items with accent-colored hover and selection, plus the "
"GTK app fixes"
msgstr ""
"Smallere shell-menu-items met accentkleur bij aanwijzen en selecteren, plus "
"de GTK-verbeteringen"

#: prefs.js:631
msgid "Style Keyboard Indicator"
msgstr "Toetsenbordindicator stijlen"

#: prefs.js:632
msgid ""
"Slightly style keyboard/input source indicator by converting to uppercase and"
" adding border"
msgstr ""
"Stijl de toetsenbord-/invoerbronindicator licht door naar hoofdletters om te "
"zetten en een rand toe te voegen"

#: prefs.js:639
msgid "Hide keyboard indicator"
msgstr "Toetsenbordindicator verbergen"

#: prefs.js:640
msgid "Completely hide the indicator from the panel"
msgstr "Verberg de indicator volledig uit het paneel"

#: prefs.js:668
msgid "Dock"
msgstr "Dock"

#: prefs.js:677
msgid "These options need the Dash to Dock extension installed and enabled"
msgstr ""
"Voor deze opties moet de uitbreiding Dash to Dock geïnstalleerd en "
"ingeschakeld zijn"

#: prefs.js:685
msgid "Dock Items"
msgstr "Dockonderdelen"

#: prefs.js:686
msgid "Add extra items to Dash-to-Dock"
msgstr "Extra onderdelen toevoegen aan Dash-to-Dock"

#: prefs.js:691
msgid "Minimize Windows to Dock"
msgstr "Vensters minimaliseren naar het dock"

#: prefs.js:691
msgid ""
"Park minimized windows as thumbnails in Dash-to-Dock, after the apps and "
"before the trash"
msgstr ""
"Geminimaliseerde vensters als miniaturen in Dash-to-Dock plaatsen, na de "
"toepassingen en voor de prullenbak"

#: prefs.js:695
msgid "Downloads Folder in Dock"
msgstr "Downloadsmap in het dock"

#: prefs.js:696
msgid ""
"Add a Downloads folder before the trash that fans its newest files out over "
"the desktop"
msgstr ""
"Een downloadsmap voor de prullenbak toevoegen die de nieuwste bestanden over "
"het bureaublad uitspreidt"

#: prefs.js:705
msgid "Stack Behind Folder"
msgstr "Achter de map stapelen"

#: prefs.js:706
msgid ""
"Show the newest files sticking out of the folder icon instead of piled on top"
" of it"
msgstr ""
"De nieuwste bestanden achter het mappictogram laten uitsteken in plaats van "
"erop gestapeld"

#: prefs.js:724
msgid "Launchpad Application"
msgstr "Launchpad-app"

#: prefs.js:725
msgid ""
"Add custom Launchpad icon to dock that opens application overview. "
"Recommended to hide default app launcher."
msgstr ""
"Voeg een aangepast Launchpad-pictogram toe aan de dock dat het "
"toepassingsoverzicht opent. Aanbevolen om de standaardstarter te verbergen."

#: prefs.js:735
msgid "Custom Icon"
msgstr "Aangepast pictogram"

#: prefs.js:738 prefs.js:823
msgid "Using default icon"
msgstr "Standaardpictogram wordt gebruikt"

#: prefs.js:746
msgid "Reset to default icon"
msgstr "Standaardpictogram herstellen"

#: prefs.js:757
msgid "Browse for icon"
msgstr "Pictogram kiezen"

#: prefs.js:762
msgid "Select Launchpad Icon"
msgstr "Launchpad-pictogram kiezen"

#: prefs.js:766
msgid "Images (PNG, SVG)"
msgstr "Afbeeldingen (PNG, SVG)"

#: prefs.js:794
msgid "Icon Too Large"
msgstr "Pictogram is te groot"

#: prefs.js:795
msgid ""
"The selected image exceeds 512×512 pixels. Please choose a smaller image."
msgstr ""
"De geselecteerde afbeelding is groter dan 512×512 pixels. Kies een kleinere "
"afbeelding."

#: prefs.js:797
msgid "OK"
msgstr "OK"

#: prefs.js:833
msgid "Dock Styling"
msgstr "Dockstijl"

#: prefs.js:833
msgid ""
"Tighten icon spacing, drop the icon highlight and darken icons while pressed"
msgstr ""
"Pictogramafstand verkleinen, pictogrammarkering verwijderen en pictogrammen "
"donkerder maken bij indrukken"

#: prefs.js:834
msgid "Dock Blur"
msgstr "Dock-vervaging"

#: prefs.js:834
msgid ""
"Blur the background behind Dash-to-Dock. Recommended fixed dock opacity 10% -"
" 30%, min 1%."
msgstr ""
"Achtergrond achter Dash-to-Dock vervagen. Aanbevolen vaste dockdekking 10% – "
"30%, minimaal 1%."

#: prefs.js:835
msgid "Adaptive Dock Colors"
msgstr "Adaptieve dockkleuren"

#: prefs.js:835
msgid ""
"Flip the running indicators and separators to suit whatever is behind the "
"dock, wallpaper or window"
msgstr ""
"Past indicatoren van actieve toepassingen en scheidingslijnen aan op wat er "
"achter het dock zit, achtergrond of venster"

#: prefs.js:858
msgid "Buttons"
msgstr "Knoppen"

#: prefs.js:864
msgid "Window Control Button Style"
msgstr "Stijl voor vensterbedieningsknoppen"

#: prefs.js:865
msgid ""
"Choose the window control button style. Log out to apply it across all apps."
msgstr ""
"Kies de stijl van de vensterbedieningsknoppen. Log uit om het overal toe te "
"passen."

#: prefs.js:873
msgid "Enable macOS Window Buttons"
msgstr "macOS-vensterknoppen inschakelen"

#: prefs.js:874
msgid "Replace window control buttons in application windows with macOS style"
msgstr "Vervang vensterknoppen in toepassingsvensters door macOS-stijl"

#: prefs.js:895
msgid "Button Type"
msgstr "Knoptype"

#: prefs.js:896
msgid "Choose the button icon set"
msgstr "Kies het pictogrammenpakket voor de knoppen"

#: prefs.js:899
msgid "Alternative"
msgstr "Alternatief"

#: prefs.js:899
msgid "Glass"
msgstr "Glas"

#: prefs.js:905
msgid "Button Size"
msgstr "Knopgrootte"

#: prefs.js:906
msgid "Choose button size"
msgstr "Kies knopgrootte"

#: prefs.js:909
msgid "Small"
msgstr "Klein"

#: prefs.js:909
msgid "Normal"
msgstr "Normaal"

#: prefs.js:915
msgid "Firefox Styling"
msgstr "Firefox-styling"

#: prefs.js:916
msgid ""
"Apply macOS window control styling for Firefox. Recommended to use with "
"vertical tabs."
msgstr ""
"Pas macOS-styling voor vensterbediening toe op Firefox. Aanbevolen met "
"verticale tabbladen."

#: prefs.js:924
msgid "Thunderbird Styling"
msgstr "Thunderbird-stijl"

#: prefs.js:925
msgid "Apply macOS window control styling for Thunderbird."
msgstr "Pas macOS-stijl voor vensterknoppen toe op Thunderbird."

#: prefs.js:949
msgid "Show Window Controls on Panel"
msgstr "Vensterbediening op paneel tonen"

#: prefs.js:950
msgid ""
"Display close, minimize, maximize buttons in the top panel when window is "
"maximized"
msgstr ""
"Toon sluiten-, minimaliseren- en maximaliserenknoppen in het bovenpaneel als "
"het venster gemaximaliseerd is"

#: prefs.js:964
msgid "Only when Fullscreen"
msgstr "Alleen bij volledig scherm"

#: prefs.js:965
msgid ""
"Hide titlebars and show panel controls only for fullscreen windows, not "
"maximized"
msgstr ""
"Titelbalken verbergen en paneelknoppen alleen weergeven bij vensters in "
"volledig scherm, niet gemaximaliseerd"

#: prefs.js:974
msgid "Options"
msgstr "Opties"

#: prefs.js:980
msgid "Kiwi"
msgstr "Kiwi"

#: prefs.js:981
msgid ""
"Kiwi is not like Apple, it's free open source project that brings macOS-like "
"feel for GNOME"
msgstr ""
"Kiwi is geen Apple; het is een vrij open-sourceproject dat GNOME een macOS-"
"achtig gevoel geeft"

#: prefs.js:986
msgid "Overview Wallpaper Blur"
msgstr "Overzichtsachtergrond vervagen"

#: prefs.js:986
msgid "Use blurred current wallpaper as overview background"
msgstr "De huidige achtergrond vervaagd gebruiken als overzichtsachtergrond"

#: prefs.js:987
msgid "Seamless Overview Zoom"
msgstr "Naadloze overzichtszoom"

#: prefs.js:987
msgid ""
"Zoom the whole desktop, including the strip behind the panel, in and out of "
"the overview"
msgstr ""
"Het hele bureaublad, inclusief de strook achter het paneel, in- en uitzoomen "
"bij het openen en sluiten van het overzicht"

#: prefs.js:988
msgid "Focus on Overview Exit"
msgstr "Focus bij verlaten van overzicht"

#: prefs.js:988
msgid ""
"Focus the window under the cursor instead of the previously focused one when "
"leaving the overview"
msgstr ""
"Bij het verlaten van het overzicht het venster onder de cursor focussen in "
"plaats van het eerder gefocuste venster"

#: prefs.js:989
msgid "Skip to Desktop"
msgstr "Direct naar bureaublad"

#: prefs.js:989
msgid "Do not show the overview when logging in. Animation is still visible"
msgstr "Toon het overzicht niet bij het inloggen. Animatie blijft zichtbaar."

#: prefs.js:990
msgid "Hide Minimized Windows"
msgstr "Geminimaliseerde vensters verbergen"

#: prefs.js:990
msgid "Hide minimized windows in the overview"
msgstr "Verberg geminimaliseerde vensters in het overzicht"

#: prefs.js:991
msgid "Move Window to New Workspace"
msgstr "Verplaats venster naar nieuw werkblad"

#: prefs.js:991
msgid "Move fullscreen window to a new workspace"
msgstr "Verplaats een volledig schermvenster naar een nieuw werkblad"

#: prefs.js:992
msgid "Reduce App Animations"
msgstr "Toepassingsanimaties beperken"

#: prefs.js:992
msgid "Mimic macOS window opening and closing with a subtle scale and fade"
msgstr ""
"Het openen en sluiten van macOS-vensters nabootsen met een subtiele schaling "
"en fade"

#: prefs.js:993
msgid "Focus New Windows"
msgstr "Nieuwe vensters focussen"

#: prefs.js:993
msgid ""
"Automatically focus new windows instead of showing window-ready alerts. "
"Requires extension reload"
msgstr ""
"Nieuwe vensters automatisch focussen in plaats van meldingen te tonen dat een"
" venster gereed is. Vereist herladen van de uitbreiding"

#: prefs.js:994
msgid "Transparent Move"
msgstr "Transparant verplaatsen"

#: prefs.js:994
msgid "Move window with transparency"
msgstr "Verplaats venster met transparantie"

#: prefs.js:1001
msgid "Advanced"
msgstr "Geavanceerd"

#: prefs.js:1031
msgid "Titlebuttons Hover Effect for GTK3 apps"
msgstr "Zweefeffect voor titelknoppen in GTK3-apps"

#: prefs.js:1044
msgid ""
"The titlebuttons hover module provides macOS-like hover effects for window controls in GTK3 applications. GTK3 apps cannot natively show hover effects on all three window controls simultaneously, requiring this custom library to achieve the desired behavior.\n"
"\n"
"This binary code cannot be distributed through the GNOME Extensions platform due to security policies regarding native libraries, but manual installation is possible."
msgstr ""
"De titelknoppen-hovermodule biedt macOS-achtige effecten voor vensterbediening in GTK3-toepassingen. GTK3-apps kunnen niet native hovereffecten op alle drie de vensterbedieningstoetsen tegelijk tonen en hebben daarom deze bibliotheek nodig om het gewenste gedrag te bereiken.\n"
"\n"
"Deze binaire code kan niet via het GNOME Extensions-platform worden verspreid vanwege beveiligingsbeleid voor native bibliotheken, maar handmatige installatie is mogelijk."

#: prefs.js:1060
msgid "Installation Guide on GitHub"
msgstr "Installatiehandleiding op GitHub"

#: prefs.js:1062
msgid "Open the advanced module build instructions"
msgstr "Open de bouwinstructies voor de geavanceerde module"

#: prefs.js:1068
msgid "More of my work..."
msgstr "Meer van mijn werk…"

#: prefs.js:1072
msgid "Kiwi Menu"
msgstr "Kiwi Menu"

#: prefs.js:1072
msgid "MacOS style menu for GNOME"
msgstr "Menu in macOS-stijl voor GNOME"

#: prefs.js:1073
msgid "AppManager"
msgstr "AppManager"

#: prefs.js:1073
msgid "MacOS style AppImage installer and management application"
msgstr "MacOS-stijl AppImage-installatie- en beheertoepassing"

#: prefs.js:1074
msgid "Catalina Reloaded Icon Pack"
msgstr "Catalina Reloaded Icon Pack"

#: prefs.js:1074
msgid "macOS Tahoe icon theme for Linux"
msgstr "macOS Tahoe-pictogramthema voor Linux"

#: prefs.js:1075
msgid "GDM Wallpaper"
msgstr "GDM Wallpaper"

#: prefs.js:1075
msgid "Set custom GDM login screen wallpaper"
msgstr "Aangepaste achtergrond voor GDM-aanmeldscherm instellen"

#: prefs.js:1087
msgid "Other Recommended Extensions"
msgstr "Andere aanbevolen uitbreidingen"

#: prefs.js:1088
msgid "Extensions that are compatible with Kiwi"
msgstr "Extensies die compatibel zijn met Kiwi"

#: prefs.js:1112 prefs.js:1126
msgid "Restore Defaults"
