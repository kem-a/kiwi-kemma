#: prefs.js:367 prefs.js:380
msgid "Panel Transparency"
msgstr "Transparencia del panel"

#: prefs.js:368
msgid "Configure panel transparency and appearance"
msgstr "Configura la transparencia y apariencia del panel"

#: prefs.js:381
msgid "Make the top panel transparent"
msgstr "Hacer transparente el panel superior"

#: prefs.js:388
msgid "Transparency Level"
msgstr "Nivel de transparencia"

#: prefs.js:389
msgid "Set panel transparency (0-100)"
msgstr "Establece la transparencia del panel (0-100)"

#: prefs.js:403
msgid "Opaque When Window Touches"
msgstr "Opacar cuando una ventana toca el panel"

#: prefs.js:404
msgid "Make panel opaque when a window touches it"
msgstr "Vuelve opaco el panel cuando una ventana lo toca"

#: prefs.js:412
msgid "Panel Blur"
msgstr "Desenfoque del panel"

#: prefs.js:413
msgid "Blur the background behind the panel"
msgstr "Desenfocar el fondo detrás del panel"

#: prefs.js:421
msgid "Panel Color Fix"
msgstr "Corrección de color del panel"

#: prefs.js:422
msgid "Fix white panel on some themes (e.g., Ubuntu Yaru)"
msgstr "Corrige el panel blanco en algunos temas (por ejemplo, Ubuntu Yaru)"

#: prefs.js:429
msgid "Invert Tray Icons on Light Wallpapers"
msgstr "Invertir iconos de la bandeja con fondos claros"

#: prefs.js:430
msgid ""
"Darken white monochrome tray icons when the panel adapts to a light "
"wallpaper. Colored icons are left untouched"
msgstr ""
"Oscurecer los iconos monocromos blancos de la bandeja cuando el panel se "
"adapta a un fondo claro. Los iconos de color no se modifican"

#: prefs.js:463
msgid "Panel Items"
msgstr "Elementos del panel"

#: prefs.js:464
msgid "Choose what the top panel and its menus show"
msgstr "Elige qué muestran la barra superior y sus menús"

#: prefs.js:471
msgid "Show Window Title"
msgstr "Mostrar título de la ventana"

#: prefs.js:472
msgid "Display current window title in the top panel"
msgstr "Mostrar el título de la ventana actual en el panel superior"

#: prefs.js:481
msgid "Hide App Icon"
msgstr "Ocultar el icono de la aplicación"

#: prefs.js:482
msgid "Do not show the application icon next to the window title"
msgstr "No mostrar el icono de la aplicación junto al título de la ventana"

#: prefs.js:489
msgid "Disable Window Tiling"
msgstr "Desactivar el mosaico de ventanas"

#: prefs.js:490
msgid ""
"Drop the tiling layouts from the window title menu, and stop restoring tiled "
"windows when their titlebar is dragged"
msgstr ""
"Quitar las distribuciones en mosaico del menú del título de la ventana y "
"dejar de restaurar las ventanas en mosaico al arrastrar su barra de título"

#: prefs.js:510
msgid "Show Panel in Fullscreen on Hover"
msgstr "Mostrar el panel en pantalla completa al acercar el ratón"

#: prefs.js:510
msgid ""
"Show panel when mouse is near top edge in fullscreen. Bugged for GTK4 apps."
msgstr ""
"Mostrar el panel cuando el puntero esté cerca del borde superior en pantalla "
"completa. Presenta errores en aplicaciones GTK4."

#: prefs.js:518
msgid "Move Calendar to Right"
msgstr "Mover calendario a la derecha"

#: prefs.js:519
msgid "Move calendar to right side and hide notifications"
msgstr "Mover el calendario al lado derecho y ocultar las notificaciones"

#: prefs.js:528
msgid "Keep GNOME Notification Panel"
msgstr "Mantener el panel de notificaciones de GNOME"

#: prefs.js:529
msgid "Don't split notification and calendar layout"
msgstr "No separar la disposición de notificaciones y calendario"

#: prefs.js:536
msgid "Indicator Style"
msgstr "Estilo del indicador"

#: prefs.js:537
msgid "Notification dot recolor"
msgstr "Color del punto de notificación"

#: prefs.js:540 prefs.js:826
msgid "Default"
msgstr "Predeterminado"

#: prefs.js:540
msgid "Accent"
msgstr "Acento"

#: prefs.js:540
msgid "Symbolic"
msgstr "Simbólico"

#: prefs.js:547
msgid "Battery Percentage"
msgstr "Porcentaje de batería"

#: prefs.js:559
msgid ""
"Unavailable while GNOME Settings shows the battery percentage in the top bar"
msgstr ""
"No disponible mientras la Configuración de GNOME muestre el porcentaje de "
"batería en la barra superior"

#: prefs.js:560
msgid "Show battery percentage in the top bar when below 20%"
msgstr ""
"Mostrar el porcentaje de batería en la barra superior cuando esté por debajo "
"del 20 %"

#: prefs.js:566
msgid "Caps Lock and Num Lock"
msgstr "Bloq Mayús y Bloq Núm"

#: prefs.js:566
msgid "Show Caps Lock and Num Lock icon"
msgstr "Mostrar el icono de Bloq Mayús y Bloq Núm"

#: prefs.js:567
msgid "Custom Do Not Disturb Button"
msgstr "Botón personalizado No molestar"

#: prefs.js:567
msgid ""
"Replace the system Do Not Disturb button with Kiwi's custom implementation"
msgstr ""
"Reemplaza el botón No molestar del sistema por la implementación "
"personalizada de Kiwi"

#: prefs.js:568
msgid "Hide Activities Button"
msgstr "Ocultar botón de Actividades"

#: prefs.js:568
msgid "Hide the Activities button in the top panel"
msgstr "Oculta el botón de Actividades en el panel superior"

#: prefs.js:569
msgid "Add Username"
msgstr "Agregar nombre de usuario"

#: prefs.js:569
msgid "Add username to the quick menu"
msgstr "Añadir el nombre de usuario al menú rápido"

#: prefs.js:573 prefs.js:771
msgid "Styling"
msgstr "Estilo"

#: prefs.js:574
msgid ""
"Restyle stock GNOME Shell elements and GTK apps. Log out and back in for "
"changes to take effect"
msgstr ""
"Cambiar el estilo de los elementos originales de GNOME Shell y de las "
"aplicaciones GTK. Cierra la sesión y vuelve a entrar para aplicar los cambios"

#: prefs.js:579
msgid "Panel Styling"
msgstr "Estilo del panel"

#: prefs.js:579
msgid ""
"Tighter button spacing, bold titles, smaller status icons, no dropdown "
"arrows and a transparent panel in the overview"
msgstr ""
"Botones más juntos, títulos en negrita, iconos de estado más pequeños, sin "
"flechas desplegables y panel transparente en la vista general"

#: prefs.js:580
msgid "Menu and App Styling"
msgstr "Estilo de menús y aplicaciones"

#: prefs.js:580
msgid ""
"Narrower shell menu items with accent-colored hover and selection, plus the "
"GTK app fixes"
msgstr ""
"Elementos de menú más estrechos con color de acento al pasar el ratón y al "
"seleccionar, además de los ajustes para aplicaciones GTK"

#: prefs.js:586
msgid "Style Keyboard Indicator"
msgstr "Estilizar el indicador de teclado"

#: prefs.js:587
msgid ""
"Slightly style keyboard/input source indicator by converting to uppercase "
"and adding border"
msgstr ""
"Estiliza ligeramente el indicador de teclado/origen de entrada "
"convirtiéndolo en mayúsculas y añadiendo un borde"

#: prefs.js:594
msgid "Hide keyboard indicator"
msgstr "Ocultar indicador de teclado"

#: prefs.js:595
msgid "Completely hide the indicator from the panel"
msgstr "Ocultar por completo el indicador del panel"

#: prefs.js:623
msgid "Dock"
msgstr "Dock"

#: prefs.js:629
msgid "Dock Items"
msgstr "Elementos del dock"

#: prefs.js:630
msgid "Add extra items to Dash-to-Dock"
msgstr "Añadir elementos adicionales a Dash-to-Dock"

#: prefs.js:635
msgid "Minimize Windows to Dock"
msgstr "Minimizar ventanas al dock"

#: prefs.js:635
msgid ""
"Park minimized windows as thumbnails in Dash-to-Dock, after the apps and "
"before the trash"
msgstr ""
"Colocar las ventanas minimizadas como miniaturas en Dash-to-Dock, después de "
"las aplicaciones y antes de la papelera"

#: prefs.js:639
msgid "Downloads Folder in Dock"
msgstr "Carpeta de descargas en el dock"

#: prefs.js:640
msgid ""
"Add a Downloads folder before the trash that fans its newest files out over "
"the desktop"
msgstr ""
"Añadir una carpeta de descargas antes de la papelera que despliega sus "
"archivos más recientes sobre el escritorio"

#: prefs.js:648
msgid "Stack Behind Folder"
msgstr "Apilar detrás de la carpeta"

#: prefs.js:649
msgid ""
"Show the newest files sticking out of the folder icon instead of piled on "
"top of it"
msgstr ""
"Mostrar los archivos más recientes sobresaliendo del icono de la carpeta en "
"lugar de apilados sobre él"

#: prefs.js:667
msgid "Launchpad Application"
msgstr "Aplicación Launchpad"

#: prefs.js:668
msgid ""
"Add custom Launchpad icon to dock that opens application overview. "
"Recommended to hide default app launcher."
msgstr ""
"Añadir un icono de Launchpad personalizado al dock que abra la vista de "
"aplicaciones. Se recomienda ocultar el lanzador predeterminado."

#: prefs.js:678
msgid "Custom Icon"
msgstr "Icono personalizado"

#: prefs.js:681 prefs.js:766
msgid "Using default icon"
msgstr "Usando el icono predeterminado"

#: prefs.js:689
msgid "Reset to default icon"
msgstr "Restablecer al icono predeterminado"

#: prefs.js:700
msgid "Browse for icon"
msgstr "Buscar icono"

#: prefs.js:705
msgid "Select Launchpad Icon"
msgstr "Seleccionar icono de Launchpad"

#: prefs.js:709
msgid "Images (PNG, SVG)"
msgstr "Imágenes (PNG, SVG)"

#: prefs.js:737
msgid "Icon Too Large"
msgstr "Icono demasiado grande"

#: prefs.js:738
msgid ""
"The selected image exceeds 512×512 pixels. Please choose a smaller image."
msgstr ""
"La imagen seleccionada supera los 512×512 píxeles. Elige una imagen más "
"pequeña."

#: prefs.js:740
msgid "OK"
msgstr "Aceptar"

#: prefs.js:776
msgid "Dock Styling"
msgstr "Estilo del dock"

#: prefs.js:776
msgid ""
"Tighten icon spacing, drop the icon highlight and darken icons while pressed"
msgstr ""
"Reducir el espacio entre iconos, quitar el resaltado del icono y oscurecer "
"los iconos al pulsarlos"

#: prefs.js:777
msgid "Dock Blur"
msgstr "Desenfoque del dock"

#: prefs.js:777
msgid ""
"Blur the background behind Dash-to-Dock. Recommended fixed dock opacity 10% "
"- 30%, min 1%."
msgstr ""
"Desenfocar el fondo detrás de Dash-to-Dock. Opacidad fija del dock "
"recomendada del 10 % al 30 %, mínimo 1 %."

#: prefs.js:778
msgid "Adaptive Dock Colors"
msgstr "Colores adaptativos del dock"

#: prefs.js:778
msgid ""
"Flip the running indicators and separators to suit whatever is behind the "
"dock, wallpaper or window"
msgstr ""
"Invierte los indicadores de ejecución y los separadores según lo que haya "
"detrás del dock, el fondo de pantalla o una ventana"

#: prefs.js:785
msgid "Buttons"
msgstr "Botones"

#: prefs.js:791
msgid "Window Control Button Style"
msgstr "Estilo de botones de control de ventanas"

#: prefs.js:792
msgid ""
"Choose the window control button style. Log out to apply it across all apps."
msgstr ""
"Elige el estilo de los botones de control de ventanas. Cierra la sesión para "
"aplicarlo en todas las aplicaciones."

#: prefs.js:800
msgid "Enable macOS Window Buttons"
msgstr "Activar botones de ventana de macOS"

#: prefs.js:801
msgid "Replace window control buttons in application windows with macOS style"
msgstr ""
"Reemplazar los botones de control de ventana en las aplicaciones con estilo "
"macOS"

#: prefs.js:822
msgid "Button Type"
msgstr "Tipo de botón"

#: prefs.js:823
msgid "Choose the button icon set"
msgstr "Elige el conjunto de iconos de los botones"

#: prefs.js:826
msgid "Alternative"
msgstr "Alternativo"

#: prefs.js:832
msgid "Button Size"
msgstr "Tamaño del botón"

#: prefs.js:833
msgid "Choose button size"
msgstr "Elegir tamaño del botón"

#: prefs.js:836
msgid "Small"
msgstr "Pequeño"

#: prefs.js:836
msgid "Normal"
msgstr "Normal"

#: prefs.js:842
msgid "Firefox Styling"
msgstr "Estilo para Firefox"

#: prefs.js:843
msgid ""
"Apply macOS window control styling for Firefox. Recommended to use with "
"vertical tabs."
msgstr ""
"Aplicar el estilo de controles de macOS a Firefox. Se recomienda usarlo con "
"pestañas verticales."

#: prefs.js:851
msgid "Thunderbird Styling"
msgstr "Estilo para Thunderbird"

#: prefs.js:852
msgid "Apply macOS window control styling for Thunderbird."
msgstr "Aplicar estilo de controles de ventana de macOS a Thunderbird."

#: prefs.js:876
msgid "Show Window Controls on Panel"
msgstr "Mostrar controles de ventana en el panel"

#: prefs.js:877
msgid ""
"Display close, minimize, maximize buttons in the top panel when window is "
"maximized"
msgstr ""
"Mostrar los botones cerrar, minimizar y maximizar en el panel superior "
"cuando la ventana está maximizada"

#: prefs.js:891
msgid "Only when Fullscreen"
msgstr "Solo en pantalla completa"

#: prefs.js:892
msgid ""
"Hide titlebars and show panel controls only for fullscreen windows, not "
"maximized"
msgstr ""
"Ocultar las barras de título y mostrar los controles del panel solo en "
"ventanas a pantalla completa, no maximizadas"

#: prefs.js:901
msgid "Options"
msgstr "Opciones"

#: prefs.js:907
msgid "Kiwi"
msgstr "Kiwi"

#: prefs.js:908
msgid ""
"Kiwi is not like Apple, it's free open source project that brings macOS-like "
"feel for GNOME"
msgstr ""
"Kiwi no es como Apple; es un proyecto libre y de código abierto que aporta "
"una experiencia similar a macOS para GNOME"

#: prefs.js:913
msgid "Overview Wallpaper Blur"
msgstr "Desenfoque del fondo en la vista general"

#: prefs.js:913
msgid "Use blurred current wallpaper as overview background"
msgstr ""
"Usar el fondo de pantalla actual desenfocado como fondo de la vista general"

#: prefs.js:914
msgid "Skip to Desktop"
msgstr "Ir directamente al escritorio"

#: prefs.js:914
msgid "Do not show the overview when logging in. Animation is still visible"
msgstr ""
"No mostrar la vista general al iniciar sesión. La animación sigue siendo "
"visible."

#: prefs.js:915
msgid "Hide Minimized Windows"
msgstr "Ocultar ventanas minimizadas"

#: prefs.js:915
msgid "Hide minimized windows in the overview"
msgstr "Ocultar las ventanas minimizadas en la vista general"

#: prefs.js:916
msgid "Move Window to New Workspace"
msgstr "Mover ventana a un espacio de trabajo nuevo"

#: prefs.js:916
msgid "Move fullscreen window to a new workspace"
msgstr "Mover la ventana a pantalla completa a un espacio de trabajo nuevo"

#: prefs.js:917
msgid "Reduce App Animations"
msgstr "Reducir las animaciones de las aplicaciones"

#: prefs.js:917
msgid "Mimic macOS window opening and closing with a subtle scale and fade"
msgstr ""
"Imitar la apertura y el cierre de ventanas de macOS con un ligero escalado y "
"desvanecimiento"

#: prefs.js:918
msgid "Transparent Move"
msgstr "Movimiento transparente"

#: prefs.js:918
msgid "Move window with transparency"
msgstr "Mover la ventana con transparencia"

#: prefs.js:925
msgid "Advanced"
msgstr "Avanzado"

#: prefs.js:955
msgid "Titlebuttons Hover Effect for GTK3 apps"
msgstr "Efecto hover de los botones de ventana para aplicaciones GTK3"

#: prefs.js:968
msgid ""
"The titlebuttons hover module provides macOS-like hover effects for window "
"controls in GTK3 applications. GTK3 apps cannot natively show hover effects "
"on all three window controls simultaneously, requiring this custom library "
"to achieve the desired behavior.\n"
"\n"
"This binary code cannot be distributed through the GNOME Extensions platform "
"due to security policies regarding native libraries, but manual installation "
"is possible."
msgstr ""
"El módulo de efectos al pasar el cursor por los botones de ventana "
"proporciona efectos similares a macOS para los controles de GTK3. Las "
"aplicaciones GTK3 no pueden mostrar por sí mismas efectos hover en los tres "
"controles de ventana a la vez, por lo que se necesita esta biblioteca para "
"lograr el comportamiento deseado.\n"
"\n"
"Este código binario no puede distribuirse en la plataforma de Extensiones de "
"GNOME debido a las políticas de seguridad sobre bibliotecas nativas, pero es "
"posible instalarlo manualmente."

#: prefs.js:984
msgid "Installation Guide on GitHub"
msgstr "Guía de instalación en GitHub"

#: prefs.js:986
msgid "Open the advanced module build instructions"
msgstr "Abrir las instrucciones de compilación del módulo avanzado"

#: prefs.js:992
msgid "More of my work..."
msgstr "Más de mi trabajo…"

#: prefs.js:996
msgid "Kiwi Menu"
msgstr "Kiwi Menu"

#: prefs.js:996
msgid "MacOS style menu for GNOME"
msgstr "Menú estilo macOS para GNOME"

#: prefs.js:997
msgid "AppManager"
msgstr "AppManager"

#: prefs.js:997
msgid "MacOS style AppImage installer and management application"
msgstr "Aplicación de instalación y gestión de AppImage al estilo MacOS"

#: prefs.js:998
msgid "Catalina Reloaded Icon Pack"
msgstr "Catalina Reloaded Icon Pack"

#: prefs.js:998
msgid "macOS Tahoe icon theme for Linux"
msgstr "Tema de iconos macOS Tahoe para Linux"

#: prefs.js:999
msgid "GDM Wallpaper"
msgstr "GDM Wallpaper"

#: prefs.js:999
msgid "Set custom GDM login screen wallpaper"
msgstr "Establecer un fondo personalizado para la pantalla de inicio de GDM"

#: prefs.js:1011
msgid "Other Recommended Extensions"
msgstr "Otras extensiones recomendadas"

#: prefs.js:1012
msgid "Extensions that are compatible with Kiwi"
msgstr "Extensiones compatibles con Kiwi"

#: prefs.js:1036 prefs.js:1050
msgid "Restore Defaults"
msgstr "Restablecer valores predeterminados"

#: prefs.js:1040
msgid "Reset every Kiwi setting to its default value"
msgstr "Restablecer todos los ajustes de Kiwi a su valor predeterminado"

#: prefs.js:1046
msgid "Restore Default Settings?"
msgstr "¿Restablecer los ajustes predeterminados?"

#: prefs.js:1047
msgid ""
"Every Kiwi setting will be reset to its default value. This cannot be undone."
msgstr ""
"Todos los ajustes de Kiwi volverán a su valor predeterminado. Esto no se "
"puede deshacer."

