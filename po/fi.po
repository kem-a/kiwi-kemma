#: prefs.js:361
msgid "Panel"
msgstr "Paneeli"

#: prefs.js:367 prefs.js:380
msgid "Panel Transparency"
msgstr "Paneelin läpinäkyvyys"

#: prefs.js:368
msgid "Configure panel transparency and appearance"
msgstr "Säädä paneelin läpinäkyvyyttä ja ulkoasua"

#: prefs.js:381
msgid "Make the top panel transparent"
msgstr "Tee yläpaneelista läpinäkyvä"

#: prefs.js:388
msgid "Transparency Level"
msgstr "Läpinäkyvyyden taso"

#: prefs.js:389
msgid "Set panel transparency (0-100)"
msgstr "Aseta paneelin läpinäkyvyys (0–100)"

#: prefs.js:403
msgid "Opaque When Window Touches"
msgstr "Läpinäkymätön kun ikkuna koskettaa"

#: prefs.js:404
msgid "Make panel opaque when a window touches it"
msgstr "Muuta paneeli läpinäkymättömäksi, kun ikkuna koskettaa sitä"

#: prefs.js:412
msgid "Panel Blur"
msgstr "Paneelin sumennus"

#: prefs.js:413
msgid "Blur the background behind the panel"
msgstr "Sumenna paneelin tausta"

#: prefs.js:421
msgid "Panel Color Fix"
msgstr "Paneelin värikorjaus"

#: prefs.js:422
msgid "Fix white panel on some themes (e.g., Ubuntu Yaru)"
msgstr "Korjaa valkoinen paneeli joissakin teemoissa (esim. Ubuntu Yaru)"

#: prefs.js:429
msgid "Invert Tray Icons on Light Wallpapers"
msgstr "Käännä ilmoitusalueen kuvakkeet vaaleilla taustakuvilla"

#: prefs.js:430
msgid ""
"Darken white monochrome tray icons when the panel adapts to a light "
"wallpaper. Colored icons are left untouched"
msgstr ""
"Tummenna valkoiset yksiväriset ilmoitusalueen kuvakkeet, kun paneeli "
"mukautuu vaaleaan taustakuvaan. Värillisiä kuvakkeita ei muuteta"

#: prefs.js:463
msgid "Panel Items"
msgstr "Paneelin kohteet"

#: prefs.js:464
msgid "Choose what the top panel and its menus show"
msgstr "Valitse, mitä ylläpaneeli ja sen valikot näyttävät"

#: prefs.js:471
msgid "Show Window Title"
msgstr "Näytä ikkunan otsikko"

#: prefs.js:472
msgid "Display current window title in the top panel"
msgstr "Näytä nykyisen ikkunan otsikko yläpaneelissa"

#: prefs.js:481
msgid "Hide App Icon"
msgstr "Piilota sovelluskuvake"

#: prefs.js:482
msgid "Do not show the application icon next to the window title"
msgstr "Älä näytä sovelluksen kuvaketta ikkunan otsikon vieressä"

#: prefs.js:489
msgid "Disable Window Tiling"
msgstr "Poista ikkunoiden vierekkäisasettelu käytöstä"

#: prefs.js:490
msgid ""
"Drop the tiling layouts from the window title menu, and stop restoring tiled "
"windows when their titlebar is dragged"
msgstr ""
"Poista asettelut ikkunan otsikkovalikosta ja lopeta vierekkäin asetettujen "
"ikkunoiden palauttaminen otsikkopalkkia raahattaessa"

#: prefs.js:510
msgid "Show Panel in Fullscreen on Hover"
msgstr "Näytä paneeli koko näytön tilassa hiirtä lähennettäessä"

#: prefs.js:510
msgid ""
"Show panel when mouse is near top edge in fullscreen. Bugged for GTK4 apps."
msgstr ""
"Näytä paneeli, kun hiiri on lähellä yläreunaa koko näytön tilassa. GTK4-"
"sovelluksissa saattaa olla virheitä."

#: prefs.js:518
msgid "Move Calendar to Right"
msgstr "Siirrä kalenteri oikealle"

#: prefs.js:519
msgid "Move calendar to right side and hide notifications"
msgstr "Siirrä kalenteri oikealle ja piilota ilmoitukset"

#: prefs.js:528
msgid "Keep GNOME Notification Panel"
msgstr "Säilytä GNOMEn ilmoituspaneeli"

#: prefs.js:529
msgid "Don't split notification and calendar layout"
msgstr "Älä erottele ilmoitusten ja kalenterin asettelua"

#: prefs.js:536
msgid "Indicator Style"
msgstr "Ilmaisimen tyyli"

#: prefs.js:537
msgid "Notification dot recolor"
msgstr "Ilmoituspisteen väritys"

#: prefs.js:540 prefs.js:826
msgid "Default"
msgstr "Oletus"

#: prefs.js:540
msgid "Accent"
msgstr "Korostusväri"

#: prefs.js:540
msgid "Symbolic"
msgstr "Symbolinen"

#: prefs.js:547
msgid "Battery Percentage"
msgstr "Akun prosentti"

#: prefs.js:559
msgid ""
"Unavailable while GNOME Settings shows the battery percentage in the top bar"
msgstr ""
"Ei käytettävissä, kun GNOMEn asetukset näyttävät akun prosentit "
"ylläpaneelissa"

#: prefs.js:560
msgid "Show battery percentage in the top bar when below 20%"
msgstr "Näytä akun prosentti yläpalkissa, kun varausta on alle 20 %"

#: prefs.js:566
msgid "Caps Lock and Num Lock"
msgstr "Caps Lock ja Num Lock"

#: prefs.js:566
msgid "Show Caps Lock and Num Lock icon"
msgstr "Näytä Caps Lock- ja Num Lock -kuvake"

#: prefs.js:567
msgid "Custom Do Not Disturb Button"
msgstr "Mukautettu Älä häiritse -painike"

#: prefs.js:567
msgid ""
"Replace the system Do Not Disturb button with Kiwi's custom implementation"
msgstr ""
"Korvaa järjestelmän Älä häiritse -painikkeen Kiwin omalla toteutuksella"

#: prefs.js:568
msgid "Hide Activities Button"
msgstr "Piilota Aktiviteetit-painike"

#: prefs.js:568
msgid "Hide the Activities button in the top panel"
msgstr "Piilota Aktiviteetit-painike yläpalkista"

#: prefs.js:569
msgid "Add Username"
msgstr "Lisää käyttäjänimi"

#: prefs.js:569
msgid "Add username to the quick menu"
msgstr "Lisää käyttäjänimi pikavalikkoon"

#: prefs.js:573 prefs.js:771
msgid "Styling"
msgstr "Ulkoasu"

#: prefs.js:574
msgid ""
"Restyle stock GNOME Shell elements and GTK apps. Log out and back in for "
"changes to take effect"
msgstr ""
"Muotoile GNOME Shellin vakio-osat ja GTK-sovellukset uudelleen. Kirjaudu "
"ulos ja takaisin sisään, jotta muutokset tulevat voimaan"

#: prefs.js:579
msgid "Panel Styling"
msgstr "Paneelin ulkoasu"

#: prefs.js:579
msgid ""
"Tighter button spacing, bold titles, smaller status icons, no dropdown "
"arrows and a transparent panel in the overview"
msgstr ""
"Tiiviimmät painikevälit, lihavoidut otsikot, pienemmät tilakuvakkeet, ei "
"alasvetonuolia ja läpinäkyvä paneeli yleisnäkymässä"

#: prefs.js:580
msgid "Menu and App Styling"
msgstr "Valikoiden ja sovellusten ulkoasu"

#: prefs.js:580
msgid ""
"Narrower shell menu items with accent-colored hover and selection, plus the "
"GTK app fixes"
msgstr ""
"Kapeammat shell-valikon kohteet korostusvärillä osoitettaessa ja valittaessa "
"sekä GTK-sovelluskorjaukset"

#: prefs.js:586
msgid "Style Keyboard Indicator"
msgstr "Tyylittele näppäimistöindikaattori"

#: prefs.js:587
msgid ""
"Slightly style keyboard/input source indicator by converting to uppercase "
"and adding border"
msgstr ""
"Tyylittele näppäimistö-/syöttölähdeindikaattoria muuttamalla se isoiksi "
"kirjaimiksi ja lisäämällä reunus"

#: prefs.js:594
msgid "Hide keyboard indicator"
msgstr "Piilota näppäimistöindikaattori"

#: prefs.js:595
msgid "Completely hide the indicator from the panel"
msgstr "Piilota indikaattori kokonaan paneelista"

#: prefs.js:623
msgid "Dock"
msgstr "Telakka"

#: prefs.js:629
msgid "Dock Items"
msgstr "Telakan kohteet"

#: prefs.js:630
msgid "Add extra items to Dash-to-Dock"
msgstr "Lisää kohteita Dash-to-Dockiin"

#: prefs.js:635
msgid "Minimize Windows to Dock"
msgstr "Pienennä ikkunat telakkaan"

#: prefs.js:635
msgid ""
"Park minimized windows as thumbnails in Dash-to-Dock, after the apps and "
"before the trash"
msgstr ""
"Aseta pienennetyt ikkunat pikkukuvina Dash-to-Dockiin sovellusten jälkeen ja "
"roskakorin eteen"

#: prefs.js:639
msgid "Downloads Folder in Dock"
msgstr "Lataukset-kansio telakassa"

#: prefs.js:640
msgid ""
"Add a Downloads folder before the trash that fans its newest files out over "
"the desktop"
msgstr ""
"Lisää roskakorin eteen Lataukset-kansio, joka levittää uusimmat tiedostonsa "
"työpöydälle"

#: prefs.js:648
msgid "Stack Behind Folder"
msgstr "Pinoa kansion taakse"

#: prefs.js:649
msgid ""
"Show the newest files sticking out of the folder icon instead of piled on "
"top of it"
msgstr ""
"Näytä uusimmat tiedostot kansiokuvakkeen takaa pilkistäen sen sijaan, että "
"ne olisivat pinossa sen päällä"

#: prefs.js:667
msgid "Launchpad Application"
msgstr "Launchpad-sovellus"

#: prefs.js:668
msgid ""
"Add custom Launchpad icon to dock that opens application overview. "
"Recommended to hide default app launcher."
msgstr ""
"Lisää telakkaan mukautettu Launchpad-kuvake, joka avaa sovellusnäkymän. "
"Suositellaan piilottamaan oletuslaukaisin."

#: prefs.js:678
msgid "Custom Icon"
msgstr "Mukautettu kuvake"

#: prefs.js:681 prefs.js:766
msgid "Using default icon"
msgstr "Käytetään oletuskuvaketta"

#: prefs.js:689
msgid "Reset to default icon"
msgstr "Palauta oletuskuvakkeeseen"

#: prefs.js:700
msgid "Browse for icon"
msgstr "Selaa kuvaketta"

#: prefs.js:705
msgid "Select Launchpad Icon"
msgstr "Valitse Launchpad-kuvake"

#: prefs.js:709
msgid "Images (PNG, SVG)"
msgstr "Kuvat (PNG, SVG)"

#: prefs.js:737
msgid "Icon Too Large"
msgstr "Kuvake on liian suuri"

#: prefs.js:738
msgid ""
"The selected image exceeds 512×512 pixels. Please choose a smaller image."
msgstr "Valittu kuva ylittää 512×512 kuvapistettä. Valitse pienempi kuva."

#: prefs.js:740
msgid "OK"
msgstr "OK"

#: prefs.js:776
msgid "Dock Styling"
msgstr "Telakan ulkoasu"

#: prefs.js:776
msgid ""
"Tighten icon spacing, drop the icon highlight and darken icons while pressed"
msgstr ""
"Tiivistä kuvakevälit, poista kuvakkeen korostus ja tummenna kuvakkeet "
"painettaessa"

#: prefs.js:777
msgid "Dock Blur"
msgstr "Telakan sumennus"

#: prefs.js:777
msgid ""
"Blur the background behind Dash-to-Dock. Recommended fixed dock opacity 10% "
"- 30%, min 1%."
msgstr ""
"Sumenna Dash-to-Dockin tausta. Suositeltu kiinteä telakan peittävyys 10–30 "
"%, vähintään 1 %."

#: prefs.js:778
msgid "Adaptive Dock Colors"
msgstr "Mukautuvat telakan värit"

#: prefs.js:778
msgid ""
"Flip the running indicators and separators to suit whatever is behind the "
"dock, wallpaper or window"
msgstr ""
"Vaihda käynnissä olevien sovellusten ilmaisimet ja erottimet sen mukaan, "
"mitä telakan takana on, taustakuva tai ikkuna"

#: prefs.js:785
msgid "Buttons"
msgstr "Painikkeet"

#: prefs.js:791
msgid "Window Control Button Style"
msgstr "Ikkunanohjauspainikkeiden tyyli"

#: prefs.js:792
msgid ""
"Choose the window control button style. Log out to apply it across all apps."
msgstr ""
"Valitse ikkunanohjauspainikkeiden tyyli. Kirjaudu ulos ottaaksesi sen "
"käyttöön kaikissa sovelluksissa."

#: prefs.js:800
msgid "Enable macOS Window Buttons"
msgstr "Ota macOS-ikkunapainikkeet käyttöön"

#: prefs.js:801
msgid "Replace window control buttons in application windows with macOS style"
msgstr "Korvaa sovellusikkunoiden ikkunanhallintapainikkeet macOS-tyylillä"

#: prefs.js:822
msgid "Button Type"
msgstr "Painikkeen tyyppi"

#: prefs.js:823
msgid "Choose the button icon set"
msgstr "Valitse painikkeiden kuvakejoukko"

#: prefs.js:826
msgid "Alternative"
msgstr "Vaihtoehtoinen"

#: prefs.js:832
msgid "Button Size"
msgstr "Painikkeen koko"

#: prefs.js:833
msgid "Choose button size"
msgstr "Valitse painikkeen koko"

#: prefs.js:836
msgid "Small"
msgstr "Pieni"

#: prefs.js:836
msgid "Normal"
msgstr "Normaali"

#: prefs.js:842
msgid "Firefox Styling"
msgstr "Firefoxin tyyli"

#: prefs.js:843
msgid ""
"Apply macOS window control styling for Firefox. Recommended to use with "
"vertical tabs."
msgstr ""
"Käytä macOS-ikkunapainikkeiden tyyliä Firefoxissa. Suositeltavaa käyttää "
"pystysuorien välilehtien kanssa."

#: prefs.js:851
msgid "Thunderbird Styling"
msgstr "Thunderbird-tyyli"

#: prefs.js:852
msgid "Apply macOS window control styling for Thunderbird."
msgstr "Käytä macOS-ikkunanhallintapainikkeiden tyyliä Thunderbirdissä."

#: prefs.js:876
msgid "Show Window Controls on Panel"
msgstr "Näytä ikkunanohjaimet paneelissa"

#: prefs.js:877
msgid ""
"Display close, minimize, maximize buttons in the top panel when window is "
"maximized"
msgstr ""
"Näytä sulkemis-, pienennys- ja suurennuspainikkeet yläpaneelissa, kun ikkuna "
"on suurennettu"

#: prefs.js:891
msgid "Only when Fullscreen"
msgstr "Vain koko näytön tilassa"

#: prefs.js:892
msgid ""
"Hide titlebars and show panel controls only for fullscreen windows, not "
"maximized"
msgstr ""
"Piilota otsikkopalkit ja näytä paneelin painikkeet vain koko näytön "
"ikkunoille, ei suurennetuille"

#: prefs.js:901
msgid "Options"
msgstr "Asetukset"

#: prefs.js:907
msgid "Kiwi"
msgstr "Kiwi"

#: prefs.js:908
msgid ""
"Kiwi is not like Apple, it's free open source project that brings macOS-like "
"feel for GNOME"
msgstr ""
"Kiwi ei ole Apple; se on vapaa avoimen lähdekoodin projekti, joka tuo "
"GNOMEen macOS-tyylisen tuntuman"

#: prefs.js:913
msgid "Overview Wallpaper Blur"
msgstr "Yleisnäkymän taustan sumennus"

#: prefs.js:913
msgid "Use blurred current wallpaper as overview background"
msgstr "Käytä sumennettua nykyistä taustakuvaa yleisnäkymän taustana"

#: prefs.js:914
msgid "Skip to Desktop"
msgstr "Siirry suoraan työpöydälle"

#: prefs.js:914
msgid "Do not show the overview when logging in. Animation is still visible"
msgstr "Älä näytä yleisnäkymää kirjautuessa sisään. Animaatio näkyy silti."

#: prefs.js:915
msgid "Hide Minimized Windows"
msgstr "Piilota pienennetyt ikkunat"

#: prefs.js:915
msgid "Hide minimized windows in the overview"
msgstr "Piilota pienennetyt ikkunat yleisnäkymässä"

#: prefs.js:916
msgid "Move Window to New Workspace"
msgstr "Siirrä ikkuna uuteen työtilaan"

#: prefs.js:916
msgid "Move fullscreen window to a new workspace"
msgstr "Siirrä koko näytön ikkuna uuteen työtilaan"

#: prefs.js:917
msgid "Reduce App Animations"
msgstr "Vähennä sovellusanimaatioita"

#: prefs.js:917
msgid "Mimic macOS window opening and closing with a subtle scale and fade"
msgstr ""
"Jäljittele macOSin ikkunoiden avautumista ja sulkeutumista hienovaraisella "
"skaalauksella ja häivytyksellä"

#: prefs.js:918
msgid "Transparent Move"
msgstr "Läpinäkyvä siirto"

#: prefs.js:918
msgid "Move window with transparency"
msgstr "Siirrä ikkunaa läpinäkyvyydellä"

#: prefs.js:925
msgid "Advanced"
msgstr "Lisäasetukset"

#: prefs.js:955
msgid "Titlebuttons Hover Effect for GTK3 apps"
msgstr "GTK3-sovellusten otsikkopainikkeiden hover-efekti"

#: prefs.js:968
msgid ""
"The titlebuttons hover module provides macOS-like hover effects for window "
"controls in GTK3 applications. GTK3 apps cannot natively show hover effects "
"on all three window controls simultaneously, requiring this custom library "
"to achieve the desired behavior.\n"
"\n"
"This binary code cannot be distributed through the GNOME Extensions platform "
"due to security policies regarding native libraries, but manual installation "
"is possible."
msgstr ""
"Otsikkopainikkeiden hover-moduuli tuo macOS-tyyliset hover-efektit GTK3-"
"sovellusten ikkunanhallintapainikkeisiin. GTK3-sovellukset eivät pysty "
"näyttämään hover-efektiä kaikissa kolmessa painikkeessa yhtä aikaa, joten "
"halutun toiminnan saavuttamiseksi tarvitaan tämä kirjasto.\n"
"\n"
"Tätä binaaria ei voi levittää GNOME-laajennusten alustalla natiivikirjastoja "
"koskevien turvallisuussääntöjen vuoksi, mutta manuaalinen asennus on "
"mahdollinen."

#: prefs.js:984
msgid "Installation Guide on GitHub"
msgstr "Asennusohje GitHubissa"

#: prefs.js:986
msgid "Open the advanced module build instructions"
msgstr "Avaa lisämoduulin käännösohjeet"

#: prefs.js:992
msgid "More of my work..."
msgstr "Lisää töitäni…"

#: prefs.js:996
msgid "Kiwi Menu"
msgstr "Kiwi Menu"

#: prefs.js:996
msgid "MacOS style menu for GNOME"
msgstr "macOS-tyylinen valikko GNOMElle"

#: prefs.js:997
msgid "AppManager"
msgstr "AppManager"

#: prefs.js:997
msgid "MacOS style AppImage installer and management application"
msgstr "MacOS-tyylinen AppImage-asennus- ja hallintasovellus"

#: prefs.js:998
msgid "Catalina Reloaded Icon Pack"
msgstr "Catalina Reloaded Icon Pack"

#: prefs.js:998
msgid "macOS Tahoe icon theme for Linux"
msgstr "macOS Tahoe -kuvaketeema Linuxille"

#: prefs.js:999
msgid "GDM Wallpaper"
msgstr "GDM Wallpaper"

#: prefs.js:999
msgid "Set custom GDM login screen wallpaper"
msgstr "Aseta mukautettu taustakuva GDM-kirjautumisruudulle"

#: prefs.js:1011
msgid "Other Recommended Extensions"
msgstr "Muut suositellut laajennukset"

#: prefs.js:1012
msgid "Extensions that are compatible with Kiwi"
msgstr "Kiwin kanssa yhteensopivat laajennukset"

#: prefs.js:1036 prefs.js:1050
msgid "Restore Defaults"
msgstr "Palauta oletukset"

#: prefs.js:1040
msgid "Reset every Kiwi setting to its default value"
msgstr "Palauta jokainen Kiwin asetus oletusarvoonsa"

#: prefs.js:1046
msgid "Restore Default Settings?"
msgstr "Palautetaanko oletusasetukset?"

