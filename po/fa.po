#: prefs.js:343
msgid "Panel"
msgstr "پنل"

#: prefs.js:349 prefs.js:362
msgid "Panel Transparency"
msgstr "شفافیت پنل"

#: prefs.js:350
msgid "Configure panel transparency and appearance"
msgstr "شفافیت و ظاهر پنل را پیکربندی کنید"

#: prefs.js:363
msgid "Make the top panel transparent"
msgstr "پنل بالایی را شفاف کن"

#: prefs.js:370
msgid "Transparency Level"
msgstr "سطح شفافیت"

#: prefs.js:371
msgid "Set panel transparency (0-100)"
msgstr "شفافیت پنل را بین ۰ تا ۱۰۰ تنظیم کنید"

#: prefs.js:385
msgid "Opaque When Window Touches"
msgstr "کدر شدن هنگام لمس پنجره"

#: prefs.js:386
msgid "Make panel opaque when a window touches it"
msgstr "وقتی پنجره به پنل می‌رسد آن را کدر کن"

#: prefs.js:394
msgid "Panel Blur"
msgstr "تاری پنل"

#: prefs.js:395
msgid "Blur the background behind the panel"
msgstr "تار کردن پس‌زمینهٔ پشت پنل"

#: prefs.js:403
msgid "Panel Color Fix"
msgstr "اصلاح رنگ پنل"

#: prefs.js:404
msgid "Fix white panel on some themes (e.g., Ubuntu Yaru)"
msgstr "رفع مشکل سفید شدن پنل در برخی پوسته‌ها (مثلاً Ubuntu Yaru)"

#: prefs.js:411
msgid "Invert Tray Icons on Light Wallpapers"
msgstr "وارونه‌سازی نمادهای سینی روی پس‌زمینه‌های روشن"

#: prefs.js:412
msgid ""
"Darken white monochrome tray icons when the panel adapts to a light "
"wallpaper. Colored icons are left untouched"
msgstr ""
"تیره کردن نمادهای تک‌رنگ سفید سینی هنگامی که پنل با پس‌زمینه روشن هم‌ساز "
"می‌شود. نمادهای رنگی بدون تغییر می‌مانند"

#: prefs.js:445
msgid "Panel Items"
msgstr "موارد پنل"

#: prefs.js:446
msgid "Choose what the top panel and its menus show"
msgstr "انتخاب آنچه نوار بالا و منوهایش نشان می‌دهند"

#: prefs.js:453
msgid "Show Window Title"
msgstr "نمایش عنوان پنجره"

#: prefs.js:454
msgid "Display current window title in the top panel"
msgstr "عنوان پنجرهٔ جاری را در پنل بالا نمایش بده"

#: prefs.js:463
msgid "Hide App Icon"
msgstr "پنهان کردن نماد برنامه"

#: prefs.js:464
msgid "Do not show the application icon next to the window title"
msgstr "نماد برنامه در کنار عنوان پنجره نشان داده نشود"

#: prefs.js:471
msgid "Disable Window Tiling"
msgstr "غیرفعال کردن کاشی‌بندی پنجره"

#: prefs.js:472
msgid ""
"Drop the tiling layouts from the window title menu, and stop restoring tiled "
"windows when their titlebar is dragged"
msgstr ""
"حذف چیدمان‌های کاشی‌بندی از منوی عنوان پنجره و توقف بازگردانی پنجره‌های "
"کاشی‌شده هنگام کشیدن نوار عنوان آن‌ها"

#: prefs.js:492
msgid "Show Panel in Fullscreen on Hover"
msgstr "نمایش پنل در تمام‌صفحه هنگام نزدیک شدن اشاره‌گر"

#: prefs.js:492
msgid ""
"Show panel when mouse is near top edge in fullscreen. Bugged for GTK4 apps."
msgstr ""
"در حالت تمام‌صفحه وقتی ماوس نزدیک لبهٔ بالا است پنل را نشان بده. در "
"برنامه‌های GTK4 مشکل‌دار است."

#: prefs.js:500
msgid "Move Calendar to Right"
msgstr "انتقال تقویم به راست"

#: prefs.js:501
msgid "Move calendar to right side and hide notifications"
msgstr "تقویم را به سمت راست منتقل کن و اعلان‌ها را پنهان کن"

#: prefs.js:510
msgid "Keep GNOME Notification Panel"
msgstr "نگه داشتن پنل اعلان گنوم"

#: prefs.js:511
msgid "Don't split notification and calendar layout"
msgstr "اعلان‌ها و تقویم را از هم جدا نکن"

#: prefs.js:517
msgid "Indicator Style"
msgstr "سبک نشانگر"

#: prefs.js:518
msgid "Notification dot recolor"
msgstr "تغییر رنگ نقطهٔ اعلان"

#: prefs.js:529 prefs.js:842
msgid "Default"
msgstr "پیش‌فرض"

#: prefs.js:533
msgid "Accent"
msgstr "تأکیدی"

#: prefs.js:537
msgid "Symbolic"
msgstr "نمادین"

#: prefs.js:556
msgid "Battery Percentage"
msgstr "درصد باتری"

#: prefs.js:568
msgid ""
"Unavailable while GNOME Settings shows the battery percentage in the top bar"
msgstr ""
"تا زمانی که تنظیمات گنوم درصد باتری را در نوار بالا نشان می‌دهد، در دسترس "
"نیست"

#: prefs.js:569
msgid "Show battery percentage in the top bar when below 20%"
msgstr "در صورت کمتر از ۲۰٪ بودن، درصد باتری را در نوار بالا نشان بده"

#: prefs.js:575
msgid "Caps Lock and Num Lock"
msgstr "Caps Lock و Num Lock"

#: prefs.js:575
msgid "Show Caps Lock and Num Lock icon"
msgstr "آیکون‌های Caps Lock و Num Lock را نمایش بده"

#: prefs.js:576
msgid "Custom Do Not Disturb Button"
msgstr "دکمه سفارشی عدم مزاحمت"

#: prefs.js:576
msgid ""
"Replace the system Do Not Disturb button with Kiwi's custom implementation"
msgstr ""
"دکمه پیش‌فرض عدم مزاحمت سیستم را با پیاده‌سازی سفارشی Kiwi جایگزین می‌کند"

#: prefs.js:577
msgid "Hide Activities Button"
msgstr "پنهان کردن دکمهٔ فعالیت‌ها"

#: prefs.js:577
msgid "Hide the Activities button in the top panel"
msgstr "دکمهٔ فعالیت‌ها را در پنل بالا پنهان کن"

#: prefs.js:578
msgid "Add Username"
msgstr "افزودن نام کاربری"

#: prefs.js:578
msgid "Add username to the quick menu"
msgstr "نام کاربری را به منوی سریع اضافه کن"

#: prefs.js:582 prefs.js:780
msgid "Styling"
msgstr "ظاهر"

#: prefs.js:583
msgid ""
"Restyle stock GNOME Shell elements and GTK apps. Log out and back in for "
"changes to take effect"
msgstr ""
"تغییر ظاهر عناصر پیش‌فرض گنوم شل و برنامه‌های GTK. برای اعمال تغییرات خارج و "
"دوباره وارد شوید"

#: prefs.js:588
msgid "Panel Styling"
msgstr "ظاهر پنل"

#: prefs.js:588
msgid ""
"Tighter button spacing, bold titles, smaller status icons, no dropdown arrows"
" and a transparent panel in the overview"
msgstr ""
"فاصله کمتر دکمه‌ها، عنوان‌های توپر، نمادهای وضعیت کوچک‌تر، بدون فلش‌های بازشو"
" و پنل شفاف در نمای کلی"

#: prefs.js:589
msgid "Menu and App Styling"
msgstr "ظاهر منو و برنامه"

#: prefs.js:589
msgid ""
"Narrower shell menu items with accent-colored hover and selection, plus the "
"GTK app fixes"
msgstr ""
"موارد منوی شل باریک‌تر با رنگ تأکیدی هنگام اشاره و گزینش، همراه با اصلاحات "
"برنامه‌های GTK"

#: prefs.js:595
msgid "Style Keyboard Indicator"
msgstr "استایل‌دهی به نشانگر صفحه‌کلید"

#: prefs.js:596
msgid ""
"Slightly style keyboard/input source indicator by converting to uppercase and"
" adding border"
msgstr ""
"نشانگر صفحه‌کلید/منبع ورودی را با تبدیل به حروف بزرگ و افزودن حاشیه کمی مرتب "
"کن"

#: prefs.js:603
msgid "Hide keyboard indicator"
msgstr "نشانگر صفحه‌کلید را پنهان کن"

#: prefs.js:604
msgid "Completely hide the indicator from the panel"
msgstr "نشانگر را به طور کامل از پنل پنهان کن"

#: prefs.js:632
msgid "Dock"
msgstr "داک"

#: prefs.js:638
msgid "Dock Items"
msgstr "موارد داک"

#: prefs.js:639
msgid "Add extra items to Dash-to-Dock"
msgstr "افزودن موارد بیشتر به Dash-to-Dock"

#: prefs.js:644
msgid "Minimize Windows to Dock"
msgstr "کوچک کردن پنجره‌ها به داک"

#: prefs.js:644
msgid ""
"Park minimized windows as thumbnails in Dash-to-Dock, after the apps and "
"before the trash"
msgstr ""
"قرار دادن پنجره‌های کوچک‌شده به‌صورت بندانگشتی در Dash-to-Dock، پس از "
"برنامه‌ها و پیش از زباله‌دان"

#: prefs.js:648
msgid "Downloads Folder in Dock"
msgstr "پوشه بارگیری‌ها در داک"

#: prefs.js:649
msgid ""
"Add a Downloads folder before the trash that fans its newest files out over "
"the desktop"
msgstr ""
"افزودن پوشه بارگیری‌ها پیش از زباله‌دان که تازه‌ترین پرونده‌هایش را روی "
"میزکار پخش می‌کند"

#: prefs.js:657
msgid "Stack Behind Folder"
msgstr "چیدن پشت پوشه"

#: prefs.js:658
msgid ""
"Show the newest files sticking out of the folder icon instead of piled on top"
" of it"
msgstr ""
"نمایش تازه‌ترین پرونده‌ها بیرون‌آمده از پشت نماد پوشه، به‌جای انباشته روی آن"

#: prefs.js:676
msgid "Launchpad Application"
msgstr "برنامهٔ لانچ‌پد"

#: prefs.js:677
msgid ""
"Add custom Launchpad icon to dock that opens application overview. "
"Recommended to hide default app launcher."
msgstr ""
"یک آیکون سفارشی لانچ‌پد به داک اضافه کن که نمای برنامه‌ها را باز کند. توصیه "
"می‌شود لانچر پیش‌فرض پنهان شود."

#: prefs.js:687
msgid "Custom Icon"
msgstr "نماد سفارشی"

#: prefs.js:690 prefs.js:775
msgid "Using default icon"
msgstr "از نماد پیش‌فرض استفاده می‌شود"

#: prefs.js:698
msgid "Reset to default icon"
msgstr "بازنشانی به نماد پیش‌فرض"

#: prefs.js:709
msgid "Browse for icon"
msgstr "انتخاب نماد"

#: prefs.js:714
msgid "Select Launchpad Icon"
msgstr "انتخاب نماد لانچ‌پد"

#: prefs.js:718
msgid "Images (PNG, SVG)"
msgstr "تصاویر (PNG، SVG)"

#: prefs.js:746
msgid "Icon Too Large"
msgstr "نماد خیلی بزرگ است"

#: prefs.js:747
msgid ""
"The selected image exceeds 512×512 pixels. Please choose a smaller image."
msgstr ""
"تصویر انتخاب‌شده از ۵۱۲×۵۱۲ پیکسل بزرگ‌تر است. لطفاً تصویر کوچک‌تری انتخاب "
"کنید."

#: prefs.js:749
msgid "OK"
msgstr "تأیید"

#: prefs.js:785
msgid "Dock Styling"
msgstr "ظاهر داک"

#: prefs.js:785
msgid ""
"Tighten icon spacing, drop the icon highlight and darken icons while pressed"
msgstr ""
"کاهش فاصله نمادها، حذف برجسته‌سازی نماد و تیره کردن نمادها هنگام فشار دادن"

#: prefs.js:786
msgid "Dock Blur"
msgstr "تاری داک"

#: prefs.js:786
msgid "Blur the background behind Dash-to-Dock"
msgstr "تار کردن پس‌زمینهٔ پشت Dash-to-Dock"

#: prefs.js:793
msgid "Buttons"
msgstr "دکمه‌ها"

#: prefs.js:799
msgid "Window Control Button Style"
msgstr "سبک دکمه‌های کنترل پنجره"

#: prefs.js:800
msgid ""
"Choose the window control button style. Log out to apply it across all apps."
msgstr ""
"سبک دکمه‌های کنترل پنجره را انتخاب کنید. برای اعمال در همه برنامه‌ها خارج "
"شوید."

#: prefs.js:808
msgid "Enable macOS Window Buttons"
msgstr "فعال کردن دکمه‌های پنجرهٔ macOS"

#: prefs.js:809
msgid "Replace window control buttons in application windows with macOS style"
msgstr "جایگزینی دکمه‌های کنترل پنجره در برنامه‌ها با سبک macOS"

#: prefs.js:830
msgid "Button Type"
msgstr "نوع دکمه"

#: prefs.js:831
msgid "Choose the button icon set"
msgstr "مجموعهٔ آیکون دکمه‌ها را انتخاب کنید"

#: prefs.js:846
msgid "Alternative"
msgstr "جایگزین"

#: prefs.js:863
msgid "Button Size"
msgstr "اندازه دکمه"

#: prefs.js:864
msgid "Choose button size"
msgstr "انتخاب اندازه دکمه"

#: prefs.js:875
msgid "Small"
msgstr "کوچک"

#: prefs.js:879
msgid "Normal"
msgstr "معمولی"

#: prefs.js:896
msgid "Firefox Styling"
msgstr "استایل فایرفاکس"

#: prefs.js:897
msgid ""
"Apply macOS window control styling for Firefox. Recommended to use with "
"vertical tabs."
msgstr ""
"استایل کنترل‌های پنجرهٔ macOS را برای فایرفاکس اعمال کن. استفاده همراه "
"برگه‌های عمودی توصیه می‌شود."

#: prefs.js:905
msgid "Thunderbird Styling"
msgstr "سبک تاندربرد"

#: prefs.js:906
msgid "Apply macOS window control styling for Thunderbird."
msgstr "اعمال سبک کنترل پنجره macOS برای تاندربرد."

#: prefs.js:930
msgid "Show Window Controls on Panel"
msgstr "نمایش کنترل‌های پنجره روی پنل"

#: prefs.js:931
msgid ""
"Display close, minimize, maximize buttons in the top panel when window is "
"maximized"
msgstr ""
"نمایش دکمه‌های بستن، کوچک‌کردن و بزرگ‌کردن در پنل بالا هنگام بیشینه بودن "
"پنجره"

#: prefs.js:945
msgid "Only when Fullscreen"
msgstr "تنها در تمام‌صفحه"

#: prefs.js:946
msgid ""
"Hide titlebars and show panel controls only for fullscreen windows, not "
"maximized"
msgstr ""
"پنهان کردن نوارهای عنوان و نمایش واپایشگرهای پنل تنها برای پنجره‌های "
"تمام‌صفحه، نه بیشینه"

#: prefs.js:955
msgid "Options"
msgstr "ویژگی‌ها"

#: prefs.js:961
msgid "Kiwi"
msgstr "Kiwi"

#: prefs.js:962
msgid ""
"Kiwi is not like Apple, it's free open source project that brings macOS-like "
"feel for GNOME"
msgstr ""
"Kiwi مثل Apple نیست؛ یک پروژهٔ آزاد و متن‌باز است که حس macOS را به گنوم "
"می‌آورد"

#: prefs.js:967
msgid "Overview Wallpaper Blur"
msgstr "تاری پس‌زمینهٔ نمای کلی"

#: prefs.js:967
msgid "Use blurred current wallpaper as overview background"
msgstr "استفاده از پس‌زمینه کنونی محوشده به‌عنوان پس‌زمینه نمای کلی"

#: prefs.js:968
msgid "Skip to Desktop"
msgstr "پرش به دسکتاپ"

#: prefs.js:968
msgid "Do not show the overview when logging in. Animation is still visible"
msgstr "در هنگام ورود نمای کلی را نشان نده. انیمیشن همچنان دیده می‌شود."

#: prefs.js:969
