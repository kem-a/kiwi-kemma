#: prefs.js:331 prefs.js:338
msgid "Panel Transparency"
msgstr "شفافیت پنل"

#: prefs.js:332
msgid "Configure panel transparency and appearance"
msgstr "شفافیت و ظاهر پنل را پیکربندی کنید"

#: prefs.js:339
msgid "Make the top panel transparent"
msgstr "پنل بالایی را شفاف کن"

#: prefs.js:347
msgid "Transparency Level"
msgstr "سطح شفافیت"

#: prefs.js:348
msgid "Set panel transparency (0-100)"
msgstr "شفافیت پنل را بین ۰ تا ۱۰۰ تنظیم کنید"

#: prefs.js:362
msgid "Opaque When Window Touches"
msgstr "کدر شدن هنگام لمس پنجره"

#: prefs.js:363
msgid "Make panel opaque when a window touches it"
msgstr "وقتی پنجره به پنل می‌رسد آن را کدر کن"

#: prefs.js:371
msgid "Panel Blur"
msgstr "تاری پنل"

#: prefs.js:372
msgid "Blur the background behind the panel"
msgstr "تار کردن پس‌زمینهٔ پشت پنل"

#: prefs.js:380
msgid "Panel Color Fix"
msgstr "اصلاح رنگ پنل"

#: prefs.js:381
msgid "Fix white panel on some themes (e.g., Ubuntu Yaru)"
msgstr "رفع مشکل سفید شدن پنل در برخی پوسته‌ها (مثلاً Ubuntu Yaru)"

#: prefs.js:414
msgid "Move Window to New Workspace"
msgstr "جابه‌جایی پنجره به فضای کاری جدید"

#: prefs.js:414
msgid "Move fullscreen window to a new workspace"
msgstr "انتقال پنجره تمام‌صفحه به فضای کاری جدید"

#: prefs.js:415
msgid "Transparent Move"
msgstr "جابجایی شفاف"

#: prefs.js:415
msgid "Move window with transparency"
msgstr "جابجا کردن پنجره با شفافیت"

#: prefs.js:416
msgid "Battery Percentage"
msgstr "درصد باتری"

#: prefs.js:416
msgid "Show battery percentage in the top bar when below 20%"
msgstr "در صورت کمتر از ۲۰٪ بودن، درصد باتری را در نوار بالا نشان بده"

#: prefs.js:417
msgid "Move Calendar to Right"
msgstr "انتقال تقویم به راست"

#: prefs.js:417
msgid "Move calendar to right side and hide notifications"
msgstr "تقویم را به سمت راست منتقل کن و اعلان‌ها را پنهان کن"

#: prefs.js:418
msgid "Show Window Title"
msgstr "نمایش عنوان پنجره"

#: prefs.js:418
msgid "Display current window title in the top panel"
msgstr "عنوان پنجرهٔ جاری را در پنل بالا نمایش بده"

#: prefs.js:419
msgid "Show Panel on Hover"
msgstr "نمایش پنل هنگام قرار گرفتن ماوس"

#: prefs.js:419
msgid ""
"Show panel when mouse is near top edge in fullscreen. Bugged for GTK4 apps."
msgstr ""
"در حالت تمام‌صفحه وقتی ماوس نزدیک لبهٔ بالا است پنل را نشان بده. در برنامه‌های "
"GTK4 مشکل‌دار است."

#: prefs.js:420
msgid "Show Window Controls on Panel"
msgstr "نمایش کنترل‌های پنجره روی پنل"

#: prefs.js:420
msgid ""
"Display close, minimize, maximize buttons in the top panel when window is "
"maximized"
msgstr ""
"نمایش دکمه‌های بستن، کوچک‌کردن و بزرگ‌کردن در پنل بالا هنگام بیشینه بودن پنجره"

#: prefs.js:421
msgid "Overview Wallpaper Blur"
msgstr "تاری پس‌زمینهٔ نمای کلی"

#: prefs.js:421
msgid ""
"Use blurred current wallpaper as overview background (requires ImageMagick)"
msgstr ""
"از تصویر پس‌زمینهٔ فعلیِ تار شده به عنوان پس‌زمینهٔ نمای کلی استفاده کن (نیازمند "
"ImageMagick)"

#: prefs.js:422
msgid "Dock Blur"
msgstr "تاری داک"

#: prefs.js:422
msgid "Blur the background behind Dash-to-Dock"
msgstr "تار کردن پس‌زمینهٔ پشت Dash-to-Dock"

