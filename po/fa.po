#: prefs.js:396
msgid "Panel"
msgstr "پنل"

#: prefs.js:402 prefs.js:415
msgid "Panel Transparency"
msgstr "شفافیت پنل"

#: prefs.js:403
msgid "Configure panel transparency and appearance"
msgstr "شفافیت و ظاهر پنل را پیکربندی کنید"

#: prefs.js:416
msgid "Make the top panel transparent"
msgstr "پنل بالایی را شفاف کن"

#: prefs.js:423
msgid "Transparency Level"
msgstr "سطح شفافیت"

#: prefs.js:424
msgid "Set panel transparency (0-100)"
msgstr "شفافیت پنل را بین ۰ تا ۱۰۰ تنظیم کنید"

#: prefs.js:438
msgid "Opaque When Window Maximized"
msgstr "مات هنگام بیشینه بودن پنجره"

#: prefs.js:439
msgid "Make panel opaque when a maximized window touches it"
msgstr "پنل را هنگامی که یک پنجره بیشینه به آن می‌رسد مات کن"

#: prefs.js:447
msgid "Panel Blur"
msgstr "تاری پنل"

#: prefs.js:448
msgid "Blur the background behind the panel"
msgstr "تار کردن پس‌زمینهٔ پشت پنل"

#: prefs.js:456
msgid "Panel Color Fix"
msgstr "اصلاح رنگ پنل"

#: prefs.js:457
msgid "Fix white panel on some themes (e.g., Ubuntu Yaru)"
msgstr "رفع مشکل سفید شدن پنل در برخی پوسته‌ها (مثلاً Ubuntu Yaru)"

#: prefs.js:464
msgid "Invert Tray Icons on Light Wallpapers"
msgstr "وارونه‌سازی نمادهای سینی روی پس‌زمینه‌های روشن"

#: prefs.js:465
msgid ""
"Darken white monochrome tray icons when the panel adapts to a light "
"wallpaper. Colored icons are left untouched"
msgstr ""
"تیره کردن نمادهای تک‌رنگ سفید سینی هنگامی که پنل با پس‌زمینه روشن هم‌ساز "
"می‌شود. نمادهای رنگی بدون تغییر می‌مانند"

#: prefs.js:498
msgid "Panel Items"
msgstr "موارد پنل"

#: prefs.js:499
msgid "Choose what the top panel and its menus show"
msgstr "انتخاب آنچه نوار بالا و منوهایش نشان می‌دهند"

#: prefs.js:504
msgid "Show Panel in Fullscreen on Hover"
msgstr "نمایش پنل در تمام‌صفحه هنگام نزدیک شدن اشاره‌گر"

#: prefs.js:504
msgid ""
"Show panel when mouse is near top edge in fullscreen. Bugged for GTK4 apps."
msgstr ""
"در حالت تمام‌صفحه وقتی ماوس نزدیک لبهٔ بالا است پنل را نشان بده. در "
"برنامه‌های GTK4 مشکل‌دار است."

#: prefs.js:510
msgid "Show Window Title"
msgstr "نمایش عنوان پنجره"

#: prefs.js:511
msgid "Display current window title in the top panel"
msgstr "عنوان پنجرهٔ جاری را در پنل بالا نمایش بده"

#: prefs.js:520
msgid "Hide App Icon"
msgstr "پنهان کردن نماد برنامه"

#: prefs.js:521
msgid "Do not show the application icon next to the window title"
msgstr "نماد برنامه در کنار عنوان پنجره نشان داده نشود"

#: prefs.js:528
msgid "Hide Window Subtitle"
msgstr "پنهان کردن زیرعنوان پنجره"

#: prefs.js:529
msgid "Show only the application name, without the window's own title"
msgstr "فقط نام برنامه نمایش داده شود، بدون عنوان خود پنجره"

#: prefs.js:536
msgid "Disable Window Tiling"
msgstr "غیرفعال کردن کاشی‌بندی پنجره"

#: prefs.js:537
msgid ""
"Drop the tiling layouts from the window title menu, and stop restoring tiled "
"windows when their titlebar is dragged"
msgstr ""
"حذف چیدمان‌های کاشی‌بندی از منوی عنوان پنجره و توقف بازگردانی پنجره‌های "
"کاشی‌شده هنگام کشیدن نوار عنوان آن‌ها"

#: prefs.js:563
msgid "Move Calendar to Right"
msgstr "انتقال تقویم به راست"

#: prefs.js:564
msgid "Move calendar to right side and hide notifications"
msgstr "تقویم را به سمت راست منتقل کن و اعلان‌ها را پنهان کن"

#: prefs.js:573
msgid "Keep GNOME Notification Panel"
msgstr "نگه داشتن پنل اعلان گنوم"

#: prefs.js:574
msgid "Don't split notification and calendar layout"
msgstr "اعلان‌ها و تقویم را از هم جدا نکن"

#: prefs.js:581
msgid "Indicator Style"
msgstr "سبک نشانگر"

#: prefs.js:582
msgid "Notification dot recolor"
msgstr "تغییر رنگ نقطهٔ اعلان"

#: prefs.js:585 prefs.js:899
msgid "Default"
msgstr "پیش‌فرض"

#: prefs.js:585
msgid "Accent"
msgstr "تأکیدی"

#: prefs.js:585
msgid "Symbolic"
msgstr "نمادین"

#: prefs.js:592
msgid "Battery Percentage"
msgstr "درصد باتری"

#: prefs.js:604
msgid ""
"Unavailable while GNOME Settings shows the battery percentage in the top bar"
msgstr ""
"تا زمانی که تنظیمات گنوم درصد باتری را در نوار بالا نشان می‌دهد، در دسترس "
"نیست"

#: prefs.js:605
msgid "Show battery percentage in the top bar when below 20%"
msgstr "در صورت کمتر از ۲۰٪ بودن، درصد باتری را در نوار بالا نشان بده"

#: prefs.js:611
msgid "Caps Lock and Num Lock"
msgstr "Caps Lock و Num Lock"

#: prefs.js:611
msgid "Show Caps Lock and Num Lock icon"
msgstr "آیکون‌های Caps Lock و Num Lock را نمایش بده"

#: prefs.js:612
msgid "Custom Do Not Disturb Button"
msgstr "دکمه سفارشی عدم مزاحمت"

#: prefs.js:612
msgid ""
"Replace the system Do Not Disturb button with Kiwi's custom implementation"
msgstr ""
"دکمه پیش‌فرض عدم مزاحمت سیستم را با پیاده‌سازی سفارشی Kiwi جایگزین می‌کند"

#: prefs.js:613
msgid "Hide Activities Button"
msgstr "پنهان کردن دکمهٔ فعالیت‌ها"

#: prefs.js:613
msgid "Hide the Activities button in the top panel"
msgstr "دکمهٔ فعالیت‌ها را در پنل بالا پنهان کن"

#: prefs.js:614
msgid "Add Username"
msgstr "افزودن نام کاربری"

#: prefs.js:614
msgid "Add username to the quick menu"
msgstr "نام کاربری را به منوی سریع اضافه کن"

#: prefs.js:618 prefs.js:828
msgid "Styling"
msgstr "ظاهر"

#: prefs.js:619
msgid ""
"Restyle stock GNOME Shell elements and GTK apps. Log out and back in for "
"changes to take effect"
msgstr ""
"تغییر ظاهر عناصر پیش‌فرض گنوم شل و برنامه‌های GTK. برای اعمال تغییرات خارج و "
"دوباره وارد شوید"

#: prefs.js:624
msgid "Panel Styling"
msgstr "ظاهر پنل"

#: prefs.js:624
msgid ""
"Tighter button spacing, smaller status icons, no dropdown arrows and a "
"transparent panel in the overview"
msgstr ""
"فاصله کمتر دکمه‌ها، نمادهای وضعیت کوچک‌تر، بدون فلش‌های بازشو و پنل شفاف در "
"نمای کلی"

#: prefs.js:625
msgid "Menu and App Styling"
msgstr "ظاهر منو و برنامه"

#: prefs.js:625
msgid ""
"Narrower shell menu items with accent-colored hover and selection, plus the "
"GTK app fixes"
msgstr ""
"موارد منوی شل باریک‌تر با رنگ تأکیدی هنگام اشاره و گزینش، همراه با اصلاحات "
"برنامه‌های GTK"

#: prefs.js:631
msgid "Style Keyboard Indicator"
msgstr "استایل‌دهی به نشانگر صفحه‌کلید"

#: prefs.js:632
msgid ""
"Slightly style keyboard/input source indicator by converting to uppercase and"
" adding border"
msgstr ""
"نشانگر صفحه‌کلید/منبع ورودی را با تبدیل به حروف بزرگ و افزودن حاشیه کمی مرتب "
"کن"

#: prefs.js:639
msgid "Hide keyboard indicator"
msgstr "نشانگر صفحه‌کلید را پنهان کن"

#: prefs.js:640
msgid "Completely hide the indicator from the panel"
msgstr "نشانگر را به طور کامل از پنل پنهان کن"

#: prefs.js:668
msgid "Dock"
msgstr "داک"

#: prefs.js:677
msgid "These options need the Dash to Dock extension installed and enabled"
msgstr "این گزینه‌ها به نصب و فعال بودن افزونه Dash to Dock نیاز دارند"

#: prefs.js:685
msgid "Dock Items"
msgstr "موارد داک"

#: prefs.js:686
msgid "Add extra items to Dash-to-Dock"
msgstr "افزودن موارد بیشتر به Dash-to-Dock"

#: prefs.js:691
msgid "Minimize Windows to Dock"
msgstr "کوچک کردن پنجره‌ها به داک"

#: prefs.js:691
msgid ""
"Park minimized windows as thumbnails in Dash-to-Dock, after the apps and "
"before the trash"
msgstr ""
"قرار دادن پنجره‌های کوچک‌شده به‌صورت بندانگشتی در Dash-to-Dock، پس از "
"برنامه‌ها و پیش از زباله‌دان"

#: prefs.js:695
msgid "Downloads Folder in Dock"
msgstr "پوشه بارگیری‌ها در داک"

#: prefs.js:696
msgid ""
"Add a Downloads folder before the trash that fans its newest files out over "
"the desktop"
msgstr ""
"افزودن پوشه بارگیری‌ها پیش از زباله‌دان که تازه‌ترین پرونده‌هایش را روی "
"میزکار پخش می‌کند"

#: prefs.js:705
msgid "Stack Behind Folder"
msgstr "چیدن پشت پوشه"

#: prefs.js:706
msgid ""
"Show the newest files sticking out of the folder icon instead of piled on top"
" of it"
msgstr ""
"نمایش تازه‌ترین پرونده‌ها بیرون‌آمده از پشت نماد پوشه، به‌جای انباشته روی آن"

#: prefs.js:724
msgid "Launchpad Application"
msgstr "برنامهٔ لانچ‌پد"

#: prefs.js:725
msgid ""
"Add custom Launchpad icon to dock that opens application overview. "
"Recommended to hide default app launcher."
msgstr ""
"یک آیکون سفارشی لانچ‌پد به داک اضافه کن که نمای برنامه‌ها را باز کند. توصیه "
"می‌شود لانچر پیش‌فرض پنهان شود."

#: prefs.js:735
msgid "Custom Icon"
msgstr "نماد سفارشی"

#: prefs.js:738 prefs.js:823
msgid "Using default icon"
msgstr "از نماد پیش‌فرض استفاده می‌شود"

#: prefs.js:746
msgid "Reset to default icon"
msgstr "بازنشانی به نماد پیش‌فرض"

#: prefs.js:757
msgid "Browse for icon"
msgstr "انتخاب نماد"

#: prefs.js:762
msgid "Select Launchpad Icon"
msgstr "انتخاب نماد لانچ‌پد"

#: prefs.js:766
msgid "Images (PNG, SVG)"
msgstr "تصاویر (PNG، SVG)"

#: prefs.js:794
msgid "Icon Too Large"
msgstr "نماد خیلی بزرگ است"

#: prefs.js:795
msgid ""
"The selected image exceeds 512×512 pixels. Please choose a smaller image."
msgstr ""
"تصویر انتخاب‌شده از ۵۱۲×۵۱۲ پیکسل بزرگ‌تر است. لطفاً تصویر کوچک‌تری انتخاب "
"کنید."

#: prefs.js:797
msgid "OK"
msgstr "تأیید"

#: prefs.js:833
msgid "Dock Styling"
msgstr "ظاهر داک"

#: prefs.js:833
msgid ""
"Tighten icon spacing, drop the icon highlight and darken icons while pressed"
msgstr ""
"کاهش فاصله نمادها، حذف برجسته‌سازی نماد و تیره کردن نمادها هنگام فشار دادن"

#: prefs.js:834
msgid "Dock Blur"
msgstr "تاری داک"

#: prefs.js:834
msgid ""
"Blur the background behind Dash-to-Dock. Recommended fixed dock opacity 10% -"
" 30%, min 1%."
msgstr ""
"تار کردن پس‌زمینهٔ پشت Dash-to-Dock. کدری ثابت پیشنهادی داک ۱۰٪ تا ۳۰٪، "
"دست‌کم ۱٪."

#: prefs.js:835
msgid "Adaptive Dock Colors"
msgstr "رنگ‌های سازگار داک"

#: prefs.js:835
msgid ""
"Flip the running indicators and separators to suit whatever is behind the "
"dock, wallpaper or window"
msgstr ""
"تغییر نشانگرهای در حال اجرا و جداکننده‌ها متناسب با آنچه پشت داک است، "
"کاغذدیواری یا پنجره"

#: prefs.js:858
msgid "Buttons"
msgstr "دکمه‌ها"

#: prefs.js:864
msgid "Window Control Button Style"
msgstr "سبک دکمه‌های کنترل پنجره"

#: prefs.js:865
msgid ""
"Choose the window control button style. Log out to apply it across all apps."
msgstr ""
"سبک دکمه‌های کنترل پنجره را انتخاب کنید. برای اعمال در همه برنامه‌ها خارج "
"شوید."

#: prefs.js:873
msgid "Enable macOS Window Buttons"
msgstr "فعال کردن دکمه‌های پنجرهٔ macOS"

#: prefs.js:874
msgid "Replace window control buttons in application windows with macOS style"
msgstr "جایگزینی دکمه‌های کنترل پنجره در برنامه‌ها با سبک macOS"

#: prefs.js:895
msgid "Button Type"
msgstr "نوع دکمه"

#: prefs.js:896
msgid "Choose the button icon set"
msgstr "مجموعهٔ آیکون دکمه‌ها را انتخاب کنید"

#: prefs.js:899
msgid "Alternative"
msgstr "جایگزین"

#: prefs.js:899
msgid "Glass"
msgstr "شیشه‌ای"

#: prefs.js:905
msgid "Button Size"
msgstr "اندازه دکمه"

#: prefs.js:906
msgid "Choose button size"
msgstr "انتخاب اندازه دکمه"

#: prefs.js:909
msgid "Small"
msgstr "کوچک"

#: prefs.js:909
msgid "Normal"
msgstr "معمولی"

#: prefs.js:915
msgid "Firefox Styling"
msgstr "استایل فایرفاکس"

#: prefs.js:916
msgid ""
"Apply macOS window control styling for Firefox. Recommended to use with "
"vertical tabs."
msgstr ""
"استایل کنترل‌های پنجرهٔ macOS را برای فایرفاکس اعمال کن. استفاده همراه "
"برگه‌های عمودی توصیه می‌شود."

#: prefs.js:924
msgid "Thunderbird Styling"
msgstr "سبک تاندربرد"

#: prefs.js:925
msgid "Apply macOS window control styling for Thunderbird."
msgstr "اعمال سبک کنترل پنجره macOS برای تاندربرد."

#: prefs.js:949
msgid "Show Window Controls on Panel"
msgstr "نمایش کنترل‌های پنجره روی پنل"

#: prefs.js:950
msgid ""
"Display close, minimize, maximize buttons in the top panel when window is "
"maximized"
msgstr ""
"نمایش دکمه‌های بستن، کوچک‌کردن و بزرگ‌کردن در پنل بالا هنگام بیشینه بودن "
"پنجره"

#: prefs.js:964
msgid "Only when Fullscreen"
msgstr "تنها در تمام‌صفحه"

#: prefs.js:965
msgid ""
"Hide titlebars and show panel controls only for fullscreen windows, not "
"maximized"
msgstr ""
"پنهان کردن نوارهای عنوان و نمایش واپایشگرهای پنل تنها برای پنجره‌های "
"تمام‌صفحه، نه بیشینه"

#: prefs.js:974
msgid "Options"
msgstr "ویژگی‌ها"

#: prefs.js:980
msgid "Kiwi"
msgstr "Kiwi"

#: prefs.js:981
msgid ""
"Kiwi is not like Apple, it's free open source project that brings macOS-like "
"feel for GNOME"
msgstr ""
"Kiwi مثل Apple نیست؛ یک پروژهٔ آزاد و متن‌باز است که حس macOS را به گنوم "
"می‌آورد"

#: prefs.js:986
msgid "Overview Wallpaper Blur"
msgstr "تاری پس‌زمینهٔ نمای کلی"

#: prefs.js:986
msgid "Use blurred current wallpaper as overview background"
msgstr "استفاده از پس‌زمینه کنونی محوشده به‌عنوان پس‌زمینه نمای کلی"

#: prefs.js:987
msgid "Seamless Overview Zoom"
msgstr "بزرگ‌نمایی یکپارچه نمای کلی"

#: prefs.js:987
msgid ""
"Zoom the whole desktop, including the strip behind the panel, in and out of "
"the overview"
msgstr ""
"بزرگ‌نمایی کل میزکار، از جمله نوار پشت پنل، هنگام ورود به نمای کلی و خروج از "
"آن"

#: prefs.js:988
msgid "Focus on Overview Exit"
msgstr "تمرکز هنگام خروج از نمای کلی"

#: prefs.js:988
msgid ""
"Focus the window under the cursor instead of the previously focused one when "
"leaving the overview"
msgstr ""
"هنگام خروج از نمای کلی، پنجره زیر نشانگر به‌جای پنجره‌ای که پیش‌تر متمرکز بود"
" متمرکز شود"

#: prefs.js:989
msgid "Skip to Desktop"
msgstr "پرش به دسکتاپ"

#: prefs.js:989
msgid "Do not show the overview when logging in. Animation is still visible"
msgstr "در هنگام ورود نمای کلی را نشان نده. انیمیشن همچنان دیده می‌شود."

#: prefs.js:990
msgid "Hide Minimized Windows"
msgstr "پنهان کردن پنجره‌های کمینه"

#: prefs.js:990
msgid "Hide minimized windows in the overview"
msgstr "پنجره‌های کمینه را در نمای کلی پنهان کن"

#: prefs.js:991
msgid "Move Window to New Workspace"
msgstr "جابه‌جایی پنجره به فضای کاری جدید"

#: prefs.js:991
msgid "Move fullscreen window to a new workspace"
msgstr "انتقال پنجره تمام‌صفحه به فضای کاری جدید"

#: prefs.js:992
msgid "Reduce App Animations"
msgstr "کاهش پویانمایی‌های برنامه"

#: prefs.js:992
msgid "Mimic macOS window opening and closing with a subtle scale and fade"
msgstr "تقلید باز و بسته شدن پنجره‌های مک‌اواس با بزرگ‌نمایی و محو شدن ملایم"

#: prefs.js:993
msgid "Focus New Windows"
msgstr "تمرکز روی پنجره‌های جدید"

#: prefs.js:993
msgid ""
"Automatically focus new windows instead of showing window-ready alerts. "
"Requires extension reload"
msgstr ""
"تمرکز خودکار روی پنجره‌های جدید به‌جای نمایش هشدار آماده بودن پنجره. نیاز به "
"بارگذاری دوباره افزونه دارد"

#: prefs.js:994
msgid "Transparent Move"
msgstr "جابجایی شفاف"

#: prefs.js:994
msgid "Move window with transparency"
msgstr "جابجا کردن پنجره با شفافیت"

#: prefs.js:1001
msgid "Advanced"
msgstr "پیشرفته"

#: prefs.js:1031
msgid "Titlebuttons Hover Effect for GTK3 apps"
msgstr "افکت شناور دکمه‌های عنوان برای برنامه‌های GTK3"

#: prefs.js:1044
msgid ""
"The titlebuttons hover module provides macOS-like hover effects for window controls in GTK3 applications. GTK3 apps cannot natively show hover effects on all three window controls simultaneously, requiring this custom library to achieve the desired behavior.\n"
"\n"
"This binary code cannot be distributed through the GNOME Extensions platform due to security policies regarding native libraries, but manual installation is possible."
msgstr ""
"ماژول افکت شناور دکمه‌های عنوان، جلوه‌هایی شبیه macOS برای کنترل‌های پنجره در برنامه‌های GTK3 فراهم می‌کند. برنامه‌های GTK3 به طور بومی نمی‌توانند هم‌زمان روی هر سه کنترل پنجره افکت شناور نشان دهند، بنابراین برای رسیدن به رفتار موردنظر به این کتابخانه نیاز است.\n"
"\n"
"به دلیل سیاست‌های امنیتی دربارهٔ کتابخانه‌های بومی، این کد دودویی را نمی‌توان از طریق پلتفرم افزونه‌های گنوم توزیع کرد، اما نصب دستی ممکن است."

#: prefs.js:1060
msgid "Installation Guide on GitHub"
msgstr "راهنمای نصب در گیت‌هاب"

#: prefs.js:1062
msgid "Open the advanced module build instructions"
msgstr "دستورالعمل ساخت ماژول پیشرفته را باز کن"

#: prefs.js:1068
msgid "More of my work..."
msgstr "کارهای بیشتر من…"

#: prefs.js:1072
msgid "Kiwi Menu"
msgstr "Kiwi Menu"

#: prefs.js:1072
msgid "MacOS style menu for GNOME"
msgstr "منوی به سبک مک‌اواس برای گنوم"

#: prefs.js:1073
msgid "AppManager"
msgstr "AppManager"

#: prefs.js:1073
msgid "MacOS style AppImage installer and management application"
msgstr "برنامه نصب و مدیریت AppImage به سبک MacOS"

#: prefs.js:1074
msgid "Catalina Reloaded Icon Pack"
msgstr "Catalina Reloaded Icon Pack"

#: prefs.js:1074
msgid "macOS Tahoe icon theme for Linux"
msgstr "تم آیکون macOS Tahoe برای لینوکس"

#: prefs.js:1075
msgid "GDM Wallpaper"
msgstr "GDM Wallpaper"

#: prefs.js:1075
msgid "Set custom GDM login screen wallpaper"
msgstr "تنظیم تصویر پس‌زمینهٔ سفارشی برای صفحهٔ ورود GDM"

#: prefs.js:1087
msgid "Other Recommended Extensions"
msgstr "دیگر افزونه‌های پیشنهادی"

#: prefs.js:1088
msgid "Extensions that are compatible with Kiwi"
msgstr "افزونه‌های سازگار با Kiwi"

#: prefs.js:1112 prefs.js:1126
msgid "Restore Defaults"
msgstr "بازگردانی پیش‌فرض‌ها"

#: prefs.js:1116
msgid "Reset every Kiwi setting to its default value"
msgstr "بازنشانی همه تنظیمات کیوی به مقدار پیش‌فرض"

#: prefs.js:1122
msgid "Restore Default Settings?"
msgstr "بازگردانی تنظیمات پیش‌فرض؟"

#: prefs.js:1123
msgid ""
"Every Kiwi setting will be reset to its default value. This cannot be undone."
msgstr ""
"همه تنظیمات کیوی به مقدار پیش‌فرض بازنشانی می‌شوند. این کار بازگشت‌پذیر نیست."

